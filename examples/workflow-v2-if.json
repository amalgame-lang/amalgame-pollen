{
  "schema": "workflow-tree/v2",
  "name": "v2-if-demo",
  "version": 1,
  "actions": {
    "ingest":   { "topic": "order.in" },
    "enrich":   { "topic": "order.enrich" },
    "vip":      { "topic": "order.vip" },
    "standard": { "topic": "order.standard" }
  },
  "tree": { "type": "sequence", "steps": [
    { "type": "call", "action": "ingest" },
    { "type": "call", "action": "enrich" },
    { "type": "if", "branches": [
        { "cond": { "op": ">", "var": "data.amount", "value": 1000 },
          "then": { "type": "call", "action": "vip" } },
        { "then": { "type": "call", "action": "standard" } }
    ] }
  ] }
}
