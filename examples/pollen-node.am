// examples/pollen-node.am
//
// Reference Pollen node binary built ENTIRELY on the amalgame-pollen
// package — no legacy runtime. This is the M3 "thin wrapper" : it
// parses a workflow.json, resolves this node's role, wires the
// package's workflow runtime via the public setters, and blocks in
// Pollen.StartListener.
//
// Unlike the legacy pollen-node-tcp binary, the `if` cond is
// evaluated correctly at dispatch (the package's cond_eval, 28
// smoke assertions), so conditional routing actually works.
//
// Build :
//   amc package add pollen
//   amc examples/pollen-node.am -o /tmp/pollen-node-pkg
//
// Run :
//   /tmp/pollen-node-pkg <port> --workflow <path> --node-name <role> \
//                        [--shared-dir <dir>]
//
// Supported tree (M3.1) : top-level sequence of
//   call / fan_out / if(branches[{cond,then:call}]) / set
// for / while + nested branches are M3.2.

import Amalgame.Pollen
import Amalgame.Formats.Json
import Amalgame.Collections
import Amalgame.String
import Amalgame.Console

public class Program {

    // Does this step call / fan_out to `role` ?
    public static bool StepNames(JsonValue actionV, string role) {
        if (!actionV.IsObject()) { return false }
        let kind: string = actionV.Get("type").AsString()
        if (kind == "call") {
            return actionV.Get("node").AsString() == role
        }
        if (kind == "fan_out") {
            let nodesV: JsonValue = actionV.Get("nodes")
            if (!nodesV.IsArray()) { return false }
            let nodes: List<JsonValue> = nodesV.AsArray()
            let n: int = nodes.Count()
            for i in 0..n {
                if (nodes.Get(i).AsString() == role) { return true }
            }
        }
        return false
    }

    // Find a node by key, handling BOTH container shapes :
    //   - object keyed by role : nodes.Get(key)
    //   - array of {id, label, ...} : match label or id
    // The manager saves the array form ; hand-written files use the
    // object form. Returns a JsonValue ; check IsObject() to detect
    // "not found".
    public static JsonValue FindNode(JsonValue nodesV, string key) {
        if (nodesV.IsObject()) { return nodesV.Get(key) }
        if (nodesV.IsArray()) {
            let items: List<JsonValue> = nodesV.AsArray()
            let n: int = items.Count()
            for i in 0..n {
                let it: JsonValue = items.Get(i)
                if (it.Get("label").AsString() == key) { return it }
                if (it.Get("id").AsString() == key)    { return it }
            }
        }
        return nodesV.Get("__pollen_missing__")
    }

    // Iterate node keys (role names) for either container shape.
    // For the array form the key is the label (preferred) or id.
    public static List<string> NodeKeys(JsonValue nodesV) {
        if (nodesV.IsObject()) { return nodesV.Keys() }
        let out: List<string> = new List<string>()
        if (nodesV.IsArray()) {
            let items: List<JsonValue> = nodesV.AsArray()
            let n: int = items.Count()
            for i in 0..n {
                let it: JsonValue = items.Get(i)
                let lbl: string = it.Get("label").AsString()
                if (String_Length(lbl) > 0) { out.Add(lbl); continue }
                let id: string = it.Get("id").AsString()
                if (String_Length(id) > 0) { out.Add(id) }
            }
        }
        return out
    }

    // Targets a step dispatches to (call → [node], fan_out → nodes,
    // sequence → first non-set step's targets).
    public static List<string> ActionTargets(JsonValue actionV) {
        let out: List<string> = new List<string>()
        if (!actionV.IsObject()) { return out }
        let kind: string = actionV.Get("type").AsString()
        if (kind == "call") {
            let nV: string = actionV.Get("node").AsString()
            if (String_Length(nV) > 0) { out.Add(nV) }
            return out
        }
        if (kind == "fan_out") {
            let nodesV: JsonValue = actionV.Get("nodes")
            if (!nodesV.IsArray()) { return out }
            let nodes: List<JsonValue> = nodesV.AsArray()
            let n: int = nodes.Count()
            for i in 0..n {
                let s: string = nodes.Get(i).AsString()
                if (String_Length(s) > 0) { out.Add(s) }
            }
            return out
        }
        if (kind == "sequence") {
            let stepsV: JsonValue = actionV.Get("steps")
            if (!stepsV.IsArray()) { return out }
            let steps: List<JsonValue> = stepsV.AsArray()
            let sn: int = steps.Count()
            for i in 0..sn {
                let s: JsonValue = steps.Get(i)
                if (!s.IsObject()) { continue }
                if (s.Get("type").AsString() == "set") { continue }
                return Program.ActionTargets(s)
            }
        }
        return out
    }

    // M5 — recursive walker : return the steps[] list that directly
    // contains `role`'s step, wherever it lives in the tree (top-level
    // sequence, or nested inside an `if` branch / `for` body). Empty
    // list if not found. A role named by a single leaf action (e.g.
    // an if-branch whose `then` is just call(role), no surrounding
    // sequence) yields a synthetic 1-step list so the dispatcher
    // helpers have a consistent shape.
    public static List<JsonValue> FindRoleSequence(JsonValue action, string role) {
        let empty: List<JsonValue> = new List<JsonValue>()
        if (!action.IsObject()) { return empty }
        let kind: string = action.Get("type").AsString()
        if (kind == "sequence") {
            let stepsV: JsonValue = action.Get("steps")
            if (!stepsV.IsArray()) { return empty }
            let steps: List<JsonValue> = stepsV.AsArray()
            let n: int = steps.Count()
            // 1. named directly at this level → this sequence
            for i in 0..n {
                if (Program.StepNames(steps.Get(i), role)) { return steps }
            }
            // 2. recurse into nested constructs
            for i in 0..n {
                let nested: List<JsonValue> = Program.FindRoleSequence(steps.Get(i), role)
                if (nested.Count() > 0) { return nested }
            }
            return empty
        }
        if (kind == "if") {
            let branchesV: JsonValue = action.Get("branches")
            if (branchesV.IsArray()) {
                let branches: List<JsonValue> = branchesV.AsArray()
                let bn: int = branches.Count()
                for bi in 0..bn {
                    let br: JsonValue = branches.Get(bi)
                    if (!br.IsObject()) { continue }
                    let thenV: JsonValue = br.Get("then")
                    let nested: List<JsonValue> = Program.FindRoleSequence(thenV, role)
                    if (nested.Count() > 0) { return nested }
                }
            }
            return empty
        }
        if (kind == "for") {
            let doV: JsonValue = action.Get("do")
            if (doV.IsObject()) { return Program.FindRoleSequence(doV, role) }
            return empty
        }
        // leaf : call / fan_out / set / while
        if (Program.StepNames(action, role)) {
            let one: List<JsonValue> = new List<JsonValue>()
            one.Add(action)
            return one
        }
        return empty
    }

    // The dispatchable step that immediately follows `role`'s step
    // within its containing sequence `steps` (set steps skipped).
    // empty if role is terminal in that sequence / not found.
    public static JsonValue FindActionAfter(List<JsonValue> steps, string role) {
        let empty: JsonValue = new JsonValue()
        let n: int = steps.Count()
        for i in 0..n {
            if (Program.StepNames(steps.Get(i), role)) {
                var j: int = i + 1
                while (j < n) {
                    let s: JsonValue = steps.Get(j)
                    if (s.IsObject() && s.Get("type").AsString() == "set") {
                        j = j + 1
                        continue
                    }
                    return s
                }
                return empty
            }
        }
        return empty
    }

    // Wire one next target (resolve host:port from the node table).
    public static void WireNext(JsonValue nodesV, string role) {
        let node: JsonValue = Program.FindNode(nodesV, role)
        if (!node.IsObject()) { return }
        let host: string = node.Get("host").AsString()
        let port: int    = node.Get("port").AsInt()
        if (String_Length(host) > 0 && port > 0) {
            Pollen.WorkflowAddNext(host, port)
        }
    }

    // M3.2 — collect the `set` steps that sit between this role's call
    // and the next dispatcher in the top-level sequence, register each
    // as a state op. value : object → raw expr ; bare literal → wrapped
    // as {"const":<lit>} so the package's single eval entrypoint copes.
    public static void WireSetsAfter(List<JsonValue> steps, string role) {
        let n: int = steps.Count()
        for i in 0..n {
            if (Program.StepNames(steps.Get(i), role)) {
                var j: int = i + 1
                while (j < n) {
                    let s: JsonValue = steps.Get(j)
                    if (!s.IsObject()) { return }
                    if (s.Get("type").AsString() != "set") { return }
                    let p: string = s.Get("path").AsString()
                    let valueV: JsonValue = s.Get("value")
                    var expr: string = ""
                    if (valueV.IsObject()) {
                        expr = Json.Encode(valueV)
                    } else {
                        expr = "{\"const\":" + Json.Encode(valueV) + "}"
                    }
                    if (String_Length(p) > 0) { Pollen.SetOpAdd(p, expr) }
                    j = j + 1
                }
                return
            }
        }
    }

    // M3.2 — the dispatchable step that follows this role's dispatcher
    // (i.e. two dispatchers down, skipping sets). Used for `while`
    // exit-target resolution : while loops to self, then exits to
    // whatever comes after the while step in the sequence.
    public static JsonValue FindStepAfterDispatcher(List<JsonValue> steps, string role) {
        let empty: JsonValue = new JsonValue()
        let n: int = steps.Count()
        for i in 0..n {
            if (Program.StepNames(steps.Get(i), role)) {
                // skip sets → dispatcher
                var j: int = i + 1
                while (j < n && steps.Get(j).IsObject()
                       && steps.Get(j).Get("type").AsString() == "set") { j = j + 1 }
                if (j >= n) { return empty }
                // j is the dispatcher (the while) ; skip sets → next
                var k: int = j + 1
                while (k < n && steps.Get(k).IsObject()
                       && steps.Get(k).Get("type").AsString() == "set") { k = k + 1 }
                if (k < n) { return steps.Get(k) }
                return empty
            }
        }
        return empty
    }

    // M3.2 — wire a `for` route : item var + targets of `do` + items.
    public static void WireFor(JsonValue nodesV, JsonValue forStep) {
        var itemVar: string = forStep.Get("var").AsString()
        if (String_Length(itemVar) == 0) { itemVar = "item" }
        Pollen.ForSetup(itemVar)
        let doV: JsonValue = forStep.Get("do")
        if (doV.IsObject()) {
            let targets: List<string> = Program.ActionTargets(doV)
            let tn: int = targets.Count()
            for ti in 0..tn {
                let tn2: JsonValue = Program.FindNode(nodesV, targets.Get(ti))
                if (tn2.IsObject()) {
                    let h: string = tn2.Get("host").AsString()
                    let p: int    = tn2.Get("port").AsInt()
                    if (String_Length(h) > 0 && p > 0) {
                        Pollen.ForAddTarget(h, p)
                    }
                }
            }
        }
        let inV: JsonValue = forStep.Get("in")
        if (inV.IsArray()) {
            let items: List<JsonValue> = inV.AsArray()
            let ic: int = items.Count()
            for ii in 0..ic {
                Pollen.ForAddItem(Json.Encode(items.Get(ii)))
            }
        }
    }

    // M3.2 — wire a `while` route : cond + maxIter + self loop + exits.
    public static void WireWhile(JsonValue nodesV, List<JsonValue> steps,
                                   string role, JsonValue whileStep,
                                   string selfHost, int selfPort) {
        var condJson: string = ""
        let condV: JsonValue = whileStep.Get("cond")
        if (condV.IsObject()) { condJson = Json.Encode(condV) }
        var maxIter: int = 100
        let maxV: JsonValue = whileStep.Get("maxIter")
        if (maxV.IsInt()) { maxIter = maxV.AsInt() }
        let iterKey: string = "_wf_iter_" + role
        Pollen.WhileSetup(condJson, iterKey, maxIter, selfHost, selfPort)
        let exitAction: JsonValue = Program.FindStepAfterDispatcher(steps, role)
        if (exitAction.IsObject()) {
            let exits: List<string> = Program.ActionTargets(exitAction)
            let ec: int = exits.Count()
            for ei in 0..ec {
                let en: JsonValue = Program.FindNode(nodesV, exits.Get(ei))
                if (en.IsObject()) {
                    let eh: string = en.Get("host").AsString()
                    let ep: int    = en.Get("port").AsInt()
                    if (String_Length(eh) > 0 && ep > 0) {
                        Pollen.WhileAddExit(eh, ep)
                    }
                }
            }
        }
    }

    public static void Main(string[] args) {
        if (Args_Count() == 0) {
            Console.WriteLine("usage: pollen-node <port> --workflow <path> --node-name <role> [--shared-dir <dir>]")
            return
        }

        var port: int = 0
        var workflowPath: string = ""
        var nodeName: string = ""
        var sharedDir: string = ""

        var i: int = 0
        while (i < Args_Count()) {
            let a: string = Args_Get(i)
            if (a == "--workflow") {
                if (i + 1 < Args_Count()) { workflowPath = Args_Get(i + 1); i = i + 2; continue }
            }
            if (a == "--node-name") {
                if (i + 1 < Args_Count()) { nodeName = Args_Get(i + 1); i = i + 2; continue }
            }
            if (a == "--shared-dir") {
                if (i + 1 < Args_Count()) { sharedDir = Args_Get(i + 1); i = i + 2; continue }
            }
            if (port == 0) { port = String_ToInt(a) }
            i = i + 1
        }

        if (port <= 0) {
            Console.WriteLine("pollen-node: need a positive port as the first arg")
            return
        }
        if (String_Length(workflowPath) == 0) {
            Console.WriteLine("pollen-node: --workflow <path> required")
            return
        }
        if (!File_Exists(workflowPath)) {
            Console.WriteLine("pollen-node: workflow file not found: {workflowPath}")
            return
        }

        let body: string = File_ReadAll(workflowPath)
        let parser: JsonParser = new JsonParser(body)
        let root: JsonValue = parser.ParseTopLevel()
        if (parser.HasFailed()) {
            let e: string = parser.ErrorMsg()
            Console.WriteLine("pollen-node: workflow parse failed: {e}")
            return
        }

        let nodesV: JsonValue = root.Get("nodes")
        // Accept BOTH node container shapes : object keyed by role
        // (hand-written) OR array of {id,label,...} (manager saves
        // this). FindNode / NodeKeys abstract over the two.
        if (!nodesV.IsObject() && !nodesV.IsArray()) {
            Console.WriteLine("pollen-node: 'nodes' must be an object or array")
            return
        }
        let treeV: JsonValue = root.Get("tree")
        if (!treeV.IsObject()) {
            Console.WriteLine("pollen-node: 'tree' missing (M3.1 needs a workflow-tree)")
            return
        }

        // Resolve role : --node-name beats port lookup.
        var role: string = nodeName
        if (String_Length(role) == 0) {
            let keys: List<string> = Program.NodeKeys(nodesV)
            let nk: int = keys.Count()
            for ki in 0..nk {
                let k: string = keys.Get(ki)
                if (Program.FindNode(nodesV, k).Get("port").AsInt() == port) { role = k; break }
            }
        }
        if (String_Length(role) == 0) {
            Console.WriteLine("pollen-node: no role matches port :{port}")
            return
        }

        let self: JsonValue = Program.FindNode(nodesV, role)
        if (!self.IsObject()) {
            Console.WriteLine("pollen-node: role '{role}' not in nodes")
            return
        }

        if (String_Length(sharedDir) > 0) {
            Pollen.WorkflowSetSharedDir(sharedDir)
        }
        Pollen.WorkflowSetSelf(role, "127.0.0.1", port)

        // ── Configure the runtime for this role ──
        Pollen.WorkflowReloadBegin()

        // consumes
        let consumesV: JsonValue = self.Get("consumes")
        if (consumesV.IsArray()) {
            let cs: List<JsonValue> = consumesV.AsArray()
            let cn: int = cs.Count()
            for ci in 0..cn {
                let topic: string = cs.Get(ci).AsString()
                if (String_Length(topic) > 0) { Pollen.WorkflowAddConsume(topic) }
            }
        }

        // emit topic (first of emits[])
        let emitsV: JsonValue = self.Get("emits")
        if (emitsV.IsArray()) {
            let es: List<JsonValue> = emitsV.AsArray()
            if (es.Count() > 0) {
                let emit: string = es.Get(0).AsString()
                if (String_Length(emit) > 0) { Pollen.WorkflowSetEmitTopic(emit) }
            }
        }

        // M5 — resolve the sequence that CONTAINS this role (top-level
        // or nested in an if/for branch), so a buried role still gets
        // its next wired. set ops + dispatcher are looked up within it.
        let roleSteps: List<JsonValue> = Program.FindRoleSequence(treeV, role)

        // M3.2 — set ops sitting between this role and its dispatcher
        Program.WireSetsAfter(roleSteps, role)

        // next : the dispatcher step after this role (sets skipped)
        let after: JsonValue = Program.FindActionAfter(roleSteps, role)
        if (after.IsObject()) {
            let kind: string = after.Get("type").AsString()
            if (kind == "call" || kind == "fan_out") {
                let targets: List<string> = Program.ActionTargets(after)
                let tn: int = targets.Count()
                for ti in 0..tn {
                    Program.WireNext(nodesV, targets.Get(ti))
                }
            } else if (kind == "for") {
                Program.WireFor(nodesV, after)
            } else if (kind == "while") {
                Program.WireWhile(nodesV, roleSteps, role, after, "127.0.0.1", port)
            } else if (kind == "if") {
                // Each branch → CondBranchOpen(condJson) + targets.
                let branchesV: JsonValue = after.Get("branches")
                if (branchesV.IsArray()) {
                    let branches: List<JsonValue> = branchesV.AsArray()
                    let bn: int = branches.Count()
                    for bi in 0..bn {
                        let br: JsonValue = branches.Get(bi)
                        if (!br.IsObject()) { continue }
                        var condJson: string = ""
                        let condV: JsonValue = br.Get("cond")
                        if (condV.IsObject()) { condJson = Json.Encode(condV) }
                        Pollen.CondBranchOpen(condJson)
                        let thenV: JsonValue = br.Get("then")
                        let tgts: List<string> = Program.ActionTargets(thenV)
                        let tc: int = tgts.Count()
                        for ti in 0..tc {
                            let tgtRole: string = tgts.Get(ti)
                            let tn2: JsonValue = Program.FindNode(nodesV, tgtRole)
                            if (tn2.IsObject()) {
                                let h: string = tn2.Get("host").AsString()
                                let p: int    = tn2.Get("port").AsInt()
                                if (String_Length(h) > 0 && p > 0) {
                                    Pollen.CondBranchAddTarget(h, p)
                                }
                            }
                        }
                    }
                }
            }
        }

        Pollen.WorkflowReloadCommit()

        // Phase 6.1 — advertise into sharedDir/capabilities/ so the
        // manager's discovery panel sees this node alive (heartbeat
        // every 5s). The role is the label ; consumed topics become
        // the advertised actions.
        if (String_Length(sharedDir) > 0) {
            Pollen.StartCapabilityWriter(role, "127.0.0.1", port)
        }

        Console.WriteLine("pollen-node: role={role} listening on :{port} (package-driven)")
        Console.Flush()
        Pollen.StartListener(port)
    }
}
