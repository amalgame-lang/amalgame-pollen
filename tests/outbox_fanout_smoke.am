// tests/outbox_fanout_smoke.am — v0.10.0 durable fan-out (call with
// mode "all" and on_error "buffer").
//
// Three processes. This one (the sender, port 18781) forwards fan.src to
// the action `sink` (topic fan.in) with mode all + buffer, and declares two
// members of fan.in's group : hist-b and hist-c. Copies of itself play the
// members (argument "member <label> <port> <seconds>"), each printing what
// it receives in its log ; they find the sender over the network (AddPeer).
// Checks
//   1. hist-c, absent from the start, has its own FIFO : 5 messages wait
//      for it while hist-b gets them
//   2. hist-c started : it gets the 5, in order
//   3. hist-b stopped : 3 more go to hist-c, and wait for hist-b
//   4. hist-b back : it gets those 3, in order ; nothing twice, nothing lost

namespace PollenTests

import Amalgame.Pollen
import Amalgame.Threading
import Amalgame.Collections
import Amalgame.String
import Amalgame.Console

public class Program {
    public static void Check(bool ok, string what) {
        if (ok) { Console.WriteLine("[PASS] " + what) }
        else    { Console.WriteLine("[FAIL] " + what) }
    }

    // A member : prints "got i=<n>" for each message, lives `secs` seconds.
    public static void Member(label: string, port: int, secs: int) {
        // Its log is a file : one line at a time, so the sender reads it live.
        @c { setvbuf(stdout, NULL, _IOLBF, 0); }
        Pollen.OnTopic("fan.in", (env: string) => {
            let d: string = Pollen.EnvelopeData(env)
            // The workflow's state travels whole : take its "i".
            var i: int = -1
            @c { const char* p = strstr((const char*) d, "\"i\""); if (p) { p += 3; while (*p == ' ' || *p == ':') p++; i = atoll(p); } }
            Console.WriteLine("got i=" + String_FromInt(i))
            return 0
        })
        let listen = (_a: int) => {
            Pollen.SetListenAddress("127.0.0.1")
            Pollen.StartListener(port)
            return 0
        }
        Threading.ThreadSpawn(listen, 0)
        Pollen.AddPeer("127.0.0.1", 18781)
        Pollen.StartCapabilityWriter(label, "127.0.0.1", port)
        // On the clock : a sleep can end early when the GC's signals
        // interrupt it, and the member would leave before its time.
        let end: int = Program.Now() + secs * 1000
        while (Program.Now() < end) { Threading.ThreadSleep(200) }
    }

    public static void Spawn(label: string, port: int, secs: int, log: string) {
        let self: string = Args_Get(0)
        let cmd: string = self + " member " + label + " " + String_FromInt(port) + " " + String_FromInt(secs) + " > " + log + " 2>&1 &"
        @c { if (system((const char*) cmd) != 0) { } }
    }

    // The "got i=<n>" lines of a member's log, joined with ",".
    public static string Got(log: string) {
        var out: string = ""
        for line in String_Split(File_ReadAll(log), "\n") {
            let l: string = line
            if (String_StartsWith(l, "got i=")) {
                if (String_Length(out) > 0) { out = out + "," }
                out = out + String_Substring(l, 6, String_Length(l) - 6)
            }
        }
        return out
    }

    public static bool WaitGot(log: string, want: string, ms: int) {
        var waited: int = 0
        while (Program.Got(log) != want && waited < ms) {
            Threading.ThreadSleep(200)
            waited = waited + 200
        }
        return Program.Got(log) == want
    }

    public static int Now() {
        var ms: int = 0
        @c { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); ms = (int64_t) ts.tv_sec * 1000 + ts.tv_nsec / 1000000; }
        return ms
    }

    public static void Send(a: int, b: int) {
        for i in a..b {
            Pollen.WorkflowV3DispatchTopic("fan.src", "{\"data\":{\"i\":" + String_FromInt(i) + "}}")
        }
    }

    public static void Main(string[] args) {
        if (Args_Count() > 4 && Args_Get(1) == "member") {
            Program.Member(Args_Get(2), String_ToInt(Args_Get(3)), String_ToInt(Args_Get(4)))
            return
        }
        Program.Check(Pollen.WorkflowLoadV3("examples/workflow-v3-fanout.json"), "fan-out workflow loads (mode all + buffer)")
        Pollen.WorkflowSetSharedDir("./_fanout_shared")
        Pollen.WorkflowSetSelf("fan-sender", "127.0.0.1", 18781)
        let listen = (_a: int) => {
            Pollen.SetListenAddress("127.0.0.1")
            Pollen.StartListener(18781)
            return 0
        }
        Threading.ThreadSpawn(listen, 0)
        Pollen.StartCapabilityWriter("fan-sender", "127.0.0.1", 18781)
        Pollen.StartCapabilityReader()
        Program.Check(Pollen.AddOutboxMember("fan.in", "hist-b") && Pollen.AddOutboxMember("fan.in", "hist-c"), "two members declared : hist-b, hist-c")

        Program.Spawn("hist-b", 18782, 9, "b1.log")
        Threading.ThreadSleep(3500)
        // 1 — hist-c absent
        Program.Send(0, 5)
        Program.Check(Program.WaitGot("b1.log", "0,1,2,3,4", 6000), "hist-b gets the 5 messages, in order (" + Program.Got("b1.log") + ")")
        Program.Check(Pollen.OutboxPendingFor("fan.in", "hist-c") == 5, "hist-c, absent from the start : its 5 messages wait in its own FIFO (" + String_FromInt(Pollen.OutboxPendingFor("fan.in", "hist-c")) + ")")
        // 2 — hist-c starts
        Program.Spawn("hist-c", 18783, 30, "c.log")
        let t0: int = Program.Now()
        let okc: bool = Program.WaitGot("c.log", "0,1,2,3,4", 20000)
        let dt: int = Program.Now() - t0
        Program.Check(okc && dt < 8000, "hist-c started : it gets the 5, in order, " + String_FromInt(dt) + " ms after its start (" + Program.Got("c.log") + ")")
        // 3 — hist-b stops (it lives 9 s)
        Threading.ThreadSleep(4000)
        Program.Send(5, 8)
        Program.Check(Program.WaitGot("c.log", "0,1,2,3,4,5,6,7", 6000), "hist-b stopped : hist-c gets the next 3 (" + Program.Got("c.log") + ")")
        Threading.ThreadSleep(1500)
        Program.Check(Pollen.OutboxPendingFor("fan.in", "hist-b") == 3, "the 3 wait in hist-b's FIFO (" + String_FromInt(Pollen.OutboxPendingFor("fan.in", "hist-b")) + ")")
        // 4 — hist-b back
        Program.Spawn("hist-b", 18782, 12, "b2.log")
        Program.Check(Program.WaitGot("b2.log", "5,6,7", 12000), "hist-b back : it gets those 3, in order (" + Program.Got("b2.log") + ")")
        Threading.ThreadSleep(1000)
        Program.Check(Pollen.OutboxPendingFor("fan.in", "hist-b") == 0 && Pollen.OutboxPendingFor("fan.in", "hist-c") == 0 && Program.Got("c.log") == "0,1,2,3,4,5,6,7",
            "nothing waits any more, nothing twice : hist-b 0-4 then 5-7, hist-c 0-7")
        // The members : stopped now (they would outlive the test).
        @c { if (system("pkill -f 'outbox_fanout_smoke member' 2>/dev/null") != 0) { } }
    }
}
