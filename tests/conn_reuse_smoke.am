// tests/conn_reuse_smoke.am — v0.5.0 connection reuse for Publish.
//
// One process : registers a handler, starts the listener on a
// worker thread, then checks that
//   1. 2000 Publish calls to one peer all arrive, over ONE pooled
//      connection (the ACKs coming back are drained on the way,
//      2000 ACKs ≈ 180 KB, more than a default socket buffer)
//   2. they arrive in order (one connection = one listener worker)
//   3. SetConnectionReuse(false) goes back to one connection per
//      message, and true reopens a pooled connection.
// Runs on Linux, macOS and Windows (Winsock).

namespace PollenTests

import Amalgame.Pollen
import Amalgame.Threading
import Amalgame.Collections
import Amalgame.String
import Amalgame.Console

// What the handler saw : Next is the sequence number it expects,
// InOrder / OutOfOrder count the messages. A class instance, not a
// Threading channel : amc 0.8.52 stores a captured channel in an i64
// slot, which gcc 14+ rejects (-Werror=int-conversion). The handler
// runs on one listener worker at a time here (one pooled connection,
// or spaced-out one-shot connections), so plain fields are enough.
public class Seen {
    public Next: int
    public InOrder: int
    public OutOfOrder: int

    public Seen() {
        this.Next = 0
        this.InOrder = 0
        this.OutOfOrder = 0
    }
}

public class Program {
    public static void Check(bool ok, string what) {
        if (ok) { Console.WriteLine("[PASS] " + what) }
        else    { Console.WriteLine("[FAIL] " + what) }
    }

    // Wait until the handler has run `n` times (max 10 s).
    public static bool WaitCalls(int n) {
        var waited: int = 0
        while (Pollen.HandlerCallCount() < n && waited < 10000) {
            Threading.ThreadSleep(20)
            waited = waited + 20
        }
        return Pollen.HandlerCallCount() == n
    }

    public static void Main(string[] args) {
        let port: int = 18741
        let total: int = 2000
        // Messages carry {"i":<seq>}.
        let seen: Seen = new Seen()

        Pollen.OnTopic("reuse.test", (env: string) => {
            let d: string = Pollen.EnvelopeData(env)
            if (d == "{\"i\":" + String_FromInt(seen.Next) + "}") { seen.InOrder = seen.InOrder + 1 }
            else { seen.OutOfOrder = seen.OutOfOrder + 1 }
            seen.Next = seen.Next + 1
            return 0
        })

        let listen = (_a: int) => {
            Pollen.StartListener(port)
            return 0
        }
        Threading.ThreadSpawn(listen, 0)
        Threading.ThreadSleep(300)

        // 1 + 2 — pooled (default)
        let c0: int = Pollen.ConnectCount()
        var failed: int = 0
        for i in 0..total {
            let mid: string = Pollen.Publish("127.0.0.1", port, "reuse.test", 1,
                                             "{\"i\":" + String_FromInt(i) + "}")
            if (String_Length(mid) == 0) { failed = failed + 1 }
        }
        Program.Check(failed == 0, "2000 Publish calls succeed")
        Program.Check(Program.WaitCalls(total), "handler receives all 2000 messages")
        Program.Check(Pollen.ConnectCount() - c0 == 1,
                      "one pooled connection for 2000 messages (got "
                      + String_FromInt(Pollen.ConnectCount() - c0) + ")")
        Program.Check(seen.InOrder == total && seen.OutOfOrder == 0, "messages arrive in order")

        // 3 — reuse off : no pooled connect, messages still delivered
        Pollen.SetConnectionReuse(false)
        let c1: int = Pollen.ConnectCount()
        for i in total..total + 5 {
            Pollen.Publish("127.0.0.1", port, "reuse.test", 1,
                           "{\"i\":" + String_FromInt(i) + "}")
            Threading.ThreadSleep(20)   // one worker per connection : keep order
        }
        Program.Check(Program.WaitCalls(total + 5), "reuse off : 5 messages delivered")
        Program.Check(Pollen.ConnectCount() == c1, "reuse off : no pooled connection")

        // back on : the pool was closed, so one new connection
        Pollen.SetConnectionReuse(true)
        Pollen.Publish("127.0.0.1", port, "reuse.test", 1,
                       "{\"i\":" + String_FromInt(total + 5) + "}")
        Program.Check(Program.WaitCalls(total + 6), "reuse on again : message delivered")
        Program.Check(Pollen.ConnectCount() == c1 + 1, "reuse on again : one new connection")
        Program.Check(seen.InOrder == total + 6 && seen.OutOfOrder == 0, "later messages in order too")
    }
}
