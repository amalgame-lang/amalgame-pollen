// tests/net_discovery_smoke.am — v0.10.0 discovery over the network.
//
// Two processes, no shared directory : this one (A, port 18761) and a
// copy of itself started as B (port 18762, argument "peer"). Only B knows
// A's address (AddPeer). Checks
//   1. A finds B's topic through B's announcements (no shared dir)
//   2. B finds A's topic : A learned B from its announcement and
//      announced back
//   3. A message published to the provider A resolved reaches B's handler
//   4. B stopped : A forgets it within the stale delay (7 s + 1 s)
// Runs where `sh` is (Linux, macOS ; Git Bash on Windows).

namespace PollenTests

import Amalgame.Pollen
import Amalgame.Threading
import Amalgame.String
import Amalgame.Console

// What A's handler saw (a class instance : a captured int would be a copy).
public class Seen {
    public BGot: int
    public Seen() { this.BGot = 0 }
}

public class Program {
    public static void Check(bool ok, string what) {
        if (ok) { Console.WriteLine("[PASS] " + what) }
        else    { Console.WriteLine("[FAIL] " + what) }
    }

    // Resolved within ms milliseconds, or "".
    public static string WaitResolve(topic: string, want: string, ms: int) {
        var waited: int = 0
        var got: string = Pollen.ResolveProvider(topic)
        while (got != want && waited < ms) {
            Threading.ThreadSleep(200)
            waited = waited + 200
            got = Pollen.ResolveProvider(topic)
        }
        return got
    }

    public static void Peer() {
        // B : announces to A only ; lives 12 s, then exits.
        Pollen.OnTopic("svc.b", (env: string) => {
            Console.WriteLine("[peer] got " + Pollen.EnvelopeData(env))
            return 0
        })
        Pollen.OnTopic("svc.ack", (env: string) => { return 0 })
        let listen = (_a: int) => {
            Pollen.SetListenAddress("127.0.0.1")
            Pollen.StartListener(18762)
            return 0
        }
        Threading.ThreadSpawn(listen, 0)
        Pollen.AddPeer("127.0.0.1", 18761)
        Pollen.StartCapabilityWriter("peer-b", "127.0.0.1", 18762)
        Pollen.StartCapabilityReader()
        let a: string = Program.WaitResolve("svc.a", "127.0.0.1:18761", 8000)
        // Tell A what B resolved, through the bus.
        Pollen.PublishSync("127.0.0.1", 18761, "svc.a", 1, "{\"b_resolved\":\"" + a + "\"}", 3000)
        // On the clock : a sleep can end early when the GC's signals interrupt it.
        var t: int = 0
        @c { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); t = (int64_t) ts.tv_sec * 1000 + ts.tv_nsec / 1000000; }
        let end: int = t + 9000
        while (t < end) {
            Threading.ThreadSleep(200)
            @c { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); t = (int64_t) ts.tv_sec * 1000 + ts.tv_nsec / 1000000; }
        }
    }

    public static void Main(string[] args) {
        if (Args_Count() > 1 && Args_Get(1) == "peer") {
            Program.Peer()
            return
        }
        let seen: Seen = new Seen()
        Pollen.OnTopic("svc.a", (env: string) => {
            let d: string = Pollen.EnvelopeData(env)
            if (String_Contains(d, "127.0.0.1:18761")) { seen.BGot = 1 }
            return 0
        })
        let listen = (_a: int) => {
            Pollen.SetListenAddress("127.0.0.1")
            Pollen.StartListener(18761)
            return 0
        }
        Threading.ThreadSpawn(listen, 0)
        Pollen.StartCapabilityWriter("node-a", "127.0.0.1", 18761)
        Pollen.StartCapabilityReader()
        Threading.ThreadSleep(300)
        let self: string = Args_Get(0)
        @c { char cmd[600]; snprintf(cmd, sizeof(cmd), "%s peer > peer.log 2>&1 &", (const char*) self); if (system(cmd) != 0) { } }

        let b: string = Program.WaitResolve("svc.b", "127.0.0.1:18762", 8000)
        Program.Check(b == "127.0.0.1:18762", "A finds B's topic through its announcements, without a shared directory (" + b + ")")
        var waited: int = 0
        while (seen.BGot == 0 && waited < 9000) {
            Threading.ThreadSleep(200)
            waited = waited + 200
        }
        Program.Check(seen.BGot == 1, "B finds A's topic : A learned B and announced back")
        Program.Check(Pollen.PeerCount() == 1 && Pollen.AnnouncesIn() >= 1, "A has learned one peer (" + String_FromInt(Pollen.PeerCount()) + "), from " + String_FromInt(Pollen.AnnouncesIn()) + " announcement(s)")
        let mid: string = Pollen.PublishSync("127.0.0.1", 18762, "svc.b", 1, "{\"hello\":1}", 3000)
        Program.Check(String_Length(mid) > 0, "a message to the provider A resolved reaches B")
        let reg: string = Pollen.NetRegistryJson()
        Program.Check(String_Contains(reg, "\"label\":\"peer-b\"") && String_Contains(reg, "\"svc.b\""), "NetRegistryJson lists B with its label and topics")
        // B exits about 12 s after its start : A forgets it.
        let gone: string = Program.WaitResolve("svc.b", "", 20000)
        Program.Check(gone == "", "B stopped : A forgets it (stale delay)")
    }
}
