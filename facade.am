// facade.am — public AM API for the amalgame-pollen package.
//
// v0.1.0-dev :  SKELETON with linkable STUBS. The actual engine
// migration from pollen/tools/pollen.am happens in M2-M3.
//
// Today the methods in this file return dummy values + log a
// warning ; the C symbols exist so consumers can `import
// Amalgame.Pollen` and compile without link errors.
//
// API mapping (target shape, partly stubbed today) :
//
//   CLI flag                   Package call
//   --workflow <path>          Pollen.WorkflowLoad(path, role, port)
//   --node-name <role>         (second arg)
//   --shared-dir <path>        Pollen.WorkflowSetSharedDir(path)
//   --publish host:port:t:v:d  Pollen.Publish(host, port, t, v, d)
//   (start listening)          Pollen.StartListener(port)
//
//   Mosaic embed :
//     public static HttpResponse POST(ctx: WebContext) {
//       let mid: string = Pollen.Publish("127.0.0.1", 8000,
//                                         "order.in", 1, ctx.Body)
//       return HttpResponse.New().Json(
//         "{\"messageId\":\"" + mid + "\"}")
//     }

