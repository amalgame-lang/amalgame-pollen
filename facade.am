// facade.am — public AM API for the amalgame-pollen package.
//
// v0.1.0-dev :  SKELETON with linkable STUBS. The actual engine
// migration from pollen/tools/pollen.am happens in M2-M3.
//
// Today the methods in this file return dummy values + log a
// warning ; the C symbols exist so consumers can `import
// Amalgame.Pollen` and compile without link errors.
//
// API mapping (target shape, partly stubbed today) :
//
//   CLI flag                   Package call
//   --workflow <path>          Pollen.WorkflowLoad(path, role, port)
//   --node-name <role>         (second arg)
//   --shared-dir <path>        Pollen.WorkflowSetSharedDir(path)
//   --publish host:port:t:v:d  Pollen.Publish(host, port, t, v, d)
//   (start listening)          Pollen.StartListener(port)
//
//   Mosaic embed :
//     public static HttpResponse POST(ctx: WebContext) {
//       let mid: string = Pollen.Publish("127.0.0.1", 8000,
//                                         "order.in", 1, ctx.Body)
//       return HttpResponse.New().Json(
//         "{\"messageId\":\"" + mid + "\"}")
//     }

namespace Amalgame.Pollen

import Amalgame.Formats.Json
import Amalgame.Collections
import Amalgame.String

@c {
    #include <stdio.h>
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    #include <unistd.h>
    #include <fcntl.h>
    #include <sys/stat.h>
    #include <sys/types.h>
    #include <sys/socket.h>
    #include <sys/random.h>
    #include <netinet/in.h>
    #include <arpa/inet.h>
    #include <time.h>
    #include <sys/time.h>
    #include <errno.h>
    #include <gc.h>

    /* Singleton-per-process engine state. v0.1 carries flags only ;
     * M2-M3 will copy in the full runtime from pollen.am. */
    static int _pollen_pkg_loaded = 0;
    static char _pollen_pkg_role[64] = "";
    /* M2.4b — self identity for the executions/ recorder. Populated
     * by WorkflowSetSelf alongside the role. */
    static char _pollen_self_host[64] = "127.0.0.1";
    static int  _pollen_self_port = 0;
    /* M2.4c / Phase 6.1 — capability advertisement identity. */
    static char _pollen_cap_instance[37] = "";
    static char _pollen_cap_label[64] = "";
    static int  _pollen_cap_active = 0;
    /* Phase 6.2 — load metrics reported in the capability file.
     * inFlight : messages currently being dispatched (bumped around
     * the forward window). msgsHandled : cumulative consumed count.
     * _Atomic so the writer thread reads consistent values without
     * taking the wf mutex. */
    #include <stdatomic.h>
    static _Atomic long _pollen_inflight = 0;
    static _Atomic long _pollen_msgs_handled = 0;
    /* v0.1.17 — Mosaic bridge hooks. AM closures (AmalgameClosure*
     * from _runtime.h) invoked from the listener worker. on_message
     * transforms a consumed message's data before forward (return ""
     * → drop) ; on_complete fires when a consumed message terminates
     * at this node (leaf : no nexts/cond/for/while). Both run on the
     * worker thread under _pollen_wf_mutex, so they must NOT call
     * Pollen.Forward (would re-lock + deadlock) — return data / use
     * Publish instead. Forward is for OTHER threads (a Mosaic HTTP
     * handler re-emitting out-of-band). Set once at wiring time, read
     * lock-free on the hot path (plain pointer load is atomic enough
     * for set-once-then-read). AmalgameClosure is defined in
     * _runtime.h (already included by the generated TU). */
    /* shared_dir uses the runtime-canonical name (no _pkg_ prefix) so
     * the M2.x state_persist code below ports verbatim from
     * the pollen runtime with zero diff. file-scope static — no link
     * collision with the legacy binary. */
    static char _pollen_shared_dir[512] = "";

    /* === Threading + dispatch mutex ==========================
     *
     * The listener worker takes _pollen_wf_mutex around v3 topic
     * lookup + ACK send so the registry/v3 storage stays consistent
     * across concurrent inbound messages. Workers + capability
     * scanner threads are spawned via GC_pthread_create so their
     * stacks stay scannable. */
    #include <pthread.h>
    extern int GC_pthread_create(pthread_t*, const pthread_attr_t*,
                                  void* (*)(void*), void*);
    extern int GC_pthread_detach(pthread_t);

    #define POLLEN_TOPIC_MAX    128
    #define POLLEN_HOST_MAX     64

    static pthread_mutex_t _pollen_wf_mutex = PTHREAD_MUTEX_INITIALIZER;


    /* === Phase 6.2/6.3 — capability registry + load balancer ====
     *
     * The capability WRITER (Phase 6.1) advertises this node ; the
     * READER thread below scans the sharedDir capabilities dir every
     * 2s and rebuilds an in-memory registry of live providers (those
     * whose heartbeat is < POLLEN_REG_STALE_MS old). The LB resolver
     * maps an emit topic → the providers advertising it → a single
     * pick via power-of-two-choices (lower inFlight wins). Forwarding
     * uses it only when SetLoadBalance(true) is set, else the static
     * nexts are used verbatim (so single-instance demos are
     * unchanged). The registry has its own mutex — independent of the
     * wf mutex, so a forward (holding wf) can read it freely. */
    #define POLLEN_REG_MAX        128
    #define POLLEN_REG_ACTIONS_MAX 16
    #define POLLEN_REG_STALE_MS   15000

    typedef struct {
        char    host[POLLEN_HOST_MAX];
        int     port;
        char    actions[POLLEN_REG_ACTIONS_MAX][POLLEN_TOPIC_MAX];
        int     n_actions;
        long    inflight;
        int64_t heartbeat;
    } pollen_provider_t;

    static pollen_provider_t _pollen_reg[POLLEN_REG_MAX];
    static int               _pollen_reg_n = 0;
    static pthread_mutex_t   _pollen_reg_mutex = PTHREAD_MUTEX_INITIALIZER;
    static int               _pollen_reader_active = 0;
    static int               _pollen_lb_enabled = 0;

    static const char _pollen_pkg_unimpl_warning[] =
        "amalgame-pollen v0.1.0-dev : %s is a stub. "
        "M2-M3 migration from pollen.am in progress.\n";

    /* Forward declarations — order in this TU is one-shot @c so a
     * helper used before its definition needs hoisting. */
    static int64_t _pollen_now_ms_c(void);
    static void    _pollen_gen_uuid(char* buf);
    /* v0.1.18 — LB resolver : emit topic → live provider (power-of-two). */
    static int     _pollen_lb_pick(const char* topic, char* out_host,
                                     size_t host_cap, int* out_port);
    /* Generic JSON field finder — locates `"key":<value>` in a raw
     * JSON buffer and returns the value extent (string with quotes,
     * object/array including braces, or a bare literal). Used by the
     * capability registry parser. */
    static int     _pollen_json_field(const char* buf, size_t len,
                                        const char* key, int klen,
                                        const char** out_v, size_t* out_vlen);
    /* Snapshot the v3 entries' `on:` topics as a comma-separated
     * JSON-string list (without enclosing brackets). Returns the
     * number of bytes written. Takes the wf mutex internally so the
     * capability writer can call it without locking. */
    static size_t  _pollen_v3_format_consumed_topics(char* out, size_t cap);
    /* Portable substring search — memmem is glibc-only and _GNU_SOURCE
     * has to be defined before any system header which is hard to
     * guarantee from inside an amc @c block. Naive O(h × n) is fine
     * for our short needles scanning <8 KiB state files. */
    static const char* _pollen_find(const char* hay, size_t hlen,
                                     const char* needle, size_t nlen) {
        if (nlen == 0 || hlen < nlen) return NULL;
        const char* end = hay + hlen - nlen;
        for (const char* p = hay; p <= end; p++) {
            if (memcmp(p, needle, nlen) == 0) return p;
        }
        return NULL;
    }

    /* Generic JSON field finder — locates `"key":<value>` in a raw
     * JSON buffer. Returns the value extent (string with quotes
     * included, object/array including braces, or a bare literal).
     * Used by the capability registry parser. */
    static int _pollen_json_field(const char* buf, size_t len,
                                    const char* key, int klen,
                                    const char** out_v, size_t* out_vlen) {
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle), "\"%.*s\":", klen, key);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return 0;
        const char* k = _pollen_find(buf, len, needle, (size_t) nlen);
        if (!k) return 0;
        const char* v = k + nlen;
        while (v < buf + len && (*v == ' ' || *v == '\t')) v++;
        if (v >= buf + len) return 0;
        const char* e = v;
        if (*v == '"') {
            e = v + 1;
            while (e < buf + len) {
                if (*e == '\\' && e + 1 < buf + len) { e += 2; continue; }
                if (*e == '"') { e++; break; }
                e++;
            }
        } else if (*v == '{' || *v == '[') {
            char open = *v; char close = (open == '{') ? '}' : ']';
            int depth = 0;
            int in_str = 0;
            e = v;
            while (e < buf + len) {
                char c = *e;
                if (in_str) {
                    if (c == '\\' && e + 1 < buf + len) { e += 2; continue; }
                    if (c == '"') in_str = 0;
                } else {
                    if (c == '"') in_str = 1;
                    else if (c == open) depth++;
                    else if (c == close) {
                        depth--;
                        if (depth == 0) { e++; break; }
                    }
                }
                e++;
            }
        } else {
            while (e < buf + len && *e != ',' && *e != '}' && *e != ']'
                   && *e != ' ' && *e != '\n' && *e != '\r' && *e != '\t') e++;
        }
        *out_v = v;
        *out_vlen = (size_t)(e - v);
        return 1;
    }

    /* === Workflow lifecycle =================================== */
    static void
    Amalgame_Pollen_Pollen_WorkflowSetSharedDir_c(code_string path) {
        if (!path) return;
        strncpy(_pollen_shared_dir, path,
                 sizeof(_pollen_shared_dir) - 1);
        _pollen_shared_dir[sizeof(_pollen_shared_dir) - 1] = 0;
        /* best-effort create — EEXIST ok ; sub-dirs (state/, executions/)
         * are created lazily by their respective writers. */
        mkdir(_pollen_shared_dir, 0755);
    }

    static void
    Amalgame_Pollen_Pollen_WorkflowSetSelf_c(code_string role, code_string host,
                                               int64_t port) {
        if (role) {
            strncpy(_pollen_pkg_role, role, sizeof(_pollen_pkg_role) - 1);
            _pollen_pkg_role[sizeof(_pollen_pkg_role) - 1] = 0;
        }
        if (host) {
            strncpy(_pollen_self_host, (const char*) host,
                     sizeof(_pollen_self_host) - 1);
            _pollen_self_host[sizeof(_pollen_self_host) - 1] = 0;
        }
        _pollen_self_port = (int) port;
    }

    /* M2.4b — write one execution step record under
     * <sharedDir>/executions/<mid>-<role>.json. Best-effort :
     * O_CREAT|O_EXCL skips duplicates, any fs error is ignored.
     * The manager's Live panel reads these + walks parentMessageId
     * backwards to reconstruct the chain. All string args are
     * length-delimited so callers can pass recv-buffer pointers. */
    static void _pollen_wf_record_step(const char* mid_out, size_t mid_out_len,
                                         const char* parent_mid, size_t parent_mid_len,
                                         const char* topic_in, size_t topic_in_len,
                                         const char* topic_out, int n_nexts,
                                         const char* dbg_session, size_t dbg_session_len) {
        if (!_pollen_shared_dir[0] || !mid_out || mid_out_len == 0) return;
        char path[1024];
        int pn = snprintf(path, sizeof(path), "%s/executions/%.*s-%s.json",
                          _pollen_shared_dir,
                          (int) mid_out_len, mid_out,
                          _pollen_pkg_role[0] ? _pollen_pkg_role : "node");
        if (pn <= 0 || pn >= (int) sizeof(path)) return;
        /* ensure the executions/ dir exists */
        char d[600];
        snprintf(d, sizeof(d), "%s/executions", _pollen_shared_dir);
        mkdir(d, 0755);
        int fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0644);
        if (fd < 0) return;
        char dbg_suffix[96] = "";
        if (dbg_session && dbg_session_len > 0 && dbg_session_len < 64) {
            snprintf(dbg_suffix, sizeof(dbg_suffix),
                ",\"debugSession\":\"%.*s\"",
                (int) dbg_session_len, dbg_session);
        }
        char buf[1400];
        int64_t now = _pollen_now_ms_c();
        int n;
        if (parent_mid && parent_mid_len > 0) {
            n = snprintf(buf, sizeof(buf),
                "{\"messageId\":\"%.*s\",\"parentMessageId\":\"%.*s\","
                 "\"role\":\"%s\",\"topicIn\":\"%.*s\",\"topicOut\":\"%s\","
                 "\"nextCount\":%d,\"node\":\"%s:%d\",\"timestamp\":%lld%s}\n",
                (int) mid_out_len, mid_out,
                (int) parent_mid_len, parent_mid,
                _pollen_pkg_role,
                (int) topic_in_len, topic_in ? topic_in : "",
                topic_out ? topic_out : "",
                n_nexts, _pollen_self_host, _pollen_self_port,
                (long long) now, dbg_suffix);
        } else {
            n = snprintf(buf, sizeof(buf),
                "{\"messageId\":\"%.*s\",\"parentMessageId\":null,"
                 "\"role\":\"%s\",\"topicIn\":\"%.*s\",\"topicOut\":\"%s\","
                 "\"nextCount\":%d,\"node\":\"%s:%d\",\"timestamp\":%lld%s}\n",
                (int) mid_out_len, mid_out,
                _pollen_pkg_role,
                (int) topic_in_len, topic_in ? topic_in : "",
                topic_out ? topic_out : "",
                n_nexts, _pollen_self_host, _pollen_self_port,
                (long long) now, dbg_suffix);
        }
        if (n > 0 && n < (int) sizeof(buf)) {
            ssize_t w = write(fd, buf, (size_t) n);
            (void) w;
        }
        close(fd);
    }


    /* === TCP transport ======================================== */

    /* M2.3b — accept loop + per-connection ACK echo worker.
     * Plain TCP + newline-framed JSON envelopes. No workflow
     * dispatch yet (M2.3c) and no debug bridge (M2.4) — just
     * recv → extract messageId → send back an ACK envelope.
     * One pthread per accepted connection ; the accept thread
     * itself blocks in StartListener until the process exits.
     * pthread.h is already included earlier alongside workflow
     * state definitions. */

    /* Phase 3d — forward decls so _pollen_listener_worker can branch
     * on the v3 storage layer before reaching its definition further
     * down the @c block. The tentative-definition rule lets these
     * `static int` lines coexist with the real definitions in the
     * Phase 2 storage section. */
    static int _pollen_v3_active;
    static int _pollen_v3_entry_count;
    static _Atomic int _pollen_v3_dispatch_count;
    static int _pollen_v3_lookup_entry_by_topic(const char* topic);

    /* AM-defined v3 dispatcher entry point (Pollen.WorkflowV3DispatchTopic).
     * Defined later in this TU by the amc codegen ; called from
     * _pollen_listener_worker after the wf-mutex is released. */
    extern int64_t Amalgame_Pollen_Pollen_WorkflowV3DispatchTopic(
        code_string topic, code_string envelopeJson);

    static void* _pollen_listener_worker(void* arg) {
        int fd = (int)(intptr_t) arg;
        char rbuf[16384];
        size_t rlen = 0;
        char ack[256];
        const char* MID_KEY   = "\"messageId\":\"";
        const size_t MID_KEY_LEN = 13;
        const char* TOPIC_KEY = "\"topic\":{\"uuid\":\"";
        const size_t TOPIC_KEY_LEN = 17;

        for (;;) {
            if (rlen >= sizeof(rbuf)) break;  /* oversize line — drop */
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            for (;;) {
                char* nl = memchr(rbuf, '\n', rlen);
                if (!nl) break;
                size_t line_len = (size_t)(nl - rbuf);

                /* Decide ACK policy under the wf mutex :
                 *   v3 active + topic matches an entry's `on:` : ACK + dispatch
                 *   v3 active + topic doesn't match           : drop, no ACK
                 *   v3 inactive (no workflow loaded)           : ACK (free-form fallback) */
                int do_ack = 1;
                int v3_handled = 0;
                const char* v3_topic_gc = 0;
                const char* v3_env_gc   = 0;
                pthread_mutex_lock(&_pollen_wf_mutex);
                if (_pollen_v3_active && _pollen_v3_entry_count > 0) {
                    const char* tp3 = _pollen_find(rbuf, line_len,
                                                     TOPIC_KEY, TOPIC_KEY_LEN);
                    int matched3 = 0;
                    if (tp3) {
                        tp3 += TOPIC_KEY_LEN;
                        const char* tq3 = memchr(tp3, '"',
                                                   line_len - (size_t)(tp3 - rbuf));
                        if (tq3) {
                            size_t tlen3 = (size_t)(tq3 - tp3);
                            char tnt[POLLEN_TOPIC_MAX];
                            if (tlen3 < sizeof(tnt)) {
                                memcpy(tnt, tp3, tlen3);
                                tnt[tlen3] = 0;
                                if (_pollen_v3_lookup_entry_by_topic(tnt) >= 0) {
                                    /* GC-dup so the AM call after the
                                     * unlock has stable storage. */
                                    char* td = (char*) GC_MALLOC_ATOMIC(tlen3 + 1);
                                    char* ed = (char*) GC_MALLOC_ATOMIC(line_len + 1);
                                    if (td && ed) {
                                        memcpy(td, tp3, tlen3); td[tlen3] = 0;
                                        memcpy(ed, rbuf, line_len); ed[line_len] = 0;
                                        v3_topic_gc = td;
                                        v3_env_gc   = ed;
                                        v3_handled  = 1;
                                        matched3    = 1;
                                    }
                                }
                            }
                        }
                    }
                    /* v3 is loaded but this topic isn't consumed by any
                     * entry → drop silently (no ACK), same shape as the
                     * v2 dispatcher's "topic not in consumes" branch. */
                    if (!matched3) {
                        do_ack = 0;
                    }
                }

                if (do_ack) {
                    const char* mp = _pollen_find(rbuf, line_len,
                                                    MID_KEY, MID_KEY_LEN);
                    if (mp) {
                        mp += MID_KEY_LEN;
                        const char* mq = memchr(mp, '"',
                                                  line_len - (size_t)(mp - rbuf));
                        if (mq) {
                            size_t midlen = (size_t)(mq - mp);
                            int64_t now = _pollen_now_ms_c();
                            int alen = snprintf(ack, sizeof(ack),
                                "{\"type\":\"ACK\",\"messageId\":\"%.*s\","
                                 "\"timestamp\":%lld}\n",
                                (int) midlen, mp, (long long) now);
                            if (alen > 0 && alen < (int) sizeof(ack)) {
                                ssize_t sent = 0;
                                int sock_dead = 0;
                                while (sent < alen) {
                                    ssize_t w = send(fd, ack + sent,
                                                     (size_t)(alen - sent),
                                                     MSG_NOSIGNAL);
                                    if (w <= 0) { sock_dead = 1; break; }
                                    sent += w;
                                }
                                if (sock_dead) {
                                    pthread_mutex_unlock(&_pollen_wf_mutex);
                                    goto worker_done;
                                }
                            }
                        }
                    }
                }
                pthread_mutex_unlock(&_pollen_wf_mutex);

                /* Phase 3d — v3 dispatch happens AFTER the mutex
                 * release. The dispatcher walks the AST, evaluates
                 * CEL-lite expressions, may call Pollen.Publish ;
                 * all of those allocate GC objects + the publish
                 * path re-locks the registry mutex. Doing the call
                 * inside the wf-mutex critical section would risk
                 * a deadlock if the dispatched workflow re-enters
                 * via a self-call. */
                if (v3_handled && v3_topic_gc && v3_env_gc) {
                    atomic_fetch_add(&_pollen_msgs_handled, 1);
                    atomic_fetch_add(&_pollen_inflight, 1);
                    /* Phase 4 — surface the v3 hop in the manager's
                     * Live executions panel. Generated here (not by
                     * the dispatcher) so a single hop is recorded
                     * per inbound message regardless of how many
                     * inner steps the dispatcher walks. */
                    if (_pollen_shared_dir[0]) {
                        char hop_mid[37];
                        _pollen_gen_uuid(hop_mid);
                        /* Pull the inbound mid as parent. */
                        const char* pmp = _pollen_find(rbuf, line_len,
                                                        MID_KEY, MID_KEY_LEN);
                        const char* parent3 = 0; size_t parent3_len = 0;
                        if (pmp) {
                            const char* pmv = pmp + MID_KEY_LEN;
                            const char* pmq = memchr(pmv, '"',
                                line_len - (size_t)(pmv - rbuf));
                            if (pmq) {
                                parent3     = pmv;
                                parent3_len = (size_t)(pmq - pmv);
                            }
                        }
                        /* Optional debug session, same shape as v2. */
                        const char* dseg = _pollen_find(rbuf, line_len,
                            "\"debug\":{\"session\":\"", 20);
                        const char* dsess3 = 0; size_t dsess3_len = 0;
                        if (dseg) {
                            const char* dsv = dseg + 20;
                            const char* dsq = memchr(dsv, '"',
                                line_len - (size_t)(dsv - rbuf));
                            if (dsq) {
                                dsess3     = dsv;
                                dsess3_len = (size_t)(dsq - dsv);
                            }
                        }
                        _pollen_wf_record_step(hop_mid, 36,
                            parent3, parent3_len,
                            v3_topic_gc, strlen(v3_topic_gc),
                            0 /* topic_out — v3 owns its forwards */,
                            1 /* n_nexts — count the v3 hop */,
                            dsess3, dsess3_len);
                    }
                    (void) Amalgame_Pollen_Pollen_WorkflowV3DispatchTopic(
                        (code_string) v3_topic_gc,
                        (code_string) v3_env_gc);
                    atomic_fetch_add(&_pollen_v3_dispatch_count, 1);
                    atomic_fetch_sub(&_pollen_inflight, 1);
                }

                size_t consumed = line_len + 1;
                memmove(rbuf, rbuf + consumed, rlen - consumed);
                rlen -= consumed;
            }
        }
    worker_done:
        close(fd);
        return NULL;
    }

    static int _pollen_listen_simple(int port) {
        int srv = socket(AF_INET, SOCK_STREAM, 0);
        if (srv < 0) return -1;
        int one = 1;
        setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = htonl(INADDR_ANY);
        addr.sin_port = htons((uint16_t) port);
        if (bind(srv, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(srv); return -1;
        }
        if (listen(srv, 64) < 0) { close(srv); return -1; }
        for (;;) {
            int conn = accept(srv, NULL, NULL);
            if (conn < 0) continue;
            pthread_t th;
            if (GC_pthread_create(&th, NULL,
                                _pollen_listener_worker,
                                (void*)(intptr_t) conn) != 0) {
                close(conn); continue;
            }
            GC_pthread_detach(th);
        }
        /* unreachable until we add a shutdown path */
        close(srv);
        return 0;
    }

    static void
    Amalgame_Pollen_Pollen_StartListener_c(int64_t port) {
        (void) _pollen_listen_simple((int) port);
    }

    /* M2.4c / Phase 6.1 — capability writer. A detached thread that
     * rewrites <sharedDir>/capabilities/<instanceId>.json every 5s
     * with this node's identity + the topics it consumes (as
     * `actions`) + a fresh heartbeat. The manager's discovery panel
     * reads these + flags staleness (heartbeat > 15s old). Atomic
     * tmp+rename so a reader never sees a half-written file. */
    static void* _pollen_capability_writer(void* arg) {
        (void) arg;
        for (;;) {
            if (_pollen_shared_dir[0] && _pollen_cap_instance[0]) {
                char dir[600];
                snprintf(dir, sizeof(dir), "%s/capabilities", _pollen_shared_dir);
                mkdir(dir, 0755);

                /* actions[] from the v3 entries' `on:` topics — the
                 * topics this node will consume when a bus message
                 * matches them. The accessor is defined further down
                 * (alongside the v3 storage) and takes the wf mutex
                 * internally. */
                char actions[2048];
                size_t ao = 0;
                actions[0] = 0;
                ao = _pollen_v3_format_consumed_topics(actions, sizeof(actions));

                int64_t now = _pollen_now_ms_c();
                long inflight = atomic_load(&_pollen_inflight);
                long handled  = atomic_load(&_pollen_msgs_handled);
                char buf[4096];
                int n = snprintf(buf, sizeof(buf),
                    "{\"instanceId\":\"%s\",\"host\":\"%s\",\"port\":%d,"
                     "\"label\":\"%s\",\"actions\":[%s],"
                     "\"load\":{\"inFlight\":%ld,\"msgsHandled\":%ld},"
                     "\"heartbeat\":%lld,\"version\":\"amalgame-pollen\"}\n",
                    _pollen_cap_instance, _pollen_self_host, _pollen_self_port,
                    _pollen_cap_label[0] ? _pollen_cap_label : _pollen_cap_instance,
                    actions, inflight, handled, (long long) now);
                if (n > 0 && n < (int) sizeof(buf)) {
                    char path[800], tmp[920];
                    snprintf(path, sizeof(path), "%s/%s.json", dir, _pollen_cap_instance);
                    snprintf(tmp, sizeof(tmp), "%s.tmp.%d", path, (int) getpid());
                    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
                    if (fd >= 0) {
                        ssize_t w = write(fd, buf, (size_t) n);
                        close(fd);
                        if (w == (ssize_t) n) { rename(tmp, path); }
                        else { unlink(tmp); }
                    }
                }
            }
            sleep(5);
        }
        return NULL;
    }

    static void
    Amalgame_Pollen_Pollen_StartCapabilityWriter_c(code_string label,
                                                     code_string host, int64_t port) {
        if (_pollen_cap_active) return;  /* idempotent */
        _pollen_gen_uuid(_pollen_cap_instance);
        if (label) {
            strncpy(_pollen_cap_label, (const char*) label, sizeof(_pollen_cap_label) - 1);
            _pollen_cap_label[sizeof(_pollen_cap_label) - 1] = 0;
        }
        if (host) {
            strncpy(_pollen_self_host, (const char*) host, sizeof(_pollen_self_host) - 1);
            _pollen_self_host[sizeof(_pollen_self_host) - 1] = 0;
        }
        if (port > 0) { _pollen_self_port = (int) port; }
        _pollen_cap_active = 1;
        pthread_t th;
        if (GC_pthread_create(&th, NULL, _pollen_capability_writer, NULL) == 0) {
            GC_pthread_detach(th);
        } else {
            _pollen_cap_active = 0;
        }
    }

    /* === Phase 6.2/6.3 — capability reader + LB resolver ====== */

    #include <dirent.h>

    /* Parse one capability file's JSON into a provider slot. Returns
     * 1 on success (host + port + ≥1 advertised action). */
    static int _pollen_reg_parse_one(const char* buf, size_t len,
                                       pollen_provider_t* p) {
        const char* v; size_t vlen;
        p->n_actions = 0; p->inflight = 0; p->heartbeat = 0;
        p->host[0] = 0; p->port = 0;

        if (_pollen_json_field(buf, len, "host", 4, &v, &vlen)
            && vlen >= 2 && *v == '"') {
            size_t hl = vlen - 2;
            if (hl >= sizeof(p->host)) hl = sizeof(p->host) - 1;
            memcpy(p->host, v + 1, hl); p->host[hl] = 0;
        }
        if (_pollen_json_field(buf, len, "port", 4, &v, &vlen)) {
            char tmp[16]; size_t cn = vlen < 15 ? vlen : 15;
            memcpy(tmp, v, cn); tmp[cn] = 0; p->port = atoi(tmp);
        }
        if (_pollen_json_field(buf, len, "heartbeat", 9, &v, &vlen)) {
            char tmp[24]; size_t cn = vlen < 23 ? vlen : 23;
            memcpy(tmp, v, cn); tmp[cn] = 0; p->heartbeat = (int64_t) atoll(tmp);
        }
        /* inFlight is nested under "load" but the key is unique. */
        {
            const char* k = _pollen_find(buf, len, "\"inFlight\":", 11);
            if (k) p->inflight = atol(k + 11);
        }
        if (_pollen_json_field(buf, len, "actions", 7, &v, &vlen)
            && vlen >= 2 && *v == '[') {
            const char* q = v + 1;
            const char* end = v + vlen - 1;
            while (q < end && p->n_actions < POLLEN_REG_ACTIONS_MAX) {
                while (q < end && (*q == ' ' || *q == ',' || *q == '\n'
                                   || *q == '\t' || *q == '\r')) q++;
                if (q >= end || *q != '"') break;
                q++;
                const char* s = q;
                while (q < end && *q != '"') {
                    if (*q == '\\' && q + 1 < end) q++;
                    q++;
                }
                size_t al = (size_t)(q - s);
                if (al >= POLLEN_TOPIC_MAX) al = POLLEN_TOPIC_MAX - 1;
                memcpy(p->actions[p->n_actions], s, al);
                p->actions[p->n_actions][al] = 0;
                p->n_actions++;
                if (q < end) q++;
            }
        }
        return (p->host[0] && p->port > 0 && p->n_actions > 0);
    }

    /* Reader thread : every 2s, scan the sharedDir capabilities dir,
     * parse + drop stale (heartbeat > POLLEN_REG_STALE_MS old), and
     * atomic-swap the in-memory registry under its own mutex. */
    static void* _pollen_capability_reader(void* arg) {
        (void) arg;
        for (;;) {
            if (_pollen_shared_dir[0]) {
                char dir[600];
                snprintf(dir, sizeof(dir), "%s/capabilities", _pollen_shared_dir);
                DIR* d = opendir(dir);
                if (d) {
                    pollen_provider_t tmp[POLLEN_REG_MAX];
                    int tn = 0;
                    int64_t now = _pollen_now_ms_c();
                    struct dirent* de;
                    while ((de = readdir(d)) != NULL && tn < POLLEN_REG_MAX) {
                        const char* nm = de->d_name;
                        size_t nl = strlen(nm);
                        if (nl < 6 || strcmp(nm + nl - 5, ".json") != 0) continue;
                        if (strstr(nm, ".tmp.")) continue;
                        char path[800];
                        snprintf(path, sizeof(path), "%s/%s", dir, nm);
                        int fd = open(path, O_RDONLY);
                        if (fd < 0) continue;
                        char fbuf[4096];
                        ssize_t fn = read(fd, fbuf, sizeof(fbuf) - 1);
                        close(fd);
                        if (fn <= 0) continue;
                        fbuf[fn] = 0;
                        pollen_provider_t p;
                        if (!_pollen_reg_parse_one(fbuf, (size_t) fn, &p)) continue;
                        if (now - p.heartbeat > POLLEN_REG_STALE_MS) continue;
                        tmp[tn++] = p;
                    }
                    closedir(d);
                    pthread_mutex_lock(&_pollen_reg_mutex);
                    if (tn > 0) memcpy(_pollen_reg, tmp,
                                       sizeof(pollen_provider_t) * (size_t) tn);
                    _pollen_reg_n = tn;
                    pthread_mutex_unlock(&_pollen_reg_mutex);
                }
            }
            usleep(2000 * 1000);  /* 2s */
        }
        return NULL;
    }

    /* Power-of-two-choices pick among live providers of `topic`.
     * Writes the winner's host/port ; returns 1 on success, 0 if no
     * provider advertises the topic. */
    static int _pollen_lb_pick(const char* topic, char* out_host,
                                 size_t host_cap, int* out_port) {
        if (!topic || !topic[0]) return 0;
        int cand[POLLEN_REG_MAX]; int nc = 0;
        pthread_mutex_lock(&_pollen_reg_mutex);
        for (int i = 0; i < _pollen_reg_n && nc < POLLEN_REG_MAX; i++) {
            for (int a = 0; a < _pollen_reg[i].n_actions; a++) {
                if (strcmp(_pollen_reg[i].actions[a], topic) == 0) {
                    cand[nc++] = i; break;
                }
            }
        }
        int chosen = -1;
        if (nc == 1) {
            chosen = cand[0];
        } else if (nc >= 2) {
            unsigned int r1 = 0, r2 = 0;
            getrandom(&r1, sizeof(r1), 0);
            getrandom(&r2, sizeof(r2), 0);
            int i1 = cand[r1 % (unsigned) nc];
            int i2 = cand[r2 % (unsigned) nc];
            if (i1 == i2) i2 = cand[(r2 % (unsigned) nc + 1) % (unsigned) nc];
            chosen = (_pollen_reg[i1].inflight <= _pollen_reg[i2].inflight)
                       ? i1 : i2;
        }
        int ok = 0;
        if (chosen >= 0) {
            strncpy(out_host, _pollen_reg[chosen].host, host_cap - 1);
            out_host[host_cap - 1] = 0;
            *out_port = _pollen_reg[chosen].port;
            ok = 1;
        }
        pthread_mutex_unlock(&_pollen_reg_mutex);
        return ok;
    }

    static void
    Amalgame_Pollen_Pollen_StartCapabilityReader_c(void) {
        if (_pollen_reader_active) return;  /* idempotent */
        _pollen_reader_active = 1;
        pthread_t th;
        if (GC_pthread_create(&th, NULL, _pollen_capability_reader, NULL) == 0) {
            GC_pthread_detach(th);
        } else {
            _pollen_reader_active = 0;
        }
    }

    static void
    Amalgame_Pollen_Pollen_SetLoadBalance_c(int on) {
        _pollen_lb_enabled = on ? 1 : 0;
    }

    static int64_t
    Amalgame_Pollen_Pollen_RegistrySize_c(void) {
        pthread_mutex_lock(&_pollen_reg_mutex);
        int n = _pollen_reg_n;
        pthread_mutex_unlock(&_pollen_reg_mutex);
        return (int64_t) n;
    }

    static code_string
    Amalgame_Pollen_Pollen_ResolveProvider_c(code_string topic) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!topic) return (code_string) empty;
        char host[POLLEN_HOST_MAX]; int port = 0;
        if (!_pollen_lb_pick((const char*) topic, host, sizeof(host), &port)) {
            return (code_string) empty;
        }
        char buf[POLLEN_HOST_MAX + 16];
        int n = snprintf(buf, sizeof(buf), "%s:%d", host, port);
        if (n <= 0 || n >= (int) sizeof(buf)) return (code_string) empty;
        char* out = (char*) GC_MALLOC_ATOMIC((size_t) n + 1);
        if (!out) return (code_string) empty;
        memcpy(out, buf, (size_t) n); out[n] = 0;
        return (code_string) out;
    }

    /* M2.3a — UUID v4 generator (RFC 4122 variant + version bits).
     * `buf` must hold at least 37 bytes (36 + NUL). */
    static void _pollen_gen_uuid(char* buf) {
        unsigned char b[16];
        getrandom(b, 16, 0);
        b[6] = (unsigned char)((b[6] & 0x0F) | 0x40);
        b[8] = (unsigned char)((b[8] & 0x3F) | 0x80);
        const char* hex = "0123456789abcdef";
        int p = 0;
        for (int k = 0; k < 16; k++) {
            if (k == 4 || k == 6 || k == 8 || k == 10) buf[p++] = '-';
            buf[p++] = hex[(b[k] >> 4) & 0xF];
            buf[p++] = hex[b[k] & 0xF];
        }
        buf[p] = '\0';
    }

    static int64_t _pollen_now_ms_c(void) {
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        return (int64_t) ts.tv_sec * 1000 + (int64_t) ts.tv_nsec / 1000000;
    }

    /* M2.3a — single-message fire-and-forget publish. Connects,
     * sends one well-formed MESSAGE envelope (newline-terminated),
     * closes ; does NOT wait for an ACK. The kernel-level TCP
     * acknowledgement gives us delivery confirmation up to the
     * peer's socket buffer ; Pollen.PublishSync (planned v0.2)
     * will block on the application-level ACK.
     *
     * `data_json` is inserted verbatim into the envelope so callers
     * are responsible for emitting valid JSON. `out_mid` (37-byte
     * buffer) receives the freshly minted messageId on success.
     *
     * Returns 1 on success, 0 on socket / connect / send failure. */
    static int _pollen_publish_one(const char* host, int port,
                                     const char* topic_uuid,
                                     int64_t topic_version,
                                     const char* data_json,
                                     char* out_mid) {
        if (!host || !topic_uuid || !data_json || !out_mid) return 0;
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return 0;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return 0;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return 0;
        }
        _pollen_gen_uuid(out_mid);

        char envelope[8192];
        int64_t now = _pollen_now_ms_c();
        int env_len = snprintf(envelope, sizeof(envelope),
            "{\"messageId\":\"%s\",\"rootMessageId\":\"%s\","
             "\"type\":\"MESSAGE\","
             "\"topic\":{\"uuid\":\"%s\",\"version\":%lld},"
             "\"data\":%s,\"timestamp\":%lld}\n",
            out_mid, out_mid, topic_uuid,
            (long long) topic_version, data_json, (long long) now);
        if (env_len <= 0 || env_len >= (int) sizeof(envelope)) {
            close(fd); return 0;
        }
        ssize_t sent = 0;
        while (sent < env_len) {
            ssize_t n = send(fd, envelope + sent,
                             (size_t)(env_len - sent), MSG_NOSIGNAL);
            if (n < 0) { close(fd); return 0; }
            sent += n;
        }
        close(fd);
        return 1;
    }

    static code_string
    Amalgame_Pollen_Pollen_Publish_c(code_string host, int64_t port,
                                       code_string topicUuid, int64_t topicVersion,
                                       code_string dataJson) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!host || !topicUuid || !dataJson) return (code_string) empty;
        char mid[37];
        if (!_pollen_publish_one((const char*) host, (int) port,
                                   (const char*) topicUuid,
                                   topicVersion,
                                   (const char*) dataJson,
                                   mid)) {
            return (code_string) empty;
        }
        char* out = (char*) GC_MALLOC_ATOMIC(37);
        if (!out) return (code_string) empty;
        memcpy(out, mid, 37);
        return (code_string) out;
    }

    /* M2.3b — synchronous publish : same as _pollen_publish_one but
     * keeps the socket open after the send and waits up to
     * timeout_ms for the matching ACK. Returns 1 if ACK arrived
     * for the expected mid, 0 on connect/send/recv/timeout failure
     * or mid mismatch. `out_mid` always receives the minted UUID
     * (even on ACK failure) so the caller can log it. */
    #include <poll.h>
    static int _pollen_publish_sync(const char* host, int port,
                                      const char* topic_uuid,
                                      int64_t topic_version,
                                      const char* data_json,
                                      int timeout_ms,
                                      char* out_mid) {
        if (!host || !topic_uuid || !data_json || !out_mid) return 0;
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return 0;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return 0;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return 0;
        }
        _pollen_gen_uuid(out_mid);
        char envelope[8192];
        int64_t now = _pollen_now_ms_c();
        int env_len = snprintf(envelope, sizeof(envelope),
            "{\"messageId\":\"%s\",\"rootMessageId\":\"%s\","
             "\"type\":\"MESSAGE\","
             "\"topic\":{\"uuid\":\"%s\",\"version\":%lld},"
             "\"data\":%s,\"timestamp\":%lld}\n",
            out_mid, out_mid, topic_uuid,
            (long long) topic_version, data_json, (long long) now);
        if (env_len <= 0 || env_len >= (int) sizeof(envelope)) {
            close(fd); return 0;
        }
        ssize_t sent = 0;
        while (sent < env_len) {
            ssize_t n = send(fd, envelope + sent,
                              (size_t)(env_len - sent), MSG_NOSIGNAL);
            if (n < 0) { close(fd); return 0; }
            sent += n;
        }

        /* Wait for one newline-terminated line and verify it ACKs
         * our mid. poll() bounds the wait by timeout_ms. */
        char rbuf[2048];
        size_t rlen = 0;
        int got_ack = 0;
        int remaining = timeout_ms > 0 ? timeout_ms : 5000;
        while (rlen < sizeof(rbuf) - 1) {
            struct pollfd pfd; pfd.fd = fd; pfd.events = POLLIN;
            int64_t start = _pollen_now_ms_c();
            int pr = poll(&pfd, 1, remaining);
            if (pr <= 0) break;  /* timeout or error */
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - 1 - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            rbuf[rlen] = 0;
            char* nl = memchr(rbuf, '\n', rlen);
            if (nl) {
                size_t line_len = (size_t)(nl - rbuf);
                const char* mp = _pollen_find(rbuf, line_len,
                                                "\"messageId\":\"", 13);
                if (mp) {
                    mp += 13;
                    const char* mq = memchr(mp, '"',
                                              line_len - (size_t)(mp - rbuf));
                    if (mq && (size_t)(mq - mp) == 36
                        && memcmp(mp, out_mid, 36) == 0) {
                        got_ack = 1;
                    }
                }
                break;
            }
            int64_t elapsed = _pollen_now_ms_c() - start;
            remaining -= (int) elapsed;
            if (remaining <= 0) break;
        }
        close(fd);
        return got_ack;
    }

    static code_string
    Amalgame_Pollen_Pollen_PublishSync_c(code_string host, int64_t port,
                                          code_string topicUuid, int64_t topicVersion,
                                          code_string dataJson, int64_t timeoutMs) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!host || !topicUuid || !dataJson) return (code_string) empty;
        char mid[37];
        int ok = _pollen_publish_sync((const char*) host, (int) port,
                                        (const char*) topicUuid,
                                        topicVersion,
                                        (const char*) dataJson,
                                        (int) timeoutMs, mid);
        if (!ok) return (code_string) empty;
        char* out = (char*) GC_MALLOC_ATOMIC(37);
        if (!out) return (code_string) empty;
        memcpy(out, mid, 37);
        return (code_string) out;
    }

    /* === Pollen v3 — runtime AST + name resolver =============
     *
     * Phase 2 of the v3 roadmap (docs/proposals/pollen-v3.md §"v3
     * dispatcher"). Storage only — no dispatch yet (Phase 3).
     *
     * Layout :
     *   - one flat AST pool indexed by int32. Each node carries a
     *     `kind`, up to two child indices, and a `next_sibling`
     *     index that chains array-of-steps sequences. Container
     *     types (`for`, `while`, `if`, `entry.do`) point `child0`
     *     at the head of the body chain.
     *   - one entries[] pool, one anchors[] pool, one actions[] pool.
     *     entries[i].do_root indexes into the AST pool ; anchors[i]
     *     and goto-target resolution carry int idx into entries[] /
     *     anchors[] (see `goto_kind`).
     *   - GC-allocated `const char*` strings for names / exprs /
     *     params / bind_key, so an entry name like "shared-pipeline"
     *     isn't capped at a fixed buffer length.
     *
     * Setters are called from AM-side `Pollen.WorkflowLoadV3` between
     * `_pollen_v3_reload_begin` and `_pollen_v3_reload_commit`. The
     * commit step runs `_pollen_v3_resolve_gotos` so post-load each
     * goto node knows whether its target is an entry or an anchor.
     */

    #define POLLEN_MAX_ENTRIES             256
    #define POLLEN_MAX_AST_NODES          4096
    #define POLLEN_MAX_ANCHORS_TOTAL      4096
    #define POLLEN_MAX_ACTIONS             256
    #define POLLEN_MAX_ENTRY_PARAMS          8

    /* PollenAstKind — must match enum CelNodeKind / AM-side AstKind
     * indices used by the walker (see WorkflowLoadV3). */
    #define POLLEN_AST_CALL    1
    #define POLLEN_AST_IF      2
    #define POLLEN_AST_FOR     3
    #define POLLEN_AST_WHILE   4
    #define POLLEN_AST_SET     5
    #define POLLEN_AST_GOTO    6
    #define POLLEN_AST_ANCHOR  7
    #define POLLEN_AST_CASE    8   /* synthetic — one per if.cases[i] */

    /* goto_kind values stored on POLLEN_AST_GOTO nodes after resolve. */
    #define POLLEN_GOTO_UNRESOLVED  0
    #define POLLEN_GOTO_ENTRY       1
    #define POLLEN_GOTO_ANCHOR      2

    typedef struct {
        uint8_t  kind;
        uint8_t  mode;          /* call.mode : 0=one  1=all */
        uint8_t  on_error;      /* call.on_error : 0=log 1=fail 2=drop */
        uint8_t  has_else;      /* CASE node : 1 if `else: true` */
        int32_t  child0;        /* container body head ; CASE → body head */
        int32_t  child1;        /* reserved for future use */
        int32_t  next_sibling;  /* chain element of sequence / case list */
        int32_t  max_iter;      /* while.maxIter (0 = no cap declared) */
        int32_t  args_first;    /* goto.args[] — flat pool offset */
        int32_t  args_count;
        int32_t  goto_kind;     /* POLLEN_GOTO_* */
        int32_t  goto_idx;      /* entries[]/anchors[] idx post-resolve */
        const char* name;       /* call.action / set.key / goto.target /
                                  * anchor.name / for.var */
        const char* expr;       /* when / cond / in / value / arg /
                                  * returns / goto target name before resolve */
        const char* bind_key;   /* goto.bind */
    } PollenAstNode;

    typedef struct {
        const char* name;
        const char* on_topic;        /* NULL if no `on:` */
        int32_t     do_root;          /* AST idx of body head, -1 if empty */
        int32_t     has_returns;
        const char* returns_expr;
        int32_t     params_count;
        const char* params[POLLEN_MAX_ENTRY_PARAMS];
    } PollenEntry;

    typedef struct {
        const char* name;
        int32_t     entry_idx;
        int32_t     node_idx;
    } PollenAnchor;

    typedef struct {
        const char* name;
        const char* topic;
    } PollenAction;

    static PollenAstNode _pollen_v3_ast[POLLEN_MAX_AST_NODES];
    static int           _pollen_v3_ast_count;

    static PollenEntry   _pollen_v3_entries[POLLEN_MAX_ENTRIES];
    static int           _pollen_v3_entry_count;

    static PollenAnchor  _pollen_v3_anchors[POLLEN_MAX_ANCHORS_TOTAL];
    static int           _pollen_v3_anchor_count;

    static PollenAction  _pollen_v3_actions[POLLEN_MAX_ACTIONS];
    static int           _pollen_v3_action_count;

    /* Args pool — every goto.args[] expression slots a (char*) here ;
     * the goto node carries (args_first, args_count) into this pool. */
    #define POLLEN_MAX_ARG_STRINGS  1024
    static const char* _pollen_v3_args_pool[POLLEN_MAX_ARG_STRINGS];
    static int         _pollen_v3_args_pool_count;

    /* Load-time error trail. The AM walker bubbles a clear message up
     * to the caller without using exceptions ; we leave it accessible
     * to AM via Pollen.WorkflowLoadErrorMsg(). */
    static char _pollen_v3_load_err[512];
    static int  _pollen_v3_has_load_err;

    static int _pollen_v3_active;   /* 1 once a v3 workflow has been
                                      * committed ; flipped off only by
                                      * a v2 load or another v3 reload */
    /* Phase 3d — counter bumped each time the listener thread routes
     * a message to the v3 dispatcher. Exposed via
     * Pollen.WorkflowV3DispatchCount so the integration test can
     * verify the listener → dispatcher fork without needing to
     * observe per-dispatch state (which is otherwise ephemeral). */
    static _Atomic int _pollen_v3_dispatch_count = 0;

    static void _pollen_v3_set_err(const char* msg) {
        if (_pollen_v3_has_load_err) return;   /* keep first error */
        strncpy(_pollen_v3_load_err, msg, sizeof(_pollen_v3_load_err) - 1);
        _pollen_v3_load_err[sizeof(_pollen_v3_load_err) - 1] = 0;
        _pollen_v3_has_load_err = 1;
    }

    /* GC-backed strdup so AM-supplied `code_string`s survive past the
     * setter call (the AM side may reuse its own buffers). */
    static const char* _pollen_v3_dup(const char* s) {
        if (!s) return 0;
        size_t n = strlen(s);
        char* out = (char*) GC_MALLOC_ATOMIC(n + 1);
        if (!out) return 0;
        memcpy(out, s, n);
        out[n] = 0;
        return out;
    }

    static void _pollen_v3_reload_begin(void) {
        pthread_mutex_lock(&_pollen_wf_mutex);
        _pollen_v3_ast_count    = 0;
        _pollen_v3_entry_count  = 0;
        _pollen_v3_anchor_count = 0;
        _pollen_v3_action_count = 0;
        _pollen_v3_args_pool_count = 0;
        _pollen_v3_load_err[0]  = 0;
        _pollen_v3_has_load_err = 0;
    }

    /* Allocate a fresh node, return its index. -1 on overflow. */
    static int _pollen_v3_alloc_node(int kind) {
        if (_pollen_v3_ast_count >= POLLEN_MAX_AST_NODES) {
            _pollen_v3_set_err("AST node pool exhausted (POLLEN_MAX_AST_NODES=4096)");
            return -1;
        }
        int i = _pollen_v3_ast_count++;
        PollenAstNode* n = &_pollen_v3_ast[i];
        memset(n, 0, sizeof(*n));
        n->kind         = (uint8_t) kind;
        n->child0       = -1;
        n->child1       = -1;
        n->next_sibling = -1;
        n->args_first   = -1;
        n->args_count   = 0;
        n->goto_kind    = POLLEN_GOTO_UNRESOLVED;
        n->goto_idx     = -1;
        return i;
    }

    static int _pollen_v3_node_set_name(int idx, const char* name) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].name = _pollen_v3_dup(name);
        return 0;
    }
    static int _pollen_v3_node_set_expr(int idx, const char* e) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].expr = _pollen_v3_dup(e);
        return 0;
    }
