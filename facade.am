        @c { Amalgame_Pollen_Pollen_WhileAddExit_c(host, (int64_t) port); }
    }

    public static int WorkflowVersion() {
        var v: int = 0
        @c { v = Amalgame_Pollen_Pollen_WorkflowVersion_c(); }
        return v
    }

    public static string WorkflowActiveRole() {
