    /* === Entries ============================================ */

    static int _pollen_v3_add_entry(const char* name, const char* on_topic) {
        if (_pollen_v3_entry_count >= POLLEN_MAX_ENTRIES) {
            _pollen_v3_set_err("entries[] full (POLLEN_MAX_ENTRIES=256)");
            return -1;
        }
        int i = _pollen_v3_entry_count++;
        PollenEntry* e = &_pollen_v3_entries[i];
        memset(e, 0, sizeof(*e));
        e->name     = _pollen_v3_dup(name);
        e->on_topic = (on_topic && on_topic[0]) ? _pollen_v3_dup(on_topic) : 0;
