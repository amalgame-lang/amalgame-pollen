    /* === Lookups ============================================ */

    static int _pollen_v3_lookup_entry(const char* name) {
        if (!name) return -1;
        for (int i = 0; i < _pollen_v3_entry_count; i++) {
            if (_pollen_v3_entries[i].name &&
                strcmp(_pollen_v3_entries[i].name, name) == 0) return i;
        }
        return -1;
    }
    static int _pollen_v3_lookup_anchor(const char* name) {
        if (!name) return -1;
        for (int i = 0; i < _pollen_v3_anchor_count; i++) {
            if (_pollen_v3_anchors[i].name &&
                strcmp(_pollen_v3_anchors[i].name, name) == 0) return i;
        }
        return -1;
    }
    static int _pollen_v3_lookup_action(const char* name) {
        if (!name) return -1;
        for (int i = 0; i < _pollen_v3_action_count; i++) {
            if (_pollen_v3_actions[i].name &&
                strcmp(_pollen_v3_actions[i].name, name) == 0) return i;
        }
        return -1;
    }

    /* === Goto resolver ====================================== */
    /*
     * Walks the AST pool ; for each POLLEN_AST_GOTO node, looks the
     * target name up against entries first, then anchors. Unresolved
     * targets stay flagged so the dispatcher can fail-fast at run
     * time (the validator already rejects them at load time, but the
     * runtime double-check is cheap insurance).
     */
    static int _pollen_v3_resolve_gotos(void) {
        int unresolved = 0;
        for (int i = 0; i < _pollen_v3_ast_count; i++) {
            PollenAstNode* n = &_pollen_v3_ast[i];
            if (n->kind != POLLEN_AST_GOTO) continue;
            int eidx = _pollen_v3_lookup_entry(n->name);
            if (eidx >= 0) {
                n->goto_kind = POLLEN_GOTO_ENTRY;
                n->goto_idx  = eidx;
                continue;
            }
            int aidx = _pollen_v3_lookup_anchor(n->name);
            if (aidx >= 0) {
                n->goto_kind = POLLEN_GOTO_ANCHOR;
                n->goto_idx  = aidx;
                continue;
            }
            unresolved++;
        }
        if (unresolved > 0) {
            char buf[128];
            snprintf(buf, sizeof(buf),
                     "goto resolver: %d unresolved target(s)", unresolved);
            _pollen_v3_set_err(buf);
        }
        return unresolved;
    }

    static int _pollen_v3_reload_commit(void) {
        int unres = _pollen_v3_resolve_gotos();
        if (_pollen_v3_has_load_err) {
            pthread_mutex_unlock(&_pollen_wf_mutex);
            return -1;
        }
        _pollen_v3_active = 1;
        pthread_mutex_unlock(&_pollen_wf_mutex);
        (void) unres;
        return 0;
    }

