        if (empty) empty[0] = 0;
        if (!host || !topicUuid || !dataJson) return (code_string) empty;
        char mid[37];
        int ok = _pollen_publish_sync((const char*) host, (int) port,
                                        (const char*) topicUuid,
                                        topicVersion,
