        @c { Amalgame_Pollen_Pollen_WorkflowAddNext_c(host, (int64_t) port); }
    }

    public static void WorkflowSetEmitTopic(topic: string) {
        @c { Amalgame_Pollen_Pollen_WorkflowSetEmitTopic_c(topic); }
    }

    // M2.3c.2 — conditional routing. Sandwiched between
    // WorkflowReloadBegin / WorkflowReloadCommit alongside the
    // call/fan_out setters. CondBranchOpen starts a new branch ;
    // subsequent CondBranchAddTarget calls populate its targets
    // until the next CondBranchOpen (or ReloadCommit). condJson
    // accepts the same grammar as Pollen.EvalCond (and / or / not /
    // in / not_in + leaf ops). Empty cond_json = else branch.
    public static void CondBranchOpen(condJson: string) {
        @c { Amalgame_Pollen_Pollen_CondBranchOpen_c(condJson); }
    }

    public static void CondBranchAddTarget(host: string, port: int) {
        @c { Amalgame_Pollen_Pollen_CondBranchAddTarget_c(host, (int64_t) port); }
    }

    // M2.3c.2 — set state.X ops. Each Add registers (path, valueExpr).
    // At message time the dispatch evaluates valueExpr against the
    // envelope (same evaluator as Pollen.EvalExpr) and writes the
    // resulting literal under sharedDir/state/<rootMid>.json before
    // the cond / forward pass.
    public static void SetOpAdd(path: string, valueExprJson: string) {
        @c { Amalgame_Pollen_Pollen_SetOpAdd_c(path, valueExprJson); }
    }

    // M2.3c.2b — for loop. ForSetup arms the route ; subsequent
    // ForAddTarget calls populate the downstream peer set ;
    // ForAddItem calls populate the iteration items list.
    // Dispatch fans out n_items × n_targets messages, writing
    // state.<itemVar> = items[i] before each iter's forward.
    public static void ForSetup(itemVar: string) {
        @c { Amalgame_Pollen_Pollen_ForSetup_c(itemVar); }
    }

    public static void ForAddTarget(host: string, port: int) {
        @c { Amalgame_Pollen_Pollen_ForAddTarget_c(host, (int64_t) port); }
    }

    public static void ForAddItem(itemLit: string) {
        @c { Amalgame_Pollen_Pollen_ForAddItem_c(itemLit); }
    }

    // M2.3c.2b — while loop. Self-loop bounded by maxIter, with
    // a user-supplied condJson (same grammar as Pollen.EvalCond)
    // evaluated each iteration. The iterKey is the state.X path
    // amc auto-bumps each loop iteration (defaults to "_wf_iter"
