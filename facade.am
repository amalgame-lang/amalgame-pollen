    /* Append a goto-arg expression to the flat pool, return its idx. */
    static int _pollen_v3_push_arg(const char* expr) {
        if (_pollen_v3_args_pool_count >= POLLEN_MAX_ARG_STRINGS) {
            _pollen_v3_set_err("goto.args pool exhausted (POLLEN_MAX_ARG_STRINGS=1024)");
            return -1;
