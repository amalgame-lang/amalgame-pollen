import Amalgame.Collections
import Amalgame.String

@c {
    #include <stdio.h>
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    #include <unistd.h>
    #include <fcntl.h>
    #include <sys/stat.h>
    #include <sys/types.h>
    #include <sys/socket.h>
    #include <sys/random.h>
    #include <netinet/in.h>
    #include <arpa/inet.h>
    #include <time.h>
    #include <sys/time.h>
    #include <errno.h>
    #include <gc.h>

    /* Singleton-per-process engine state. v0.1 carries flags only ;
     * M2-M3 will copy in the full runtime from pollen.am. */
    static int _pollen_pkg_loaded = 0;
    static char _pollen_pkg_role[64] = "";
    /* M2.4b — self identity for the executions/ recorder. Populated
     * by WorkflowSetSelf alongside the role. */
    static char _pollen_self_host[64] = "127.0.0.1";
    static int  _pollen_self_port = 0;
    /* M2.4c / Phase 6.1 — capability advertisement identity. */
    static char _pollen_cap_instance[37] = "";
    static char _pollen_cap_label[64] = "";
    static int  _pollen_cap_active = 0;
    /* Phase 6.2 — load metrics reported in the capability file.
     * inFlight : messages currently being dispatched (bumped around
     * the forward window). msgsHandled : cumulative consumed count.
     * _Atomic so the writer thread reads consistent values without
     * taking the wf mutex. */
    #include <stdatomic.h>
    static _Atomic long _pollen_inflight = 0;
    static _Atomic long _pollen_msgs_handled = 0;
    /* v0.1.17 — Mosaic bridge hooks. AM closures (AmalgameClosure*
     * from _runtime.h) invoked from the listener worker. on_message
     * transforms a consumed message's data before forward (return ""
     * → drop) ; on_complete fires when a consumed message terminates
     * at this node (leaf : no nexts/cond/for/while). Both run on the
     * worker thread under _pollen_wf_mutex, so they must NOT call
     * Pollen.Forward (would re-lock + deadlock) — return data / use
     * Publish instead. Forward is for OTHER threads (a Mosaic HTTP
     * handler re-emitting out-of-band). Set once at wiring time, read
     * lock-free on the hot path (plain pointer load is atomic enough
     * for set-once-then-read). AmalgameClosure is defined in
     * _runtime.h (already included by the generated TU). */
    static AmalgameClosure* _pollen_on_message  = 0;
    static AmalgameClosure* _pollen_on_complete = 0;
    /* shared_dir uses the runtime-canonical name (no _pkg_ prefix) so
     * the M2.x state_persist code below ports verbatim from
     * the pollen runtime with zero diff. file-scope static — no link
     * collision with the legacy binary. */
    static char _pollen_shared_dir[512] = "";

    /* === M2.3c.1 — workflow runtime state ====================
     *
     * Storage populated by AM-side LoadWorkflow (or any consumer
     * that calls the WorkflowAddConsume / AddNext / SetEmitTopic
     * setters between WorkflowReloadBegin and WorkflowReloadCommit).
     * Hot path readers (listener_worker dispatch) take the same
     * mutex for the snapshot + forward window. */
    #include <pthread.h>

    /* bdwgc thread registration — worker threads that invoke AM
     * closures (OnMessage / OnComplete) must be GC-registered so
     * their stacks stay scannable, exactly like amalgame-threading.
     * Declared extern ; resolved from the runtime's libgc (built
     * with thread support). */
    extern int GC_pthread_create(pthread_t*, const pthread_attr_t*,
                                  void* (*)(void*), void*);
    extern int GC_pthread_detach(pthread_t);

    #define POLLEN_MAX_CONSUMES 32
    #define POLLEN_MAX_NEXTS    32
    #define POLLEN_TOPIC_MAX    128
    #define POLLEN_HOST_MAX     64

    static int  _pollen_wf_active = 0;
    static int  _pollen_wf_n_consumes = 0;
    static int  _pollen_wf_n_nexts = 0;
    static char _pollen_wf_consumes[POLLEN_MAX_CONSUMES][POLLEN_TOPIC_MAX];
    static char _pollen_wf_next_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
    static int  _pollen_wf_next_port[POLLEN_MAX_NEXTS];
    static char _pollen_wf_emit_topic[POLLEN_TOPIC_MAX] = "";
    static pthread_mutex_t _pollen_wf_mutex = PTHREAD_MUTEX_INITIALIZER;
    static int  _pollen_wf_version = 0;

    /* M2.3c.2 — conditional routing storage. Same shape as the
     * workflow-tree Phase 5.2 / 5.4.1 design : a top-level list
     * of branches, each holding a raw cond_expr JSON + its target
     * list. cond_forward picks the first branch whose cond_eval
     * passes (matched evaluator from M2.2 — see _pollen_cond_eval_expr). */
    #define POLLEN_COND_MAX_BRANCHES 8
    #define POLLEN_COND_EXPR_MAX     1024

    typedef struct {
        char cond_expr[POLLEN_COND_EXPR_MAX];
        char targets_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  targets_port[POLLEN_MAX_NEXTS];
        int  n_targets;
        /* v0.1.20 — v2 routing : if set, this branch forwards by topic
         * (registry-resolved via power-of-two) instead of the static
         * targets above. The branch rebuilds the envelope with this
         * topic. Empty → v1 behaviour (static targets + global emit). */
        char topic[POLLEN_TOPIC_MAX];
    } pollen_cond_branch_t;

    static int                  _pollen_cond_active = 0;
    static int                  _pollen_cond_n_branches = 0;
    static int                  _pollen_cond_current = -1;
    static pollen_cond_branch_t _pollen_cond_branches[POLLEN_COND_MAX_BRANCHES];

    /* M2.3c.2 — set-op storage (Phase 5.3 `set state.X` ops).
     * AM-side loader registers pairs (path, value_expr) ; the
     * apply pass at message time walks the list, eval_expr each
     * value against the envelope, persists via _pollen_state_set. */
    #define POLLEN_SET_OPS_MAX 8

    /* POLLEN_COND_VAR_MAX is also referenced by the cond-eval block
     * later in this TU ; both must agree on the size. The eval-side
     * definition is guarded with #ifndef so it's a no-op. */
    #define POLLEN_COND_VAR_MAX  64

    typedef struct {
        char path[POLLEN_COND_VAR_MAX];
        char value_expr[1024];
    } pollen_set_op_t;

    static int             _pollen_n_set_ops = 0;
    static pollen_set_op_t _pollen_set_ops[POLLEN_SET_OPS_MAX];

    /* M2.3c.2b — for / while route storage (Phase 5.4). Mirrors
     * the workflow-tree runtime : a for loop is a finite item list
     * that gets fanned out to a target set ; a while loop is a
     * self-loop bounded by maxIter + a JSON cond evaluated each
     * iteration. Both maintain iter / item state via the same
     * state.X persist machinery as the set ops. */
    #define POLLEN_FOR_MAX_ITEMS 32
    #define POLLEN_FOR_ITEM_MAX  256

    typedef struct {
        char items[POLLEN_FOR_MAX_ITEMS][POLLEN_FOR_ITEM_MAX];
        int  n_items;
        char item_var[POLLEN_COND_VAR_MAX];
        char target_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  target_port[POLLEN_MAX_NEXTS];
        int  n_targets;
        /* v0.1.21 — v2 routing : if set, each iteration rebuilds with
         * this topic and forwards to a registry-resolved provider
         * (power-of-two), instead of the static targets above. */
        char topic[POLLEN_TOPIC_MAX];
    } pollen_for_route_t;

    static int                _pollen_for_active = 0;
    static pollen_for_route_t _pollen_for_route;

    typedef struct {
        char cond_expr[POLLEN_COND_EXPR_MAX];
        char iter_state_key[POLLEN_COND_VAR_MAX];
        int  max_iter;
        char loop_host[POLLEN_HOST_MAX];
        int  loop_port;
        char exit_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  exit_port[POLLEN_MAX_NEXTS];
        int  n_exits;
        /* v0.1.22 — v2 routing : if set, on exit the envelope is
         * rebuilt with this topic and forwarded to a registry-
         * resolved provider (power-of-two) instead of the static
         * exit_host[]. */
        char exit_topic[POLLEN_TOPIC_MAX];
        /* v0.1.23 — explicit while.body : on CONTINUE, rebuild with
         * this topic and forward to a registry-resolved provider of
         * the body action. The body action processes one iteration
         * and forwards back to the controller (which then re-runs the
         * while logic). Empty → v1 fallback (loop_host:loop_port). */
        char body_topic[POLLEN_TOPIC_MAX];
    } pollen_while_route_t;

    static int                  _pollen_while_active = 0;
    static pollen_while_route_t _pollen_while_route;

    /* === Phase 6.2/6.3 — capability registry + load balancer ====
     *
     * The capability WRITER (Phase 6.1) advertises this node ; the
     * READER thread below scans the sharedDir capabilities dir every
     * 2s and rebuilds an in-memory registry of live providers (those
     * whose heartbeat is < POLLEN_REG_STALE_MS old). The LB resolver
     * maps an emit topic → the providers advertising it → a single
     * pick via power-of-two-choices (lower inFlight wins). Forwarding
     * uses it only when SetLoadBalance(true) is set, else the static
     * nexts are used verbatim (so single-instance demos are
     * unchanged). The registry has its own mutex — independent of the
     * wf mutex, so a forward (holding wf) can read it freely. */
    #define POLLEN_REG_MAX        128
    #define POLLEN_REG_ACTIONS_MAX 16
    #define POLLEN_REG_STALE_MS   15000

    typedef struct {
        char    host[POLLEN_HOST_MAX];
        int     port;
        char    actions[POLLEN_REG_ACTIONS_MAX][POLLEN_TOPIC_MAX];
        int     n_actions;
        long    inflight;
        int64_t heartbeat;
    } pollen_provider_t;

    static pollen_provider_t _pollen_reg[POLLEN_REG_MAX];
    static int               _pollen_reg_n = 0;
    static pthread_mutex_t   _pollen_reg_mutex = PTHREAD_MUTEX_INITIALIZER;
    static int               _pollen_reader_active = 0;
    static int               _pollen_lb_enabled = 0;

    static const char _pollen_pkg_unimpl_warning[] =
        "amalgame-pollen v0.1.0-dev : %s is a stub. "
        "M2-M3 migration from pollen.am in progress.\n";

    /* Forward declarations — order in this TU is one-shot @c so a
     * helper used before its definition needs hoisting. */
    static int64_t _pollen_now_ms_c(void);
    static void    _pollen_gen_uuid(char* buf);
    static void    _pollen_cond_clear(void);
    static void    _pollen_set_ops_clear(void);
    static void    _pollen_for_clear(void);
    static void    _pollen_while_clear(void);
    static void    _pollen_wf_forward_one(const char* host, int port,
                                            const char* envelope, size_t env_len);
    static size_t  _pollen_wf_rebuild_envelope(
                       const char* in, size_t in_len,
                       char* out, size_t out_cap,
                       const char* new_topic,
                       char* out_new_mid);
    static void    _pollen_for_forward(const char* env, size_t env_len,
                                         char* out_new_mid);
    static void    _pollen_while_forward(const char* env, size_t env_len,
                                          char* out_new_mid);
    /* v0.1.17 — swap the "data":<value> field of an envelope. */
    static size_t  _pollen_replace_data(const char* in, size_t in_len,
                                          const char* new_data,
                                          char* out, size_t out_cap);
    /* v0.1.18 — LB resolver : emit topic → live provider (power-of-two). */
    static int     _pollen_lb_pick(const char* topic, char* out_host,
                                     size_t host_cap, int* out_port);
    /* M2.4 — debug bridge. Returns 1 to proceed (envelope to
     * dispatch copied into out[0..*out_len)), 0 to drop the message
     * (operator hit Cancel, or the manager phone-home timed out). */
    static int     _pollen_debug_process(const char* in, size_t in_len,
                                           char* out, size_t out_cap,
                                           size_t* out_len);

    /* Portable substring search — memmem is glibc-only and _GNU_SOURCE
     * has to be defined before any system header which is hard to
     * guarantee from inside an amc @c block. Naive O(h × n) is fine
     * for our short needles scanning <8 KiB state files. */
    static const char* _pollen_find(const char* hay, size_t hlen,
                                     const char* needle, size_t nlen) {
        if (nlen == 0 || hlen < nlen) return NULL;
        const char* end = hay + hlen - nlen;
        for (const char* p = hay; p <= end; p++) {
            if (memcmp(p, needle, nlen) == 0) return p;
        }
        return NULL;
    }

    /* === Workflow lifecycle =================================== */
    static code_bool
    Amalgame_Pollen_Pollen_WorkflowLoad_c(code_string path, code_string nodeName,
                                            int64_t actualPort) {
        fprintf(stderr, _pollen_pkg_unimpl_warning, "WorkflowLoad");
        (void) path; (void) nodeName; (void) actualPort;
        return (code_bool) 0;
    }

    static void
    Amalgame_Pollen_Pollen_WorkflowSetSharedDir_c(code_string path) {
        if (!path) return;
        strncpy(_pollen_shared_dir, path,
                 sizeof(_pollen_shared_dir) - 1);
        _pollen_shared_dir[sizeof(_pollen_shared_dir) - 1] = 0;
        /* best-effort create — EEXIST ok ; sub-dirs (state/, executions/)
         * are created lazily by their respective writers. */
        mkdir(_pollen_shared_dir, 0755);
    }

    static void
    Amalgame_Pollen_Pollen_WorkflowSetSelf_c(code_string role, code_string host,
                                               int64_t port) {
        if (role) {
            strncpy(_pollen_pkg_role, role, sizeof(_pollen_pkg_role) - 1);
            _pollen_pkg_role[sizeof(_pollen_pkg_role) - 1] = 0;
        }
        if (host) {
            strncpy(_pollen_self_host, (const char*) host,
                     sizeof(_pollen_self_host) - 1);
            _pollen_self_host[sizeof(_pollen_self_host) - 1] = 0;
        }
        _pollen_self_port = (int) port;
    }

    /* M2.4b — write one execution step record under
     * <sharedDir>/executions/<mid>-<role>.json. Best-effort :
     * O_CREAT|O_EXCL skips duplicates, any fs error is ignored.
     * The manager's Live panel reads these + walks parentMessageId
     * backwards to reconstruct the chain. All string args are
     * length-delimited so callers can pass recv-buffer pointers. */
    static void _pollen_wf_record_step(const char* mid_out, size_t mid_out_len,
                                         const char* parent_mid, size_t parent_mid_len,
                                         const char* topic_in, size_t topic_in_len,
                                         const char* topic_out, int n_nexts,
                                         const char* dbg_session, size_t dbg_session_len) {
        if (!_pollen_shared_dir[0] || !mid_out || mid_out_len == 0) return;
        char path[1024];
        int pn = snprintf(path, sizeof(path), "%s/executions/%.*s-%s.json",
                          _pollen_shared_dir,
                          (int) mid_out_len, mid_out,
                          _pollen_pkg_role[0] ? _pollen_pkg_role : "node");
        if (pn <= 0 || pn >= (int) sizeof(path)) return;
        /* ensure the executions/ dir exists */
        char d[600];
        snprintf(d, sizeof(d), "%s/executions", _pollen_shared_dir);
        mkdir(d, 0755);
        int fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0644);
        if (fd < 0) return;
        char dbg_suffix[96] = "";
        if (dbg_session && dbg_session_len > 0 && dbg_session_len < 64) {
            snprintf(dbg_suffix, sizeof(dbg_suffix),
                ",\"debugSession\":\"%.*s\"",
                (int) dbg_session_len, dbg_session);
        }
        char buf[1400];
        int64_t now = _pollen_now_ms_c();
        int n;
        if (parent_mid && parent_mid_len > 0) {
            n = snprintf(buf, sizeof(buf),
                "{\"messageId\":\"%.*s\",\"parentMessageId\":\"%.*s\","
                 "\"role\":\"%s\",\"topicIn\":\"%.*s\",\"topicOut\":\"%s\","
                 "\"nextCount\":%d,\"node\":\"%s:%d\",\"timestamp\":%lld%s}\n",
                (int) mid_out_len, mid_out,
                (int) parent_mid_len, parent_mid,
                _pollen_pkg_role,
                (int) topic_in_len, topic_in ? topic_in : "",
                topic_out ? topic_out : "",
                n_nexts, _pollen_self_host, _pollen_self_port,
                (long long) now, dbg_suffix);
        } else {
            n = snprintf(buf, sizeof(buf),
                "{\"messageId\":\"%.*s\",\"parentMessageId\":null,"
                 "\"role\":\"%s\",\"topicIn\":\"%.*s\",\"topicOut\":\"%s\","
                 "\"nextCount\":%d,\"node\":\"%s:%d\",\"timestamp\":%lld%s}\n",
                (int) mid_out_len, mid_out,
                _pollen_pkg_role,
                (int) topic_in_len, topic_in ? topic_in : "",
                topic_out ? topic_out : "",
                n_nexts, _pollen_self_host, _pollen_self_port,
                (long long) now, dbg_suffix);
        }
        if (n > 0 && n < (int) sizeof(buf)) {
            ssize_t w = write(fd, buf, (size_t) n);
            (void) w;
        }
        close(fd);
    }

    /* === Phase 5.3 — per-execution state file =================
     *
     * Migrated verbatim from the pollen runtime v0.2.x (workflow-tree
     * Phase 5.3 commit 7854bef). Each `rootMessageId` gets a JSON
     * object stored under `<sharedDir>/state/<rootMid>.json`. Writes
     * go through tmp + rename for crash safety ; reads slurp the
     * whole file (capped at POLLEN_STATE_FILE_MAX). `state.X`
     * lookups in conditions read it back.
     */
    #define POLLEN_STATE_FILE_MAX 8192

    static int _pollen_state_filepath(const char* root_mid,
                                       char* out, size_t cap) {
        if (!_pollen_shared_dir[0] || !root_mid || !root_mid[0]) return 0;
        int n = snprintf(out, cap, "%s/state/%s.json",
                          _pollen_shared_dir, root_mid);
        return (n > 0 && n < (int) cap);
    }

    static void _pollen_state_dir_ensure(void) {
        if (!_pollen_shared_dir[0]) return;
        char d[600];
        snprintf(d, sizeof(d), "%s/state", _pollen_shared_dir);
        mkdir(d, 0755);
    }

    static int _pollen_state_read(const char* root_mid,
                                    char* buf, size_t cap) {
        char path[1024];
        if (!_pollen_state_filepath(root_mid, path, sizeof(path))) return -1;
        int fd = open(path, O_RDONLY);
        if (fd < 0) return -1;
        ssize_t n = read(fd, buf, cap - 1);
        close(fd);
        if (n <= 0) return -1;
        buf[n] = 0;
        return (int) n;
    }

    static int _pollen_state_write(const char* root_mid,
                                     const char* buf, size_t len) {
        char path[1024], tmp[1100];
        if (!_pollen_state_filepath(root_mid, path, sizeof(path))) return 0;
        _pollen_state_dir_ensure();
        snprintf(tmp, sizeof(tmp), "%s.tmp.%d", path, (int) getpid());
        int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (fd < 0) return 0;
        ssize_t w = write(fd, buf, len);
        close(fd);
        if (w != (ssize_t) len) { unlink(tmp); return 0; }
        if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
        return 1;
    }

    /* Locate the value extent for `"key":` inside a state buffer.
     * Returns 1 on success and writes the value start + length to
     * *out_v / *out_vlen. Strings, objects/arrays, and bare literals
     * (number/true/false/null) are all handled. */
    static int _pollen_state_find_value(const char* buf, int blen,
                                         const char* key,
                                         const char** out_v,
                                         size_t* out_vlen) {
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle), "\"%s\":", key);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return 0;
        const char* found = _pollen_find(buf, (size_t) blen,
                                          needle, (size_t) nlen);
        if (!found) return 0;
        const char* v = found + nlen;
        const char* v_end = v;
        if (*v == '"') {
            v_end = v + 1;
            while (v_end < buf + blen && *v_end != '"') {
                if (*v_end == '\\' && v_end + 1 < buf + blen) v_end++;
                v_end++;
            }
            if (v_end < buf + blen) v_end++;
        } else if (*v == '{' || *v == '[') {
            char open = *v; char close = (open == '{') ? '}' : ']';
            int depth = 0;
            v_end = v;
            while (v_end < buf + blen) {
                if (*v_end == open) depth++;
                else if (*v_end == close) {
                    depth--;
                    if (depth == 0) { v_end++; break; }
                }
                v_end++;
            }
        } else {
            while (v_end < buf + blen
                   && *v_end != ',' && *v_end != '}'
                   && *v_end != ' ' && *v_end != '\n'
                   && *v_end != '\r' && *v_end != '\t') v_end++;
        }
        *out_v = v;
        *out_vlen = (size_t)(v_end - v);
        return 1;
    }

    /* Mutate a single top-level key in the per-execution state file.
     * value_lit is a JSON literal (number, quoted string, true, false,
     * null). For now only top-level keys are supported — `state.X.Y`
     * is treated as a single key name with a literal dot in it,
     * which works but doesn't compose with cond eval's dotted
     * resolution. Phase 5.3.1 will handle nested set. */
    static int _pollen_state_set(const char* root_mid,
                                   const char* path,
                                   const char* json_literal) {
        const char* key = path;
        if (strncmp(key, "state.", 6) == 0) key += 6;
        if (!key[0]) return 0;

        char old_buf[POLLEN_STATE_FILE_MAX];
        int old_n = _pollen_state_read(root_mid, old_buf, sizeof(old_buf));

        char new_buf[POLLEN_STATE_FILE_MAX];
        int n = 0;

        if (old_n <= 0) {
            n = snprintf(new_buf, sizeof(new_buf),
                          "{\"%s\":%s}\n", key, json_literal);
        } else {
            const char* v = NULL;
            size_t vlen = 0;
            if (_pollen_state_find_value(old_buf, old_n, key, &v, &vlen)) {
                const char* v_end = v + vlen;
                int prefix_n = (int)(v - old_buf);
                int suffix_n = old_n - (int)(v_end - old_buf);
                n = snprintf(new_buf, sizeof(new_buf), "%.*s%s%.*s",
                              prefix_n, old_buf, json_literal,
                              suffix_n, v_end);
            } else {
                int close_at = -1;
                for (int i = old_n - 1; i >= 0; i--) {
                    if (old_buf[i] == '}') { close_at = i; break; }
                }
                if (close_at < 0) return 0;
                int has_fields = 0;
                for (int i = 0; i < close_at; i++) {
                    char c = old_buf[i];
                    if (c == ':') { has_fields = 1; break; }
                }
                const char* sep = has_fields ? "," : "";
                n = snprintf(new_buf, sizeof(new_buf),
                              "%.*s%s\"%s\":%s%.*s",
                              close_at, old_buf, sep, key, json_literal,
                              old_n - close_at, old_buf + close_at);
            }
        }

        if (n <= 0 || n >= (int) sizeof(new_buf)) return 0;
        return _pollen_state_write(root_mid, new_buf, (size_t) n);
    }

    /* Extract rootMessageId from a MESSAGE envelope. Returns 1 on
     * success. Used by the workflow dispatcher in M2.3 — exposed
     * here as part of the state_persist module since it's the
     * inverse of "which state file do I touch". */
    static int _pollen_extract_root_mid(const char* env, size_t env_len,
                                          char* out, size_t cap) {
        const char* k = _pollen_find(env, env_len,
                                       "\"rootMessageId\":\"", 17);
        if (!k) return 0;
        const char* v = k + 17;
        const char* q = memchr(v, '"', env_len - (size_t)(v - env));
        if (!q) return 0;
        size_t rlen = (size_t)(q - v);
        if (rlen == 0 || rlen >= cap) return 0;
        memcpy(out, v, rlen); out[rlen] = 0;
        return 1;
    }

    /* Public facade for state read by key path. Returns a GC-owned
     * string containing the raw JSON literal (number / quoted-string
     * / object / array / true / false / null). Returns "" if the
     * sharedDir isn't set, the state file doesn't exist, or the key
     * isn't present. */
    static code_string
    Amalgame_Pollen_Pollen_StateGet_c(code_string rootMid, code_string path) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!rootMid || !path) return (code_string) empty;
        const char* key = (const char*) path;
        if (strncmp(key, "state.", 6) == 0) key += 6;
        if (!key[0]) return (code_string) empty;

        char buf[POLLEN_STATE_FILE_MAX];
        int n = _pollen_state_read((const char*) rootMid, buf, sizeof(buf));
        if (n <= 0) return (code_string) empty;

        const char* v = NULL;
        size_t vlen = 0;
        if (!_pollen_state_find_value(buf, n, key, &v, &vlen)) {
            return (code_string) empty;
        }
        char* out = (char*) GC_MALLOC_ATOMIC(vlen + 1);
        if (!out) return (code_string) empty;
        memcpy(out, v, vlen);
        out[vlen] = 0;
        return (code_string) out;
    }

    static code_bool
    Amalgame_Pollen_Pollen_StateSet_c(code_string rootMid, code_string path,
                                       code_string jsonLiteral) {
        if (!rootMid || !path || !jsonLiteral) return (code_bool) 0;
        int ok = _pollen_state_set((const char*) rootMid,
                                     (const char*) path,
                                     (const char*) jsonLiteral);
        return (code_bool) (ok ? 1 : 0);
    }

    /* === M2.2 — expr / cond evaluator (workflow-tree Phase 5.2-6.0a)
     *
     * Migrated verbatim from the pollen runtime. Two evaluators :
     *
     *   _pollen_eval_expr      — set.value walker for arithmetic
     *                            ({const, var, op:+|-|*|/}). Numeric
     *                            results bubble as double, strings
     *                            pass through ; arithmetic on strings
     *                            returns 0.
     *
     *   _pollen_cond_eval_expr — recursive cond walker for `if` :
     *                            leaf (==, !=, <, >, <=, >=),
     *                            composite (and/or/not),
     *                            membership (in / not_in).
     *
     * Both walk raw JSON via `_pollen_json_field` + `_pollen_find` ;
     * `var` paths resolve through `_pollen_resolve_path` against
     * either the envelope (data.X) or the per-execution state file
     * (state.X). 1 KiB expr budget is enough for realistic
     * conditions ; deeper nests can be lifted in v0.2.
     */
    /* POLLEN_COND_VAR_MAX already defined in the M2.3c.2 workflow
     * storage block at the top of this TU. Re-declare for symmetry
     * with the source — guarded so we don't redefine. */
    #ifndef POLLEN_COND_VAR_MAX
    #define POLLEN_COND_VAR_MAX  64
    #endif
    #define POLLEN_COND_STR_MAX  128

    /* op codes used by _pollen_cond_eval_leaf — must stay stable, the
     * dispatcher M2.3 will populate branches with these. */
    #define POLLEN_COND_NONE 0
    #define POLLEN_COND_EQ   1
    #define POLLEN_COND_NE   2
    #define POLLEN_COND_LT   3
    #define POLLEN_COND_GT   4
    #define POLLEN_COND_LE   5
    #define POLLEN_COND_GE   6

    /* Walk a dotted path through a JSON range. Brace + string aware. */
    static int _pollen_resolve_path(const char* env, size_t env_len,
                                     const char* path,
                                     const char** out_val, size_t* out_len) {
        const char* range_lo = env;
        const char* range_hi = env + env_len;
        const char* p = path;
        for (;;) {
            const char* dot = strchr(p, '.');
            char seg[POLLEN_COND_VAR_MAX];
            size_t seglen = dot ? (size_t)(dot - p) : strlen(p);
            if (seglen == 0 || seglen + 4 >= sizeof(seg)) return 0;
            seg[0] = '"';
            memcpy(seg + 1, p, seglen);
            seg[1 + seglen] = '"';
            seg[2 + seglen] = ':';
            int needle_len = (int)(seglen + 3);

            const char* k = _pollen_find(range_lo,
                                          (size_t)(range_hi - range_lo),
                                          seg, (size_t) needle_len);
            if (!k) return 0;
            const char* v = k + needle_len;
            while (v < range_hi && (*v == ' ' || *v == '\t')) v++;
            if (v >= range_hi) return 0;

            int is_last = (dot == NULL);
            if (!is_last) {
                if (*v != '{') return 0;
                int depth = 1;
                const char* w = v + 1;
                int in_str = 0;
                while (w < range_hi && depth > 0) {
                    char c = *w;
                    if (in_str) {
                        if (c == '\\' && w + 1 < range_hi) { w += 2; continue; }
                        if (c == '"') in_str = 0;
                    } else {
                        if (c == '"') in_str = 1;
                        else if (c == '{') depth++;
                        else if (c == '}') depth--;
                    }
                    w++;
                }
                if (depth != 0) return 0;
                range_lo = v + 1;
                range_hi = w - 1;
                p = dot + 1;
                continue;
            }

            if (*v == '"') {
                const char* q = v + 1;
                while (q < range_hi) {
                    if (*q == '\\' && q + 1 < range_hi) { q += 2; continue; }
                    if (*q == '"') break;
                    q++;
                }
                if (q >= range_hi) return 0;
                *out_val = v;
                *out_len = (size_t)(q - v) + 1;
                return 1;
            }
            const char* q = v;
            while (q < range_hi
                   && *q != ',' && *q != '}' && *q != ']'
                   && *q != ' ' && *q != '\t' && *q != '\n' && *q != '\r') {
                q++;
            }
            *out_val = v;
            *out_len = (size_t)(q - v);
            return 1;
        }
    }

    /* Locate "key":<value> inside a JSON object, returning the raw
     * value extent. Brace + bracket + string aware. */
    static int _pollen_json_field(const char* buf, size_t len,
                                    const char* key, int klen,
                                    const char** out_v, size_t* out_vlen) {
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle), "\"%.*s\":", klen, key);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return 0;
        const char* k = _pollen_find(buf, len, needle, (size_t) nlen);
        if (!k) return 0;
        const char* v = k + nlen;
        while (v < buf + len && (*v == ' ' || *v == '\t')) v++;
        if (v >= buf + len) return 0;
        const char* e = v;
        if (*v == '"') {
            e = v + 1;
            while (e < buf + len) {
                if (*e == '\\' && e + 1 < buf + len) { e += 2; continue; }
                if (*e == '"') { e++; break; }
                e++;
            }
        } else if (*v == '{' || *v == '[') {
            char open = *v; char close = (open == '{') ? '}' : ']';
            int depth = 0;
            int in_str = 0;
            e = v;
            while (e < buf + len) {
                char c = *e;
                if (in_str) {
                    if (c == '\\' && e + 1 < buf + len) { e += 2; continue; }
                    if (c == '"') in_str = 0;
                } else {
                    if (c == '"') in_str = 1;
                    else if (c == open) depth++;
                    else if (c == close) {
                        depth--;
                        if (depth == 0) { e++; break; }
                    }
                }
                e++;
            }
        } else {
            while (e < buf + len && *e != ',' && *e != '}' && *e != ']'
                   && *e != ' ' && *e != '\n' && *e != '\r' && *e != '\t') e++;
        }
        *out_v = v;
        *out_vlen = (size_t)(e - v);
        return 1;
    }

    /* First key of a JSON object — disambiguates the dispatch. */
    static int _pollen_expr_outer_key(const char* expr, size_t expr_len,
                                        char* out_key, size_t cap) {
        const char* e = expr;
        const char* end = expr + expr_len;
        while (e < end && (*e == ' ' || *e == '\t' || *e == '\n' || *e == '\r')) e++;
        if (e >= end || *e != '{') return 0;
        e++;
        while (e < end && (*e == ' ' || *e == '\t' || *e == '\n' || *e == '\r')) e++;
        if (e >= end || *e != '"') return 0;
        e++;
        const char* k0 = e;
        while (e < end && *e != '"') {
            if (*e == '\\' && e + 1 < end) { e += 2; continue; }
            e++;
        }
        if (e >= end) return 0;
        size_t klen = (size_t)(e - k0);
        if (klen == 0 || klen >= cap) return 0;
        memcpy(out_key, k0, klen);
        out_key[klen] = 0;
        return 1;
    }

    typedef struct {
        int    is_num;
        double num;
        char   str[128];
    } _pollen_expr_val_t;

    static int _pollen_eval_expr(const char* env, size_t env_len,
                                   const char* expr, size_t expr_len,
                                   _pollen_expr_val_t* out) {
        out->is_num = 0;
        out->num = 0;
        out->str[0] = 0;
        const char* v; size_t vlen;

        char outer_key[16];
        if (!_pollen_expr_outer_key(expr, expr_len, outer_key, sizeof(outer_key))) {
            return 0;
        }

        if (strcmp(outer_key, "const") == 0
            && _pollen_json_field(expr, expr_len, "const", 5, &v, &vlen)) {
            if (vlen == 0) return 0;
            if (*v == '"') {
                size_t slen = vlen >= 2 ? vlen - 2 : 0;
                if (slen >= sizeof(out->str)) slen = sizeof(out->str) - 1;
                memcpy(out->str, v + 1, slen);
                out->str[slen] = 0;
                out->is_num = 0;
            } else {
                char tmp[64];
                size_t cn = vlen < sizeof(tmp) - 1 ? vlen : sizeof(tmp) - 1;
                memcpy(tmp, v, cn); tmp[cn] = 0;
                out->num = atof(tmp);
                out->is_num = 1;
            }
            return 1;
        }

        if (strcmp(outer_key, "var") == 0
            && _pollen_json_field(expr, expr_len, "var", 3, &v, &vlen)) {
            if (vlen < 2 || *v != '"') return 0;
            char path[POLLEN_COND_VAR_MAX];
            size_t plen = vlen - 2;
            if (plen >= sizeof(path)) plen = sizeof(path) - 1;
            memcpy(path, v + 1, plen); path[plen] = 0;

            const char* lookup_buf = env;
            size_t lookup_len = env_len;
            const char* lookup_path = path;
            char state_buf[POLLEN_STATE_FILE_MAX];
            if (strncmp(path, "state.", 6) == 0) {
                char root[64];
                if (!env || !_pollen_extract_root_mid(env, env_len,
                                                        root, sizeof(root))) {
                    out->is_num = 1; out->num = 0;
                    return 1;
                }
                int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
                if (sn <= 0) {
                    out->is_num = 1; out->num = 0;
                    return 1;
                }
                lookup_buf = state_buf;
                lookup_len = (size_t) sn;
                lookup_path = path + 6;
            }
            const char* vp; size_t vl;
            if (!_pollen_resolve_path(lookup_buf, lookup_len,
                                        lookup_path, &vp, &vl)) {
                out->is_num = 1; out->num = 0;
                return 1;
            }
            if (*vp == '"') {
                size_t slen = vl >= 2 ? vl - 2 : 0;
                if (slen >= sizeof(out->str)) slen = sizeof(out->str) - 1;
                memcpy(out->str, vp + 1, slen); out->str[slen] = 0;
                out->is_num = 0;
            } else {
                char tmp[64];
                size_t cn = vl < sizeof(tmp) - 1 ? vl : sizeof(tmp) - 1;
                memcpy(tmp, vp, cn); tmp[cn] = 0;
                out->num = atof(tmp);
                out->is_num = 1;
            }
            return 1;
        }

        if (strcmp(outer_key, "op") == 0
            && _pollen_json_field(expr, expr_len, "op", 2, &v, &vlen)) {
            if (vlen < 2 || *v != '"') return 0;
            char op[16];
            size_t olen = vlen - 2;
            if (olen >= sizeof(op)) return 0;
            memcpy(op, v + 1, olen); op[olen] = 0;

            const char* lv; size_t llen;
            const char* rv; size_t rlen;
            if (!_pollen_json_field(expr, expr_len, "left", 4,
                                      &lv, &llen)) return 0;
            if (!_pollen_json_field(expr, expr_len, "right", 5,
                                      &rv, &rlen)) return 0;
            _pollen_expr_val_t lvv, rvv;
            if (!_pollen_eval_expr(env, env_len, lv, llen, &lvv)) return 0;
            if (!_pollen_eval_expr(env, env_len, rv, rlen, &rvv)) return 0;
            if (!lvv.is_num || !rvv.is_num) return 0;
            out->is_num = 1;
            if      (strcmp(op, "+") == 0) out->num = lvv.num + rvv.num;
            else if (strcmp(op, "-") == 0) out->num = lvv.num - rvv.num;
            else if (strcmp(op, "*") == 0) out->num = lvv.num * rvv.num;
            else if (strcmp(op, "/") == 0) out->num = (rvv.num == 0) ? 0 : lvv.num / rvv.num;
            else return 0;
            return 1;
        }

        return 0;
    }

    static int _pollen_expr_val_to_literal(_pollen_expr_val_t* v,
                                             char* out, size_t cap) {
        if (v->is_num) {
            double rounded = (double)(long long) v->num;
            if (rounded == v->num
                && v->num >= -9.2e18 && v->num <= 9.2e18) {
                return snprintf(out, cap, "%lld", (long long) v->num);
            }
            return snprintf(out, cap, "%g", v->num);
        }
        return snprintf(out, cap, "\"%s\"", v->str);
    }

    /* Leaf comparison — resolves a var path, parses value extent,
     * applies op. Shared between the leaf-op cond walker and the
     * composite walker. */
    static int _pollen_cond_eval_leaf(const char* env, size_t env_len,
                                        const char* var_path,
                                        int op_code,
                                        int rhs_is_num,
                                        double rhs_num,
                                        const char* rhs_str) {
        if (op_code == POLLEN_COND_NONE) return 1;
        const char* lookup_buf = env;
        size_t lookup_len = env_len;
        const char* lookup_path = var_path;
        char state_buf[POLLEN_STATE_FILE_MAX];
        if (strncmp(var_path, "state.", 6) == 0) {
            char root[64];
            if (!_pollen_extract_root_mid(env, env_len,
                                            root, sizeof(root))) return 0;
            int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
            if (sn <= 0) return 0;
            lookup_buf = state_buf;
            lookup_len = (size_t) sn;
            lookup_path = var_path + 6;
        }
        const char* val_ptr = NULL;
        size_t val_len = 0;
        if (!_pollen_resolve_path(lookup_buf, lookup_len, lookup_path,
                                    &val_ptr, &val_len)) return 0;
        const char* v = val_ptr;
        const char* v_end = val_ptr + val_len;
        if (v >= v_end) return 0;
        double v_num = 0; int v_is_num = 0;
        char v_str[128] = "";
        if (*v == '"') {
            const char* q = v_end - 1;
            if (q <= v) return 0;
            size_t slen = (size_t)(q - v - 1);
            if (slen >= sizeof(v_str)) slen = sizeof(v_str) - 1;
            memcpy(v_str, v + 1, slen);
            v_str[slen] = 0;
        } else if ((*v >= '0' && *v <= '9') || *v == '-' || *v == '+' || *v == '.') {
            char tmp[64];
            size_t cn = val_len < sizeof(tmp) - 1 ? val_len : sizeof(tmp) - 1;
            memcpy(tmp, v, cn); tmp[cn] = 0;
            v_num = atof(tmp);
            v_is_num = 1;
        } else if (val_len == 4 && memcmp(v, "true", 4) == 0) {
            strcpy(v_str, "true");
        } else if (val_len == 5 && memcmp(v, "false", 5) == 0) {
            strcpy(v_str, "false");
        } else if (val_len == 4 && memcmp(v, "null", 4) == 0) {
            strcpy(v_str, "null");
        } else {
            return 0;
        }
        if (rhs_is_num && v_is_num) {
            double d = v_num - rhs_num;
            switch (op_code) {
                case POLLEN_COND_EQ: return d == 0;
                case POLLEN_COND_NE: return d != 0;
                case POLLEN_COND_LT: return d <  0;
                case POLLEN_COND_GT: return d >  0;
                case POLLEN_COND_LE: return d <= 0;
                case POLLEN_COND_GE: return d >= 0;
            }
        } else if (!rhs_is_num) {
            int c = strcmp(v_str, rhs_str);
            switch (op_code) {
                case POLLEN_COND_EQ: return c == 0;
                case POLLEN_COND_NE: return c != 0;
                case POLLEN_COND_LT: return c <  0;
                case POLLEN_COND_GT: return c >  0;
                case POLLEN_COND_LE: return c <= 0;
                case POLLEN_COND_GE: return c >= 0;
            }
        }
        return 0;
    }

    /* Recursive cond eval over raw JSON. Empty expr → true (else
     * branch). Composite forms : op:and|or|not, op:in|not_in. */
    static int _pollen_cond_eval_expr(const char* env, size_t env_len,
                                        const char* expr, size_t expr_len) {
        if (expr_len == 0) return 1;
        char outer_key[16];
        if (!_pollen_expr_outer_key(expr, expr_len,
                                      outer_key, sizeof(outer_key))) return 0;
        if (strcmp(outer_key, "op") != 0) return 0;

        const char* opv; size_t op_len;
        if (!_pollen_json_field(expr, expr_len, "op", 2, &opv, &op_len)) return 0;
        if (op_len < 2 || *opv != '"') return 0;
        char op[16];
        size_t olen = op_len - 2;
        if (olen >= sizeof(op)) return 0;
        memcpy(op, opv + 1, olen); op[olen] = 0;

        if (strcmp(op, "and") == 0 || strcmp(op, "or") == 0) {
            const char* args; size_t args_len;
            if (!_pollen_json_field(expr, expr_len, "args", 4,
                                      &args, &args_len)) return 0;
            if (args_len < 2 || *args != '[') return 0;
            int is_and = (op[0] == 'a');
            const char* p = args + 1;
            const char* end = args + args_len - 1;
            while (p < end) {
                while (p < end && (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n')) p++;
                if (p >= end) break;
                if (*p != '{') break;
                const char* sp = p;
                int depth = 1; int in_str = 0;
                p++;
                while (p < end && depth > 0) {
                    if (in_str) {
                        if (*p == '\\' && p + 1 < end) { p += 2; continue; }
                        if (*p == '"') in_str = 0;
                    } else {
                        if (*p == '"') in_str = 1;
                        else if (*p == '{') depth++;
                        else if (*p == '}') depth--;
                    }
                    p++;
                }
                int sub_pass = _pollen_cond_eval_expr(env, env_len,
                                                       sp, (size_t)(p - sp));
                if (is_and && !sub_pass) return 0;
                if (!is_and && sub_pass) return 1;
            }
            return is_and ? 1 : 0;
        }

        if (strcmp(op, "not") == 0) {
            const char* arg; size_t arg_len;
            if (!_pollen_json_field(expr, expr_len, "arg", 3,
                                      &arg, &arg_len)) return 0;
            return !_pollen_cond_eval_expr(env, env_len, arg, arg_len);
        }

        if (strcmp(op, "in") == 0 || strcmp(op, "not_in") == 0) {
            int negate = (op[0] == 'n');
            const char* varTok; size_t varTokLen;
            if (!_pollen_json_field(expr, expr_len, "var", 3,
                                      &varTok, &varTokLen)) return 0;
            if (varTokLen < 2 || *varTok != '"') return 0;
            char vpath[POLLEN_COND_VAR_MAX];
            size_t vplen = varTokLen - 2;
            if (vplen >= sizeof(vpath)) vplen = sizeof(vpath) - 1;
            memcpy(vpath, varTok + 1, vplen); vpath[vplen] = 0;

            const char* lookup_buf = env;
            size_t lookup_len = env_len;
            const char* lookup_path = vpath;
            char state_buf[POLLEN_STATE_FILE_MAX];
            if (strncmp(vpath, "state.", 6) == 0) {
                char root[64];
                if (!_pollen_extract_root_mid(env, env_len,
                                                root, sizeof(root))) return 0;
                int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
                if (sn <= 0) return 0;
                lookup_buf = state_buf;
                lookup_len = (size_t) sn;
                lookup_path = vpath + 6;
            }
            const char* val_ptr; size_t val_len;
            if (!_pollen_resolve_path(lookup_buf, lookup_len,
                                        lookup_path, &val_ptr, &val_len)) {
                return negate ? 1 : 0;
            }

            char v_str[128]; v_str[0] = 0;
            if (val_len > 0 && *val_ptr == '"') {
                size_t slen = val_len >= 2 ? val_len - 2 : 0;
                if (slen >= sizeof(v_str)) slen = sizeof(v_str) - 1;
                memcpy(v_str, val_ptr + 1, slen);
                v_str[slen] = 0;
            } else {
                size_t cn = val_len < sizeof(v_str) - 1 ? val_len : sizeof(v_str) - 1;
                memcpy(v_str, val_ptr, cn); v_str[cn] = 0;
            }

            const char* values; size_t values_len;
            if (!_pollen_json_field(expr, expr_len, "values", 6,
                                      &values, &values_len)) return 0;
            if (values_len < 2 || *values != '[') return 0;
            const char* p = values + 1;
            const char* end = values + values_len - 1;
            int found = 0;
            while (p < end) {
                while (p < end && (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n')) p++;
                if (p >= end) break;
                const char* tok = p;
                char tok_buf[128]; tok_buf[0] = 0;
                if (*p == '"') {
                    p++;
                    const char* q = p;
                    while (q < end && *q != '"') {
                        if (*q == '\\' && q + 1 < end) { q += 2; continue; }
                        q++;
                    }
                    size_t slen = (size_t)(q - p);
                    if (slen >= sizeof(tok_buf)) slen = sizeof(tok_buf) - 1;
                    memcpy(tok_buf, p, slen); tok_buf[slen] = 0;
                    p = (q < end) ? q + 1 : q;
                } else {
                    while (p < end && *p != ',' && *p != ']'
                           && *p != ' ' && *p != '\n' && *p != '\r' && *p != '\t') p++;
                    size_t slen = (size_t)(p - tok);
                    if (slen >= sizeof(tok_buf)) slen = sizeof(tok_buf) - 1;
                    memcpy(tok_buf, tok, slen); tok_buf[slen] = 0;
                }
                if (strcmp(tok_buf, v_str) == 0) { found = 1; break; }
            }
            return negate ? (found ? 0 : 1) : (found ? 1 : 0);
        }

        /* Leaf comparison. */
        int op_code = POLLEN_COND_NONE;
        if      (strcmp(op, "==") == 0) op_code = POLLEN_COND_EQ;
        else if (strcmp(op, "!=") == 0) op_code = POLLEN_COND_NE;
        else if (strcmp(op, "<")  == 0) op_code = POLLEN_COND_LT;
        else if (strcmp(op, ">")  == 0) op_code = POLLEN_COND_GT;
        else if (strcmp(op, "<=") == 0) op_code = POLLEN_COND_LE;
        else if (strcmp(op, ">=") == 0) op_code = POLLEN_COND_GE;
        else return 0;

        const char* var; size_t var_len;
        if (!_pollen_json_field(expr, expr_len, "var", 3,
                                  &var, &var_len)) return 0;
        if (var_len < 2 || *var != '"') return 0;
        char path[POLLEN_COND_VAR_MAX];
        size_t plen = var_len - 2;
        if (plen >= sizeof(path)) plen = sizeof(path) - 1;
        memcpy(path, var + 1, plen); path[plen] = 0;

        const char* val; size_t v_len;
        if (!_pollen_json_field(expr, expr_len, "value", 5,
                                  &val, &v_len)) return 0;
        int rhs_is_num = 0;
        double rhs_num = 0;
        char rhs_str[POLLEN_COND_STR_MAX] = "";
        if (v_len > 0 && *val == '"') {
            size_t slen = v_len >= 2 ? v_len - 2 : 0;
            if (slen >= sizeof(rhs_str)) slen = sizeof(rhs_str) - 1;
            memcpy(rhs_str, val + 1, slen); rhs_str[slen] = 0;
        } else if (v_len > 0 && ((*val >= '0' && *val <= '9')
                   || *val == '-' || *val == '+' || *val == '.')) {
            char tmp[64];
            size_t cn = v_len < sizeof(tmp) - 1 ? v_len : sizeof(tmp) - 1;
            memcpy(tmp, val, cn); tmp[cn] = 0;
            rhs_num = atof(tmp);
            rhs_is_num = 1;
        } else if (v_len == 4 && memcmp(val, "true", 4) == 0) {
            strcpy(rhs_str, "true");
        } else if (v_len == 5 && memcmp(val, "false", 5) == 0) {
            strcpy(rhs_str, "false");
        } else if (v_len == 4 && memcmp(val, "null", 4) == 0) {
            strcpy(rhs_str, "null");
        } else {
            return 0;
        }

        return _pollen_cond_eval_leaf(env, env_len, path, op_code,
                                        rhs_is_num, rhs_num, rhs_str);
    }

    /* Public facade — evaluate an expression against an envelope.
     * Returns the literal form (number-as-string, or "\"foo\"" with
     * the quotes embedded). Empty "" on eval failure. */
    static code_string
    Amalgame_Pollen_Pollen_EvalExpr_c(code_string envelopeJson,
                                        code_string exprJson) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!envelopeJson || !exprJson) return (code_string) empty;
        const char* env = (const char*) envelopeJson;
        const char* expr = (const char*) exprJson;
        size_t env_len = strlen(env);
        size_t expr_len = strlen(expr);
        _pollen_expr_val_t val;
        if (!_pollen_eval_expr(env, env_len, expr, expr_len, &val)) {
            return (code_string) empty;
        }
        char lit[256];
        int n = _pollen_expr_val_to_literal(&val, lit, sizeof(lit));
        if (n <= 0 || n >= (int) sizeof(lit)) return (code_string) empty;
        char* out = (char*) GC_MALLOC_ATOMIC((size_t) n + 1);
        if (!out) return (code_string) empty;
        memcpy(out, lit, (size_t) n); out[n] = 0;
        return (code_string) out;
    }

    /* Public facade — evaluate a cond expression against an envelope.
     * Empty cond → true (else-branch semantics). */
    static code_bool
    Amalgame_Pollen_Pollen_EvalCond_c(code_string envelopeJson,
                                        code_string condJson) {
        if (!envelopeJson) return (code_bool) 0;
        const char* env = (const char*) envelopeJson;
        const char* cond = condJson ? (const char*) condJson : "";
        size_t env_len = strlen(env);
        size_t cond_len = strlen(cond);
        int ok = _pollen_cond_eval_expr(env, env_len, cond, cond_len);
        return (code_bool) (ok ? 1 : 0);
    }

    /* === M2.3c.2b — for / while setters + dispatch ============ */

    static void _pollen_for_clear(void) {
        _pollen_for_active = 0;
        _pollen_for_route.n_items = 0;
        _pollen_for_route.n_targets = 0;
        _pollen_for_route.item_var[0] = 0;
        _pollen_for_route.topic[0] = 0;
    }

    static void _pollen_for_setup(const char* var) {
        _pollen_for_active = 1;
        _pollen_for_route.n_items = 0;
        _pollen_for_route.n_targets = 0;
        _pollen_for_route.topic[0] = 0;
        strncpy(_pollen_for_route.item_var,
                 var && var[0] ? var : "item",
                 POLLEN_COND_VAR_MAX - 1);
        _pollen_for_route.item_var[POLLEN_COND_VAR_MAX - 1] = 0;
    }

    /* v0.1.21 — v2 routing : each iteration rebuilds with this topic
     * and resolves a live provider via the LB, instead of fanning out
     * to static targets. Empty → v1 behaviour. */
    static void _pollen_for_set_topic(const char* topic) {
        strncpy(_pollen_for_route.topic, topic ? topic : "",
                 POLLEN_TOPIC_MAX - 1);
        _pollen_for_route.topic[POLLEN_TOPIC_MAX - 1] = 0;
    }

    static void _pollen_for_add_target(const char* host, int port) {
        if (_pollen_for_route.n_targets >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_for_route.target_host[_pollen_for_route.n_targets],
                 host ? host : "", POLLEN_HOST_MAX - 1);
        _pollen_for_route.target_host[_pollen_for_route.n_targets][POLLEN_HOST_MAX - 1] = 0;
        _pollen_for_route.target_port[_pollen_for_route.n_targets] = port;
        _pollen_for_route.n_targets++;
    }

    static void _pollen_for_add_item(const char* item_lit) {
        if (_pollen_for_route.n_items >= POLLEN_FOR_MAX_ITEMS) return;
        strncpy(_pollen_for_route.items[_pollen_for_route.n_items],
                 item_lit ? item_lit : "null",
                 POLLEN_FOR_ITEM_MAX - 1);
        _pollen_for_route.items[_pollen_for_route.n_items][POLLEN_FOR_ITEM_MAX - 1] = 0;
        _pollen_for_route.n_items++;
    }

    static void _pollen_while_clear(void) {
        _pollen_while_active = 0;
        _pollen_while_route.cond_expr[0] = 0;
        _pollen_while_route.iter_state_key[0] = 0;
        _pollen_while_route.max_iter = 0;
        _pollen_while_route.loop_host[0] = 0;
        _pollen_while_route.loop_port = 0;
        _pollen_while_route.n_exits = 0;
        _pollen_while_route.exit_topic[0] = 0;
        _pollen_while_route.body_topic[0] = 0;
    }

    static void _pollen_while_setup(const char* cond_json,
                                      const char* iter_key,
                                      int max_iter,
                                      const char* self_host,
                                      int self_port) {
        _pollen_while_active = 1;
        strncpy(_pollen_while_route.cond_expr, cond_json ? cond_json : "",
                 POLLEN_COND_EXPR_MAX - 1);
        _pollen_while_route.cond_expr[POLLEN_COND_EXPR_MAX - 1] = 0;
        strncpy(_pollen_while_route.iter_state_key,
                 iter_key && iter_key[0] ? iter_key : "_wf_iter",
                 POLLEN_COND_VAR_MAX - 1);
        _pollen_while_route.iter_state_key[POLLEN_COND_VAR_MAX - 1] = 0;
        _pollen_while_route.max_iter = max_iter > 0 ? max_iter : 100;
        strncpy(_pollen_while_route.loop_host, self_host ? self_host : "",
                 POLLEN_HOST_MAX - 1);
        _pollen_while_route.loop_host[POLLEN_HOST_MAX - 1] = 0;
        _pollen_while_route.loop_port = self_port;
        _pollen_while_route.n_exits = 0;
        _pollen_while_route.exit_topic[0] = 0;
        _pollen_while_route.body_topic[0] = 0;
    }

    /* v0.1.23 — explicit while.body : the body action's consume topic.
     * On continue, the controller forwards to a registry-resolved
     * provider of this topic instead of looping to self. The body
     * action processes one iteration then forwards back. */
    static void _pollen_while_set_body_topic(const char* topic) {
        strncpy(_pollen_while_route.body_topic, topic ? topic : "",
                 POLLEN_TOPIC_MAX - 1);
        _pollen_while_route.body_topic[POLLEN_TOPIC_MAX - 1] = 0;
    }

    /* v0.1.22 — v2 routing : set the exit topic. When set (+ LB on),
     * on exit the envelope is rebuilt with this topic and forwarded
     * to a registry-resolved provider — no static exit targets. */
    static void _pollen_while_set_exit_topic(const char* topic) {
        strncpy(_pollen_while_route.exit_topic, topic ? topic : "",
                 POLLEN_TOPIC_MAX - 1);
        _pollen_while_route.exit_topic[POLLEN_TOPIC_MAX - 1] = 0;
    }

    static void _pollen_while_add_exit(const char* host, int port) {
        if (_pollen_while_route.n_exits >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_while_route.exit_host[_pollen_while_route.n_exits],
                 host ? host : "", POLLEN_HOST_MAX - 1);
        _pollen_while_route.exit_host[_pollen_while_route.n_exits][POLLEN_HOST_MAX - 1] = 0;
        _pollen_while_route.exit_port[_pollen_while_route.n_exits] = port;
        _pollen_while_route.n_exits++;
    }

    /* === M2.3c.2 — dispatch helper bodies (deferred from up top
     * because they call into the M2.2 cond_eval / expr_eval +
     * M2.1 state_persist routines defined just above). === */

    /* Apply pending set ops against the state file for the envelope's
     * rootMessageId. Each op evaluates its value_expr against the
     * envelope via _pollen_eval_expr, then persists via
     * _pollen_state_set. Best-effort : skip silently if the envelope
     * lacks rootMessageId or the write fails. */
    static void _pollen_set_ops_apply(const char* env, size_t env_len) {
        if (_pollen_n_set_ops == 0) return;
        char root[64];
        if (!_pollen_extract_root_mid(env, env_len, root, sizeof(root))) return;
        for (int i = 0; i < _pollen_n_set_ops; i++) {
            pollen_set_op_t* o = &_pollen_set_ops[i];
            _pollen_expr_val_t val;
            size_t elen = strlen(o->value_expr);
            if (!_pollen_eval_expr(env, env_len, o->value_expr, elen, &val)) {
                continue;
            }
            char lit[256];
            int ln = _pollen_expr_val_to_literal(&val, lit, sizeof(lit));
            if (ln <= 0 || ln >= (int) sizeof(lit)) continue;
            _pollen_state_set(root, o->path, lit);
        }
    }

    /* Phase 5.4 — for loop. Each iteration writes state.<item_var>
     * = items[i], then rebuilds the envelope (new mid + parent
     * chain + topic rewrite) and forwards to every target.
     * Total messages = n_items × n_targets. */
    static void _pollen_for_forward(const char* env, size_t env_len,
                                      char* out_new_mid) {
        char root[64];
        int have_root = _pollen_extract_root_mid(env, env_len,
                                                   root, sizeof(root));
        const char* var = _pollen_for_route.item_var;
        char state_path[POLLEN_COND_VAR_MAX + 8];
        if (strncmp(var, "state.", 6) == 0) {
            snprintf(state_path, sizeof(state_path), "%s", var);
        } else {
            snprintf(state_path, sizeof(state_path), "state.%s", var);
        }
        for (int i = 0; i < _pollen_for_route.n_items; i++) {
            const char* item = _pollen_for_route.items[i];
            if (have_root) {
                _pollen_state_set(root, state_path, item);
            }
            char rebuilt[8192];
            /* v0.1.21 — v2 routing : when the for has its own topic,
             * each iteration rebuilds with THAT topic and resolves a
             * live provider via the LB (no static targets needed).
             * Empty topic → v1 behaviour (global emit + static fan). */
            const char* new_topic = _pollen_for_route.topic[0]
                                      ? _pollen_for_route.topic
                                      : (_pollen_wf_emit_topic[0]
                                          ? _pollen_wf_emit_topic : NULL);
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                      rebuilt, sizeof(rebuilt),
                                                      new_topic, out_new_mid);
            const char* fwd = rn > 0 ? rebuilt : env;
            size_t fwd_len = rn > 0 ? rn : env_len;
            if (_pollen_for_route.topic[0] && _pollen_lb_enabled) {
                char lb_host[POLLEN_HOST_MAX]; int lb_port = 0;
                if (_pollen_lb_pick(_pollen_for_route.topic,
                                     lb_host, sizeof(lb_host), &lb_port)) {
                    _pollen_wf_forward_one(lb_host, lb_port, fwd, fwd_len);
                }
                /* topic set but no live provider → drop this item. */
                continue;
            }
            for (int t = 0; t < _pollen_for_route.n_targets; t++) {
                _pollen_wf_forward_one(_pollen_for_route.target_host[t],
                                         _pollen_for_route.target_port[t],
                                         fwd, fwd_len);
            }
        }
    }

    /* Phase 5.4 — while loop with maxIter + cond. Reads iter from
     * state, evaluates cond, decides loop vs exit. On loop bumps
     * iter + forwards to self. On exit forwards to every exit
     * target. Auto-iter checked BEFORE cond so a runaway loop
     * always terminates. */
    static void _pollen_while_forward(const char* env, size_t env_len,
                                        char* out_new_mid) {
        char root[64];
        int have_root = _pollen_extract_root_mid(env, env_len,
                                                   root, sizeof(root));
        int iter = 0;
        if (have_root) {
            char state_buf[POLLEN_STATE_FILE_MAX];
            int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
            if (sn > 0) {
                const char* vp; size_t vl;
                if (_pollen_resolve_path(state_buf, (size_t) sn,
                                           _pollen_while_route.iter_state_key,
                                           &vp, &vl)) {
                    char tmp[32];
                    size_t cn = vl < sizeof(tmp) - 1 ? vl : sizeof(tmp) - 1;
                    memcpy(tmp, vp, cn); tmp[cn] = 0;
                    iter = atoi(tmp);
                }
            }
        }

        int hit_max = (iter >= _pollen_while_route.max_iter);
        int cond_pass = _pollen_cond_eval_expr(env, env_len,
                                                 _pollen_while_route.cond_expr,
                                                 strlen(_pollen_while_route.cond_expr));

        if (!hit_max && cond_pass) {
            if (have_root) {
                char lit[32];
                snprintf(lit, sizeof(lit), "%d", iter + 1);
                _pollen_state_set(root,
                                    _pollen_while_route.iter_state_key,
                                    lit);
            }
            char rebuilt[8192];
            /* v0.1.23 — when body_topic is set, the iteration goes to
             * the body action (resolved via LB) which then forwards
             * back to the controller. The rebuild uses the body topic
             * so the body receives a properly-tagged envelope. */
            const char* new_topic = _pollen_while_route.body_topic[0]
                                      ? _pollen_while_route.body_topic
                                      : (_pollen_wf_emit_topic[0]
                                          ? _pollen_wf_emit_topic : NULL);
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                      rebuilt, sizeof(rebuilt),
                                                      new_topic, out_new_mid);
            const char* fwd = rn > 0 ? rebuilt : env;
            size_t fwd_len = rn > 0 ? rn : env_len;
            if (_pollen_while_route.body_topic[0] && _pollen_lb_enabled) {
                char lb_host[POLLEN_HOST_MAX]; int lb_port = 0;
                if (_pollen_lb_pick(_pollen_while_route.body_topic,
                                     lb_host, sizeof(lb_host), &lb_port)) {
                    _pollen_wf_forward_one(lb_host, lb_port, fwd, fwd_len);
                }
                /* topic set but no live provider → drop this iteration */
                return;
            }
            _pollen_wf_forward_one(_pollen_while_route.loop_host,
                                     _pollen_while_route.loop_port,
                                     fwd, fwd_len);
            return;
        }

        /* v0.1.22 — v2 exit by topic : rebuild with the exit topic
         * and resolve a live provider via the LB. v1 keeps the static
         * exit list + global emit topic. No exits at all → drop. */
        if (_pollen_while_route.exit_topic[0] == 0
            && _pollen_while_route.n_exits == 0) return;
        char rebuilt[8192];
        const char* new_topic = _pollen_while_route.exit_topic[0]
                                  ? _pollen_while_route.exit_topic
                                  : (_pollen_wf_emit_topic[0]
                                      ? _pollen_wf_emit_topic : NULL);
        size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                  rebuilt, sizeof(rebuilt),
                                                  new_topic, out_new_mid);
        const char* fwd = rn > 0 ? rebuilt : env;
        size_t fwd_len = rn > 0 ? rn : env_len;
        if (_pollen_while_route.exit_topic[0] && _pollen_lb_enabled) {
            char lb_host[POLLEN_HOST_MAX]; int lb_port = 0;
            if (_pollen_lb_pick(_pollen_while_route.exit_topic,
                                 lb_host, sizeof(lb_host), &lb_port)) {
                _pollen_wf_forward_one(lb_host, lb_port, fwd, fwd_len);
            }
            return;
        }
        for (int i = 0; i < _pollen_while_route.n_exits; i++) {
            _pollen_wf_forward_one(_pollen_while_route.exit_host[i],
                                     _pollen_while_route.exit_port[i],
                                     fwd, fwd_len);
        }
    }

    /* Evaluate each branch's cond top-down. First match wins :
     * rebuild the envelope (new mid + parent chain + optional topic
     * rewrite) and forward to that branch's target list. No match :
     * drop silently (caller already ACKed). */
    static void _pollen_cond_forward(const char* env, size_t env_len,
                                       char* out_new_mid) {
        for (int i = 0; i < _pollen_cond_n_branches; i++) {
            pollen_cond_branch_t* b = &_pollen_cond_branches[i];
            int pass = _pollen_cond_eval_expr(env, env_len,
                                                b->cond_expr,
                                                strlen(b->cond_expr));
            if (!pass) continue;
            char rebuilt[8192];
            const char* fwd = env;
            size_t fwd_len = env_len;
            /* v0.1.20 — v2 routing : a branch with its own topic
             * rebuilds with THAT topic (each branch targets a distinct
             * action) and resolves a live provider via the LB. v1
             * branches rebuild with the global emit topic + forward to
             * the static target list. */
            const char* new_topic = b->topic[0] ? b->topic
                                      : (_pollen_wf_emit_topic[0]
                                          ? _pollen_wf_emit_topic : NULL);
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                      rebuilt, sizeof(rebuilt),
                                                      new_topic, out_new_mid);
            if (rn > 0) { fwd = rebuilt; fwd_len = rn; }
            if (b->topic[0] && _pollen_lb_enabled) {
                char lb_host[POLLEN_HOST_MAX]; int lb_port = 0;
                if (_pollen_lb_pick(b->topic, lb_host, sizeof(lb_host), &lb_port)) {
                    _pollen_wf_forward_one(lb_host, lb_port, fwd, fwd_len);
                }
                /* topic set but no live provider → drop (no static
                 * fallback in v2). */
                return;
            }
            for (int t = 0; t < b->n_targets; t++) {
                _pollen_wf_forward_one(b->targets_host[t],
                                         b->targets_port[t],
                                         fwd, fwd_len);
            }
            return;  /* first match wins, mirrors workflow-tree `if` */
        }
        /* No branch matched — drop silently. */
    }

    /* === M2.4 — debug bridge (Phase 4.5.x) ===================
     *
     * When an envelope carries a `debug` field and this node's role
     * matches the pause criteria, phone home to the manager declared
     * in the envelope (one-shot TCP connect + DEBUG_PAUSE + recv the
     * operator's command), then act :
     *   CANCEL / TIMEOUT / NO_CONN → drop the message
     *   MUTATE                     → rewrite data + remap to `then`
     *   STEP_*                     → rewrite mode=step  hit_bp=false
     *   CONTINUE                   → rewrite mode=breakpoint hit_bp=false
     * The (possibly rewritten) envelope then flows through the normal
     * set / cond / for / while / forward dispatch.
     */
    #define POLLEN_DBG_STEP_OVER  0
    #define POLLEN_DBG_STEP_INTO  1
    #define POLLEN_DBG_CONTINUE   2
    #define POLLEN_DBG_CANCEL     3
    #define POLLEN_DBG_MUTATE     4
    #define POLLEN_DBG_TIMEOUT    5
    #define POLLEN_DBG_NO_CONN    6
    #define POLLEN_DBG_NO_PAUSE   7

    static int _pollen_debug_should_pause(const char* envelope,
                                            size_t envelope_len,
                                            const char* self_role) {
        const char* d = _pollen_find(envelope, envelope_len,
                                       "\"debug\":{\"session\":\"", 20);
        if (!d) return POLLEN_DBG_NO_PAUSE;
        const char* hit = _pollen_find(envelope, envelope_len,
                                         "\"hit_bp\":true", 13);
        if (hit) return POLLEN_DBG_STEP_INTO;  /* sticky once tripped */
        const char* mk = _pollen_find(envelope, envelope_len,
                                        "\"mode\":\"", 8);
        if (!mk) return POLLEN_DBG_NO_PAUSE;
        const char* mv = mk + 8;
        const char* mq = memchr(mv, '"',
                                  envelope_len - (size_t)(mv - envelope));
        if (!mq) return POLLEN_DBG_NO_PAUSE;
        size_t mlen = (size_t)(mq - mv);
        int is_step = (mlen == 4 && memcmp(mv, "step", 4) == 0);
        int is_bp   = (mlen == 10 && memcmp(mv, "breakpoint", 10) == 0);
        if (is_step) return POLLEN_DBG_STEP_INTO;
        if (!is_bp)  return POLLEN_DBG_NO_PAUSE;
        /* mode=breakpoint : pause iff our role appears after the
         * "breakpoints":[ marker. */
        const char* bps = _pollen_find(envelope, envelope_len,
                                         "\"breakpoints\":[", 15);
        if (!bps) return POLLEN_DBG_NO_PAUSE;
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle),
                             "\"role\":\"%s\"", self_role ? self_role : "");
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return POLLEN_DBG_NO_PAUSE;
        size_t off = (size_t)(bps - envelope);
        const char* hit2 = _pollen_find(envelope + off,
                                          envelope_len - off,
                                          needle, (size_t) nlen);
        return hit2 ? POLLEN_DBG_STEP_INTO : POLLEN_DBG_NO_PAUSE;
    }

    static int _pollen_debug_extract_manager(const char* envelope,
                                               size_t envelope_len,
                                               char* out, size_t out_cap) {
        const char* m = _pollen_find(envelope, envelope_len,
                                       "\"manager\":\"", 11);
        if (!m) return 0;
        const char* v = m + 11;
        const char* q = memchr(v, '"',
                                 envelope_len - (size_t)(v - envelope));
        if (!q) return 0;
        size_t vlen = (size_t)(q - v);
        if (vlen == 0 || vlen >= out_cap) return 0;
        memcpy(out, v, vlen); out[vlen] = 0;
        return 1;
    }

    /* Extract a JSON object / array / string / literal value for a
     * "key": pair. Writes [start, end) byte offsets. 1 on success. */
    static int _pollen_extract_json_value(const char* buf, size_t buf_len,
                                            const char* key, size_t key_len,
                                            size_t* out_start, size_t* out_end) {
        const char* k = _pollen_find(buf, buf_len, key, key_len);
        if (!k) return 0;
        const char* v = k + key_len;
        while (v < buf + buf_len && (*v == ' ' || *v == '\t')) v++;
        if (v >= buf + buf_len) return 0;
        size_t start = (size_t)(v - buf);
        char open = *v, close;
        if      (open == '{') close = '}';
        else if (open == '[') close = ']';
        else if (open == '"') {
            size_t i = start + 1;
            while (i < buf_len) {
                if (buf[i] == '\\') { i += 2; continue; }
                if (buf[i] == '"') { *out_start = start; *out_end = i + 1; return 1; }
                i++;
            }
            return 0;
        } else {
            size_t i = start;
            while (i < buf_len && buf[i] != ',' && buf[i] != '}' && buf[i] != ']'
                   && buf[i] != ' ' && buf[i] != '\t'
                   && buf[i] != '\n' && buf[i] != '\r') i++;
            *out_start = start; *out_end = i; return 1;
        }
        int depth = 0;
        for (size_t i = start; i < buf_len; i++) {
            char c = buf[i];
            if (c == '"') {
                i++;
                while (i < buf_len) {
                    if (buf[i] == '\\') { i += 2; continue; }
                    if (buf[i] == '"') break;
                    i++;
                }
                continue;
            }
            if (c == open) depth++;
            else if (c == close) {
                depth--;
                if (depth == 0) { *out_start = start; *out_end = i + 1; return 1; }
            }
        }
        return 0;
    }

    /* Rewrite debug.mode + debug.hit_bp. 0 on failure (no debug
     * field — caller forwards verbatim). */
    static size_t _pollen_debug_rewrite(const char* in, size_t in_len,
                                          char* out, size_t out_cap,
                                          const char* new_mode, int new_hit_bp) {
        const char* m = _pollen_find(in, in_len, "\"mode\":\"", 8);
        if (!m) return 0;
        const char* mv_start = m + 8;
        const char* mv_end = memchr(mv_start, '"',
                                      in_len - (size_t)(mv_start - in));
        if (!mv_end) return 0;
        const char* h = _pollen_find(in, in_len, "\"hit_bp\":", 9);
        if (!h) return 0;
        const char* hv_start = h + 9;
        const char* hv_end;
        if (in_len - (size_t)(hv_start - in) >= 4
            && memcmp(hv_start, "true", 4) == 0) {
            hv_end = hv_start + 4;
        } else if (in_len - (size_t)(hv_start - in) >= 5
            && memcmp(hv_start, "false", 5) == 0) {
            hv_end = hv_start + 5;
        } else return 0;
        if (mv_end >= h) return 0;
        const char* new_hit_str = new_hit_bp ? "true" : "false";
        size_t new_mode_len = strlen(new_mode);
        size_t new_hit_len = strlen(new_hit_str);
        size_t pre = (size_t)(mv_start - in);
        size_t mid = (size_t)(h - mv_end);
        size_t tail = (size_t)((in + in_len) - hv_end);
        size_t total = pre + new_mode_len + mid + 9 + new_hit_len + tail;
        if (total > out_cap) return 0;
        size_t o = 0;
        memcpy(out + o, in, pre); o += pre;
        memcpy(out + o, new_mode, new_mode_len); o += new_mode_len;
        memcpy(out + o, mv_end, mid); o += mid;
        memcpy(out + o, "\"hit_bp\":", 9); o += 9;
        memcpy(out + o, new_hit_str, new_hit_len); o += new_hit_len;
        memcpy(out + o, hv_end, tail); o += tail;
        return o;
    }

    /* Rewrite the `data` field in-place (anchored start of `"data":`
     * → start of `,"timestamp":`). 0 on failure. */
    static size_t _pollen_debug_rewrite_data(const char* in, size_t in_len,
                                               char* out, size_t out_cap,
                                               const char* new_data,
                                               size_t new_data_len) {
        const char* d = _pollen_find(in, in_len, "\"data\":", 7);
        if (!d) return 0;
        const char* d_val_start = d + 7;
        size_t after_off = (size_t)(d_val_start - in);
        const char* d_end = _pollen_find(in + after_off, in_len - after_off,
                                           ",\"timestamp\":", 13);
        if (!d_end) return 0;
        size_t pre = (size_t)(d_val_start - in);
        size_t tail = in_len - (size_t)(d_end - in);
        size_t total = pre + new_data_len + tail;
        if (total > out_cap) return 0;
        memcpy(out, in, pre);
        memcpy(out + pre, new_data, new_data_len);
        memcpy(out + pre + new_data_len, d_end, tail);
        return total;
    }

    /* One-shot phone-home to the manager. Sends DEBUG_PAUSE + the
     * full envelope, blocks (60s) for the command line, copies the
     * raw response into resp_out. Returns the command code. */
    static int _pollen_debug_pause(const char* envelope, size_t envelope_len,
                                     const char* manager_host_port,
                                     const char* session_str,
                                     const char* role,
                                     char* resp_out, size_t resp_out_cap) {
        char host[64];
        const char* colon = strchr(manager_host_port, ':');
        if (!colon) return POLLEN_DBG_NO_CONN;
        size_t hlen = (size_t)(colon - manager_host_port);
        if (hlen == 0 || hlen >= sizeof(host)) return POLLEN_DBG_NO_CONN;
        memcpy(host, manager_host_port, hlen); host[hlen] = 0;
        int port = atoi(colon + 1);
        if (port <= 0 || port > 65535) return POLLEN_DBG_NO_CONN;

        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return POLLEN_DBG_NO_CONN;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        struct timeval ctv = { 3, 0 };
        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &ctv, sizeof(ctv));
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        char header[256];
        int hn = snprintf(header, sizeof(header),
            "{\"type\":\"DEBUG_PAUSE\",\"session\":\"%s\","
             "\"role\":\"%s\",\"envelope\":",
            session_str, role);
        if (hn <= 0 || hn >= (int) sizeof(header)) { close(fd); return POLLEN_DBG_NO_CONN; }
        if (send(fd, header, (size_t) hn, MSG_NOSIGNAL) != hn) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        if (send(fd, envelope, envelope_len, MSG_NOSIGNAL) != (ssize_t) envelope_len) {
            close(fd); return POLLEN_DBG_NO_CONN;
        }
        send(fd, "}\n", 2, MSG_NOSIGNAL);

        struct timeval rtv = { 60, 0 };
        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rtv, sizeof(rtv));
        char rbuf[8192];
        ssize_t got = 0, r;
        while (got < (ssize_t) sizeof(rbuf) - 1) {
            r = recv(fd, rbuf + got, sizeof(rbuf) - 1 - got, 0);
            if (r <= 0) break;
            got += r;
            if (memchr(rbuf, '\n', got)) break;
        }
        close(fd);
        if (got <= 0) return POLLEN_DBG_TIMEOUT;
        rbuf[got] = 0;
        if (resp_out && resp_out_cap > 0) {
            size_t copy = (size_t) got;
            if (copy >= resp_out_cap) copy = resp_out_cap - 1;
            memcpy(resp_out, rbuf, copy); resp_out[copy] = 0;
        }
        if (strstr(rbuf, "\"DEBUG_STEP_OVER\""))  return POLLEN_DBG_STEP_OVER;
        if (strstr(rbuf, "\"DEBUG_STEP_INTO\""))  return POLLEN_DBG_STEP_INTO;
        if (strstr(rbuf, "\"DEBUG_STEP\""))       return POLLEN_DBG_STEP_INTO;
        if (strstr(rbuf, "\"DEBUG_CONTINUE\""))   return POLLEN_DBG_CONTINUE;
        if (strstr(rbuf, "\"DEBUG_CANCEL\""))     return POLLEN_DBG_CANCEL;
        if (strstr(rbuf, "\"DEBUG_MUTATE\""))     return POLLEN_DBG_MUTATE;
        return POLLEN_DBG_TIMEOUT;
    }

    /* Orchestrator : should_pause → phone home → act. Produces the
     * (possibly rewritten) envelope into `out`. Returns 1 to proceed,
     * 0 to drop. self_role comes from WorkflowSetSelf (_pollen_pkg_role). */
    static int _pollen_debug_process(const char* in, size_t in_len,
                                       char* out, size_t out_cap,
                                       size_t* out_len) {
        /* Default : pass through verbatim. */
        if (in_len > out_cap) { *out_len = 0; return 1; }  /* too big to copy — forward original via caller */
        memcpy(out, in, in_len);
        *out_len = in_len;

        const char* dp = _pollen_find(in, in_len, "\"debug\":{\"session\":\"", 20);
        if (!dp) return 1;

        int should = _pollen_debug_should_pause(in, in_len, _pollen_pkg_role);
        if (should == POLLEN_DBG_NO_PAUSE) return 1;

        /* Extract session id */
        const char* sv = dp + 20;
        const char* sq = memchr(sv, '"', in_len - (size_t)(sv - in));
        if (!sq) return 1;
        char session[64];
        size_t slen = (size_t)(sq - sv);
        if (slen >= sizeof(session)) return 1;
        memcpy(session, sv, slen); session[slen] = 0;

        char mgr[96];
        if (!_pollen_debug_extract_manager(in, in_len, mgr, sizeof(mgr))) return 1;

        char resp[8192]; resp[0] = 0;
        int cmd = _pollen_debug_pause(in, in_len, mgr, session,
                                        _pollen_pkg_role, resp, sizeof(resp));

        if (cmd == POLLEN_DBG_CANCEL || cmd == POLLEN_DBG_TIMEOUT
            || cmd == POLLEN_DBG_NO_CONN) {
            return 0;  /* drop */
        }

        char tmp[16384];
        const char* base = in;
        size_t base_len = in_len;

        if (cmd == POLLEN_DBG_MUTATE) {
            size_t ds = 0, de = 0;
            size_t rlen = strlen(resp);
            if (_pollen_extract_json_value(resp, rlen, "\"data\":", 7, &ds, &de)) {
                size_t rn = _pollen_debug_rewrite_data(in, in_len,
                    tmp, sizeof(tmp), resp + ds, de - ds);
                if (rn > 0) { base = tmp; base_len = rn; }
            }
            const char* t = _pollen_find(resp, rlen, "\"then\":\"", 8);
            cmd = POLLEN_DBG_CONTINUE;
            if (t) {
                const char* tv = t + 8;
                size_t remain = rlen - (size_t)(tv - resp);
                if (remain >= 9 && memcmp(tv, "step_into", 9) == 0) cmd = POLLEN_DBG_STEP_INTO;
                else if (remain >= 9 && memcmp(tv, "step_over", 9) == 0) cmd = POLLEN_DBG_STEP_OVER;
            }
        }

        const char* new_mode = NULL;
        if (cmd == POLLEN_DBG_STEP_OVER || cmd == POLLEN_DBG_STEP_INTO) new_mode = "step";
        else if (cmd == POLLEN_DBG_CONTINUE) new_mode = "breakpoint";

        if (new_mode) {
            size_t rn = _pollen_debug_rewrite(base, base_len,
                out, out_cap, new_mode, 0);
            if (rn > 0) { *out_len = rn; return 1; }
        }
        /* No mode rewrite (or it failed) — emit `base` as-is. */
        if (base_len <= out_cap) {
            if (base != out) memcpy(out, base, base_len);
            *out_len = base_len;
        }
        return 1;
    }

    /* === M2.3c.1 — workflow setters + dispatch helpers ======= */

    static void _pollen_wf_reload_begin(void) {
        pthread_mutex_lock(&_pollen_wf_mutex);
        _pollen_wf_n_consumes = 0;
        _pollen_wf_n_nexts = 0;
        _pollen_wf_emit_topic[0] = 0;
        /* M2.3c.2 — also reset cond branches + set ops + for/while
         * routes so a reload that drops the `if` / `set` / `for` /
         * `while` reverts to plain fan-out. */
        _pollen_cond_clear();
        _pollen_set_ops_clear();
        _pollen_for_clear();
        _pollen_while_clear();
        /* _pollen_wf_active stays sticky — once a workflow has been
         * loaded, free-form fallback won't kick back in even if the
         * new config is empty. Restart the process to disable. */
    }

    static void _pollen_wf_reload_commit(void) {
        _pollen_wf_version++;
        pthread_mutex_unlock(&_pollen_wf_mutex);
    }

    static void _pollen_wf_add_consume(const char* topic) {
        if (!topic) return;
        if (_pollen_wf_n_consumes >= POLLEN_MAX_CONSUMES) return;
        strncpy(_pollen_wf_consumes[_pollen_wf_n_consumes], topic,
                 POLLEN_TOPIC_MAX - 1);
        _pollen_wf_consumes[_pollen_wf_n_consumes][POLLEN_TOPIC_MAX - 1] = 0;
        _pollen_wf_n_consumes++;
        _pollen_wf_active = 1;
    }

    static void _pollen_wf_add_next(const char* host, int port) {
        if (!host) return;
        if (_pollen_wf_n_nexts >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_wf_next_host[_pollen_wf_n_nexts], host,
                 POLLEN_HOST_MAX - 1);
        _pollen_wf_next_host[_pollen_wf_n_nexts][POLLEN_HOST_MAX - 1] = 0;
        _pollen_wf_next_port[_pollen_wf_n_nexts] = port;
        _pollen_wf_n_nexts++;
        _pollen_wf_active = 1;
    }

    static void _pollen_wf_set_emit_topic(const char* topic) {
        if (!topic) return;
        strncpy(_pollen_wf_emit_topic, topic, POLLEN_TOPIC_MAX - 1);
        _pollen_wf_emit_topic[POLLEN_TOPIC_MAX - 1] = 0;
    }

    /* O(N×M) consume check ; N ≤ 32 + topic ≤ 128 chars stays
     * sub-µs and keeps the hot loop branchless of mallocs. */
    static int _pollen_wf_topic_consumed(const char* topic, size_t topic_len) {
        for (int i = 0; i < _pollen_wf_n_consumes; i++) {
            size_t l = strlen(_pollen_wf_consumes[i]);
            if (l == topic_len && memcmp(_pollen_wf_consumes[i],
                                          topic, l) == 0) {
                return 1;
            }
        }
        return 0;
    }

    /* Fire-and-forget forward to a single downstream peer. */
    static void _pollen_wf_forward_one(const char* host, int port,
                                        const char* envelope, size_t env_len) {
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return;
        }
        send(fd, envelope, env_len, MSG_NOSIGNAL);
        if (env_len == 0 || envelope[env_len - 1] != '\n') {
            send(fd, "\n", 1, MSG_NOSIGNAL);
        }
        /* Fire-and-forget close — no SHUT_WR drain ; the receiver
         * sees EOF on close(). Avoids deadlock with self-loops
         * where the receiver holds the wf mutex. */
        close(fd);
    }

    /* Rebuild an envelope for forward : fresh messageId, optional
     * topic.uuid rewrite, parentMessageId appended carrying the
     * old mid. Returns the rebuilt length (with trailing '\n'),
     * 0 on parse failure (caller falls back to verbatim forward). */
    static size_t _pollen_wf_rebuild_envelope(
            const char* in, size_t in_len,
            char* out, size_t out_cap,
            const char* new_topic,
            char* out_new_mid /* may be NULL ; 37-byte buf */) {
        const char* m_key = _pollen_find(in, in_len,
                                          "\"messageId\":\"", 13);
        if (!m_key) return 0;
        const char* old_mid = m_key + 13;
        const char* old_mid_end = memchr(old_mid, '"',
                                          in_len - (size_t)(old_mid - in));
        if (!old_mid_end || (size_t)(old_mid_end - old_mid) != 36) return 0;

        const char* t_uuid_start = NULL;
        const char* t_uuid_end = NULL;
        if (new_topic) {
            const char* t_key = _pollen_find(in, in_len,
                                              "\"topic\":{\"uuid\":\"", 17);
            if (t_key) {
                t_uuid_start = t_key + 17;
                t_uuid_end = memchr(t_uuid_start, '"',
                                     in_len - (size_t)(t_uuid_start - in));
                if (!t_uuid_end) t_uuid_start = NULL;
            }
        }

        size_t e = in_len;
        while (e > 0 && (in[e-1] == '\n' || in[e-1] == '\r'
                          || in[e-1] == ' ' || in[e-1] == '\t')) e--;
        if (e == 0 || in[e-1] != '}') return 0;
        size_t close_pos = e - 1;

        char new_mid[37];
        _pollen_gen_uuid(new_mid);
        if (out_new_mid) memcpy(out_new_mid, new_mid, 37);

        size_t o = 0;
        #define _POLLEN_PE(src, n) do {                       \
            if (o + (n) > out_cap) return 0;                  \
            memcpy(out + o, (src), (n)); o += (n);            \
        } while (0)

        size_t mid_value_pos = (size_t)(old_mid - in);
        size_t mid_end_pos   = (size_t)(old_mid_end - in);

        _POLLEN_PE(in, mid_value_pos);
        _POLLEN_PE(new_mid, 36);

        if (t_uuid_start && t_uuid_end && new_topic) {
            size_t t_v_pos = (size_t)(t_uuid_start - in);
            size_t t_e_pos = (size_t)(t_uuid_end - in);
            _POLLEN_PE(in + mid_end_pos, t_v_pos - mid_end_pos);
            size_t tlen = strlen(new_topic);
            _POLLEN_PE(new_topic, tlen);
            _POLLEN_PE(in + t_e_pos, close_pos - t_e_pos);
        } else {
            _POLLEN_PE(in + mid_end_pos, close_pos - mid_end_pos);
        }

        const char* PARENT_OPEN = ",\"parentMessageId\":\"";
        _POLLEN_PE(PARENT_OPEN, 20);
        _POLLEN_PE(old_mid, 36);
        _POLLEN_PE("\"}", 2);
        _POLLEN_PE("\n", 1);
        #undef _POLLEN_PE
        return o;
    }

    /* v0.1.17 — replace the "data":<value> field of an envelope with
     * new_data (a raw JSON value, inserted verbatim). Used by the
     * OnMessage transform + Pollen.Forward. Returns the rebuilt
     * length (NOT newline-terminated), 0 on parse / capacity failure
     * so the caller keeps the original. */
    static size_t _pollen_replace_data(const char* in, size_t in_len,
                                         const char* new_data,
                                         char* out, size_t out_cap) {
        if (!in || !new_data) return 0;
        const char* v; size_t vlen;
        if (!_pollen_json_field(in, in_len, "data", 4, &v, &vlen)) return 0;
        size_t pre  = (size_t)(v - in);
        size_t post = pre + vlen;
        size_t nd   = strlen(new_data);
        size_t total = pre + nd + (in_len - post);
        if (total >= out_cap) return 0;
        memcpy(out, in, pre);
        memcpy(out + pre, new_data, nd);
        memcpy(out + pre + nd, in + post, in_len - post);
        return total;
    }

    /* === M2.3c.2 — cond branch setters + dispatch ============ */

    static void _pollen_cond_clear(void) {
        _pollen_cond_active = 0;
        _pollen_cond_n_branches = 0;
        _pollen_cond_current = -1;
    }

    /* Open a new cond branch. Empty cond_json = else / always-true. */
    static void _pollen_cond_branch_open(const char* cond_json) {
        if (_pollen_cond_n_branches >= POLLEN_COND_MAX_BRANCHES) return;
        _pollen_cond_active = 1;
        _pollen_cond_current = _pollen_cond_n_branches;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        strncpy(b->cond_expr, cond_json ? cond_json : "",
                 sizeof(b->cond_expr) - 1);
        b->cond_expr[sizeof(b->cond_expr) - 1] = 0;
        b->n_targets = 0;
        b->topic[0] = 0;
        _pollen_cond_n_branches++;
    }

    /* v0.1.20 — set the current branch's emit topic (v2 registry
     * routing). When set, _pollen_cond_forward rebuilds with this
     * topic + resolves a provider via the LB instead of using static
     * targets. */
    static void _pollen_cond_branch_set_topic(const char* topic) {
        if (_pollen_cond_current < 0
            || _pollen_cond_current >= _pollen_cond_n_branches) return;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        strncpy(b->topic, topic ? topic : "", POLLEN_TOPIC_MAX - 1);
        b->topic[POLLEN_TOPIC_MAX - 1] = 0;
    }

    static void _pollen_cond_branch_add_target(const char* host, int port) {
        if (_pollen_cond_current < 0
            || _pollen_cond_current >= _pollen_cond_n_branches) return;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        if (b->n_targets >= POLLEN_MAX_NEXTS) return;
        strncpy(b->targets_host[b->n_targets], host ? host : "",
                 POLLEN_HOST_MAX - 1);
        b->targets_host[b->n_targets][POLLEN_HOST_MAX - 1] = 0;
        b->targets_port[b->n_targets] = port;
        b->n_targets++;
    }

    /* === M2.3c.2 — set-op setters ============================ */

    static void _pollen_set_ops_clear(void) {
        _pollen_n_set_ops = 0;
    }

    static void _pollen_set_ops_add(const char* path,
                                      const char* value_expr) {
        if (_pollen_n_set_ops >= POLLEN_SET_OPS_MAX) return;
        pollen_set_op_t* o = &_pollen_set_ops[_pollen_n_set_ops];
        strncpy(o->path, path ? path : "", POLLEN_COND_VAR_MAX - 1);
        o->path[POLLEN_COND_VAR_MAX - 1] = 0;
        strncpy(o->value_expr, value_expr ? value_expr : "null",
                 sizeof(o->value_expr) - 1);
        o->value_expr[sizeof(o->value_expr) - 1] = 0;
        _pollen_n_set_ops++;
    }

    /* === M2.3c.2 — dispatch helpers (forward decls — bodies live
     * after the M2.2 cond_eval / expr_eval / state_persist blocks
     * since they call _pollen_cond_eval_expr / _pollen_eval_expr /
     * _pollen_state_set + _pollen_extract_root_mid). */

    static void _pollen_cond_forward(const char* env, size_t env_len,
                                       char* out_new_mid);
    static void _pollen_set_ops_apply(const char* env, size_t env_len);

    /* Forward to every downstream peer registered via add_next.
     * Caller holds _pollen_wf_mutex (snapshot of nexts is safe).
     * out_new_mid (37-byte buf, may be NULL) receives the rebuilt
     * envelope's fresh mid for the executions recorder. */
    static void _pollen_wf_forward_all(const char* envelope, size_t env_len,
                                         char* out_new_mid) {
        char rebuilt[8192];
        const char* fwd = envelope;
        size_t fwd_len = env_len;
        const char* new_topic = _pollen_wf_emit_topic[0] ?
                                  _pollen_wf_emit_topic : NULL;
        size_t rn = _pollen_wf_rebuild_envelope(envelope, env_len,
                                                  rebuilt, sizeof(rebuilt),
                                                  new_topic, out_new_mid);
        if (rn > 0) { fwd = rebuilt; fwd_len = rn; }
        /* Phase 6.3 — load-balanced forward : if enabled and the emit
         * topic resolves to a live provider, forward to that ONE pick
         * (power-of-two) instead of the static nexts. Falls back to
         * the static nexts when LB is off or no provider is known, so
         * single-instance demos are unchanged. */
        if (_pollen_lb_enabled && new_topic) {
            char lb_host[POLLEN_HOST_MAX]; int lb_port = 0;
            if (_pollen_lb_pick(new_topic, lb_host, sizeof(lb_host), &lb_port)) {
                _pollen_wf_forward_one(lb_host, lb_port, fwd, fwd_len);
                return;
            }
        }
        for (int i = 0; i < _pollen_wf_n_nexts; i++) {
            _pollen_wf_forward_one(_pollen_wf_next_host[i],
                                     _pollen_wf_next_port[i],
                                     fwd, fwd_len);
        }
    }

    /* === TCP transport ======================================== */

    /* M2.3b — accept loop + per-connection ACK echo worker.
     * Plain TCP + newline-framed JSON envelopes. No workflow
     * dispatch yet (M2.3c) and no debug bridge (M2.4) — just
     * recv → extract messageId → send back an ACK envelope.
     * One pthread per accepted connection ; the accept thread
     * itself blocks in StartListener until the process exits.
     * pthread.h is already included earlier alongside workflow
     * state definitions. */

    static void* _pollen_listener_worker(void* arg) {
        int fd = (int)(intptr_t) arg;
        char rbuf[16384];
        size_t rlen = 0;
        char ack[256];
        const char* MID_KEY   = "\"messageId\":\"";
        const size_t MID_KEY_LEN = 13;
        const char* TOPIC_KEY = "\"topic\":{\"uuid\":\"";
        const size_t TOPIC_KEY_LEN = 17;

        for (;;) {
            if (rlen >= sizeof(rbuf)) break;  /* oversize line — drop */
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            for (;;) {
                char* nl = memchr(rbuf, '\n', rlen);
                if (!nl) break;
                size_t line_len = (size_t)(nl - rbuf);

                /* Decide ACK + forward policy under the wf mutex :
                 *   wf active + topic ∈ consumes : ACK + forward
                 *   wf active + topic ∉ consumes : drop, no ACK
                 *   wf inactive                  : ACK (free-form fallback) */
                int do_ack = 1;
                int do_forward = 0;
                /* M2.4b — capture topic_in extent for the executions
                 * recorder (set in the matched block below). */
                const char* topic_in = NULL;
                size_t topic_in_len = 0;
                pthread_mutex_lock(&_pollen_wf_mutex);
                if (_pollen_wf_active && _pollen_wf_n_consumes > 0) {
                    const char* tp = _pollen_find(rbuf, line_len,
                                                    TOPIC_KEY, TOPIC_KEY_LEN);
                    int matched = 0;
                    if (tp) {
                        tp += TOPIC_KEY_LEN;
                        const char* tq = memchr(tp, '"',
                                                  line_len - (size_t)(tp - rbuf));
                        if (tq && _pollen_wf_topic_consumed(
                                tp, (size_t)(tq - tp))) {
                            matched = 1;
                            topic_in = tp;
                            topic_in_len = (size_t)(tq - tp);
                        }
                    }
                    if (matched) {
                        do_forward = 1;
                    } else {
                        do_ack = 0;
                    }
                }

                if (do_ack) {
                    const char* mp = _pollen_find(rbuf, line_len,
                                                    MID_KEY, MID_KEY_LEN);
                    if (mp) {
                        mp += MID_KEY_LEN;
                        const char* mq = memchr(mp, '"',
                                                  line_len - (size_t)(mp - rbuf));
                        if (mq) {
                            size_t midlen = (size_t)(mq - mp);
                            int64_t now = _pollen_now_ms_c();
                            int alen = snprintf(ack, sizeof(ack),
                                "{\"type\":\"ACK\",\"messageId\":\"%.*s\","
                                 "\"timestamp\":%lld}\n",
                                (int) midlen, mp, (long long) now);
                            if (alen > 0 && alen < (int) sizeof(ack)) {
                                ssize_t sent = 0;
                                int sock_dead = 0;
                                while (sent < alen) {
                                    ssize_t w = send(fd, ack + sent,
                                                     (size_t)(alen - sent),
                                                     MSG_NOSIGNAL);
                                    if (w <= 0) { sock_dead = 1; break; }
                                    sent += w;
                                }
                                if (sock_dead) {
                                    pthread_mutex_unlock(&_pollen_wf_mutex);
                                    goto worker_done;
                                }
                            }
                        }
                    }
                    if (do_forward) {
                        /* M2.4 — debug bridge. If the envelope carries
                         * a debug session + this role should pause,
                         * phone home to the manager + act on the reply.
                         * Produces the (possibly mutated / mode-rewritten)
                         * envelope to dispatch. proceed==0 → operator hit
                         * Cancel (or manager unreachable) → drop. */
                        char dbg_env[16384];
                        size_t dbg_len = 0;
                        int proceed = _pollen_debug_process(rbuf, line_len,
                            dbg_env, sizeof(dbg_env), &dbg_len);
                        if (proceed) {
                            /* Phase 6.2 — load metrics : count this hop +
                             * mark in-flight for the duration of dispatch. */
                            atomic_fetch_add(&_pollen_msgs_handled, 1);
                            atomic_fetch_add(&_pollen_inflight, 1);
                            const char* fenv = (dbg_len > 0) ? dbg_env : rbuf;
                            size_t flen = (dbg_len > 0) ? dbg_len : line_len;
                            /* v0.1.17 — Mosaic bridge transform. If an
                             * OnMessage handler is registered, hand it the
                             * consumed envelope ; it returns the new data
                             * JSON to forward ("" → drop the message). Runs
                             * on this worker thread (GC-registered) under
                             * the wf mutex, so the handler must NOT call
                             * Pollen.Forward (would re-lock + deadlock) —
                             * return data / use Publish instead. */
                            char hbuf[16384];
                            int do_dispatch = 1;
                            if (_pollen_on_message) {
                                char* env_gc = (char*) GC_MALLOC_ATOMIC(flen + 1);
                                if (env_gc) {
                                    memcpy(env_gc, fenv, flen);
                                    env_gc[flen] = 0;
                                    char* nd = (char*) AmalgameClosure_call1(
                                        _pollen_on_message, (void*) env_gc);
                                    if (nd && nd[0]) {
                                        size_t hn = _pollen_replace_data(
                                            fenv, flen, nd, hbuf, sizeof(hbuf));
                                        if (hn > 0) { fenv = hbuf; flen = hn; }
                                    } else if (nd) {
                                        do_dispatch = 0;  /* "" → drop */
                                    }
                                }
                            }
                            /* M2.3c.2 dispatch sequence :
                             *   1. apply pending set ops (mutates state.X
                             *      before the cond eval sees it),
                             *   2. dispatch priority :
                             *        while > for > cond > forward_all
                             * These route flags are mutually exclusive per
                             * node in the workflow-tree schema, but priority
                             * is safer than asserting exclusion. */
                            if (do_dispatch && _pollen_n_set_ops > 0) {
                                _pollen_set_ops_apply(fenv, flen);
                            }
                            char fwd_new_mid[37] = {0};
                            int n_nexts = _pollen_wf_n_nexts;
                            if (do_dispatch) {
                                if (_pollen_while_active) {
                                    _pollen_while_forward(fenv, flen, fwd_new_mid);
                                    n_nexts = 1;
                                } else if (_pollen_for_active) {
                                    _pollen_for_forward(fenv, flen, fwd_new_mid);
                                    n_nexts = _pollen_for_route.n_targets;
                                } else if (_pollen_cond_active && _pollen_cond_n_branches > 0) {
                                    _pollen_cond_forward(fenv, flen, fwd_new_mid);
                                    n_nexts = 1;
                                } else {
                                    _pollen_wf_forward_all(fenv, flen, fwd_new_mid);
                                }
                            }
                            /* M2.4b — record this hop for the manager's
                             * Live executions panel. Best-effort. */
                            if (fwd_new_mid[0] && _pollen_shared_dir[0]) {
                                /* incoming mid = parent of this hop */
                                const char* pmp = _pollen_find(fenv, flen,
                                                                 MID_KEY, MID_KEY_LEN);
                                const char* parent = NULL; size_t parent_len = 0;
                                if (pmp) {
                                    /* the incoming mid is the ORIGINAL
                                     * envelope's mid, but fenv may have
                                     * been rewritten (debug). use rbuf for
                                     * the true incoming mid. */
                                    const char* imp = _pollen_find(rbuf, line_len,
                                                                     MID_KEY, MID_KEY_LEN);
                                    if (imp) {
                                        imp += MID_KEY_LEN;
                                        const char* imq = memchr(imp, '"',
                                            line_len - (size_t)(imp - rbuf));
                                        if (imq) { parent = imp; parent_len = (size_t)(imq - imp); }
                                    }
                                }
                                /* debug session (optional) */
                                const char* dseg = _pollen_find(rbuf, line_len,
                                    "\"debug\":{\"session\":\"", 20);
                                const char* dsess = NULL; size_t dsess_len = 0;
                                if (dseg) {
                                    dsess = dseg + 20;
                                    const char* dq = memchr(dsess, '"',
                                        line_len - (size_t)(dsess - rbuf));
                                    if (dq) dsess_len = (size_t)(dq - dsess);
                                }
                                const char* tout = _pollen_wf_emit_topic[0]
                                                     ? _pollen_wf_emit_topic : NULL;
                                _pollen_wf_record_step(fwd_new_mid, 36,
                                    parent, parent_len,
                                    topic_in, topic_in_len,
                                    tout, n_nexts,
                                    dsess, dsess_len);
                            }
                            /* v0.1.17 — terminal node : this role has no
                             * downstream (leaf in the tree), so the
                             * execution ends here. If an OnComplete handler
                             * is set, hand it the final envelope (for an
                             * ingress node to resolve a pending HTTP reply
                             * by rootMessageId). */
                            if (do_dispatch && _pollen_on_complete
                                && _pollen_wf_n_nexts == 0
                                && !_pollen_cond_active
                                && !_pollen_for_active
                                && !_pollen_while_active) {
                                char* env_gc = (char*) GC_MALLOC_ATOMIC(flen + 1);
                                if (env_gc) {
                                    memcpy(env_gc, fenv, flen);
                                    env_gc[flen] = 0;
                                    AmalgameClosure_call1(_pollen_on_complete,
                                                          (void*) env_gc);
                                }
                            }
                            atomic_fetch_sub(&_pollen_inflight, 1);  /* Phase 6.2 */
                        }
                    }
                }
                pthread_mutex_unlock(&_pollen_wf_mutex);

                size_t consumed = line_len + 1;
                memmove(rbuf, rbuf + consumed, rlen - consumed);
                rlen -= consumed;
            }
        }
    worker_done:
        close(fd);
        return NULL;
    }

    static int _pollen_listen_simple(int port) {
        int srv = socket(AF_INET, SOCK_STREAM, 0);
        if (srv < 0) return -1;
        int one = 1;
        setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = htonl(INADDR_ANY);
        addr.sin_port = htons((uint16_t) port);
        if (bind(srv, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(srv); return -1;
        }
        if (listen(srv, 64) < 0) { close(srv); return -1; }
        for (;;) {
            int conn = accept(srv, NULL, NULL);
            if (conn < 0) continue;
            pthread_t th;
            if (GC_pthread_create(&th, NULL,
                                _pollen_listener_worker,
                                (void*)(intptr_t) conn) != 0) {
                close(conn); continue;
            }
            GC_pthread_detach(th);
        }
        /* unreachable until we add a shutdown path */
        close(srv);
        return 0;
    }

    static void
    Amalgame_Pollen_Pollen_StartListener_c(int64_t port) {
        (void) _pollen_listen_simple((int) port);
    }

    /* M2.4c / Phase 6.1 — capability writer. A detached thread that
     * rewrites <sharedDir>/capabilities/<instanceId>.json every 5s
     * with this node's identity + the topics it consumes (as
     * `actions`) + a fresh heartbeat. The manager's discovery panel
     * reads these + flags staleness (heartbeat > 15s old). Atomic
     * tmp+rename so a reader never sees a half-written file. */
    static void* _pollen_capability_writer(void* arg) {
        (void) arg;
        for (;;) {
            if (_pollen_shared_dir[0] && _pollen_cap_instance[0]) {
                char dir[600];
                snprintf(dir, sizeof(dir), "%s/capabilities", _pollen_shared_dir);
                mkdir(dir, 0755);

                /* actions[] from the consume list (snapshot under lock) */
                char actions[2048];
                size_t ao = 0;
                actions[0] = 0;
                pthread_mutex_lock(&_pollen_wf_mutex);
                for (int i = 0; i < _pollen_wf_n_consumes; i++) {
                    const char* t = _pollen_wf_consumes[i];
                    int wrote = snprintf(actions + ao, sizeof(actions) - ao,
                                         "%s\"%s\"", (i == 0 ? "" : ","), t);
                    if (wrote <= 0 || (size_t) wrote >= sizeof(actions) - ao) break;
                    ao += (size_t) wrote;
                }
                pthread_mutex_unlock(&_pollen_wf_mutex);

                int64_t now = _pollen_now_ms_c();
                long inflight = atomic_load(&_pollen_inflight);
                long handled  = atomic_load(&_pollen_msgs_handled);
                char buf[4096];
                int n = snprintf(buf, sizeof(buf),
                    "{\"instanceId\":\"%s\",\"host\":\"%s\",\"port\":%d,"
                     "\"label\":\"%s\",\"actions\":[%s],"
                     "\"load\":{\"inFlight\":%ld,\"msgsHandled\":%ld},"
                     "\"heartbeat\":%lld,\"version\":\"amalgame-pollen\"}\n",
                    _pollen_cap_instance, _pollen_self_host, _pollen_self_port,
                    _pollen_cap_label[0] ? _pollen_cap_label : _pollen_cap_instance,
                    actions, inflight, handled, (long long) now);
                if (n > 0 && n < (int) sizeof(buf)) {
                    char path[800], tmp[920];
                    snprintf(path, sizeof(path), "%s/%s.json", dir, _pollen_cap_instance);
                    snprintf(tmp, sizeof(tmp), "%s.tmp.%d", path, (int) getpid());
                    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
                    if (fd >= 0) {
                        ssize_t w = write(fd, buf, (size_t) n);
                        close(fd);
                        if (w == (ssize_t) n) { rename(tmp, path); }
                        else { unlink(tmp); }
                    }
                }
            }
            sleep(5);
        }
        return NULL;
    }

    static void
    Amalgame_Pollen_Pollen_StartCapabilityWriter_c(code_string label,
                                                     code_string host, int64_t port) {
        if (_pollen_cap_active) return;  /* idempotent */
        _pollen_gen_uuid(_pollen_cap_instance);
        if (label) {
            strncpy(_pollen_cap_label, (const char*) label, sizeof(_pollen_cap_label) - 1);
            _pollen_cap_label[sizeof(_pollen_cap_label) - 1] = 0;
        }
        if (host) {
            strncpy(_pollen_self_host, (const char*) host, sizeof(_pollen_self_host) - 1);
            _pollen_self_host[sizeof(_pollen_self_host) - 1] = 0;
        }
        if (port > 0) { _pollen_self_port = (int) port; }
        _pollen_cap_active = 1;
        pthread_t th;
        if (GC_pthread_create(&th, NULL, _pollen_capability_writer, NULL) == 0) {
            GC_pthread_detach(th);
        } else {
            _pollen_cap_active = 0;
        }
    }

    /* === Phase 6.2/6.3 — capability reader + LB resolver ====== */

    #include <dirent.h>

    /* Parse one capability file's JSON into a provider slot. Returns
     * 1 on success (host + port + ≥1 advertised action). */
    static int _pollen_reg_parse_one(const char* buf, size_t len,
                                       pollen_provider_t* p) {
        const char* v; size_t vlen;
        p->n_actions = 0; p->inflight = 0; p->heartbeat = 0;
        p->host[0] = 0; p->port = 0;

        if (_pollen_json_field(buf, len, "host", 4, &v, &vlen)
            && vlen >= 2 && *v == '"') {
            size_t hl = vlen - 2;
            if (hl >= sizeof(p->host)) hl = sizeof(p->host) - 1;
            memcpy(p->host, v + 1, hl); p->host[hl] = 0;
        }
        if (_pollen_json_field(buf, len, "port", 4, &v, &vlen)) {
            char tmp[16]; size_t cn = vlen < 15 ? vlen : 15;
            memcpy(tmp, v, cn); tmp[cn] = 0; p->port = atoi(tmp);
        }
        if (_pollen_json_field(buf, len, "heartbeat", 9, &v, &vlen)) {
            char tmp[24]; size_t cn = vlen < 23 ? vlen : 23;
            memcpy(tmp, v, cn); tmp[cn] = 0; p->heartbeat = (int64_t) atoll(tmp);
        }
        /* inFlight is nested under "load" but the key is unique. */
        {
            const char* k = _pollen_find(buf, len, "\"inFlight\":", 11);
            if (k) p->inflight = atol(k + 11);
        }
        if (_pollen_json_field(buf, len, "actions", 7, &v, &vlen)
            && vlen >= 2 && *v == '[') {
            const char* q = v + 1;
            const char* end = v + vlen - 1;
            while (q < end && p->n_actions < POLLEN_REG_ACTIONS_MAX) {
                while (q < end && (*q == ' ' || *q == ',' || *q == '\n'
                                   || *q == '\t' || *q == '\r')) q++;
                if (q >= end || *q != '"') break;
                q++;
                const char* s = q;
                while (q < end && *q != '"') {
                    if (*q == '\\' && q + 1 < end) q++;
                    q++;
                }
                size_t al = (size_t)(q - s);
                if (al >= POLLEN_TOPIC_MAX) al = POLLEN_TOPIC_MAX - 1;
                memcpy(p->actions[p->n_actions], s, al);
                p->actions[p->n_actions][al] = 0;
                p->n_actions++;
                if (q < end) q++;
            }
        }
        return (p->host[0] && p->port > 0 && p->n_actions > 0);
    }

    /* Reader thread : every 2s, scan the sharedDir capabilities dir,
     * parse + drop stale (heartbeat > POLLEN_REG_STALE_MS old), and
     * atomic-swap the in-memory registry under its own mutex. */
    static void* _pollen_capability_reader(void* arg) {
        (void) arg;
        for (;;) {
            if (_pollen_shared_dir[0]) {
                char dir[600];
                snprintf(dir, sizeof(dir), "%s/capabilities", _pollen_shared_dir);
                DIR* d = opendir(dir);
                if (d) {
                    pollen_provider_t tmp[POLLEN_REG_MAX];
                    int tn = 0;
                    int64_t now = _pollen_now_ms_c();
                    struct dirent* de;
                    while ((de = readdir(d)) != NULL && tn < POLLEN_REG_MAX) {
                        const char* nm = de->d_name;
                        size_t nl = strlen(nm);
                        if (nl < 6 || strcmp(nm + nl - 5, ".json") != 0) continue;
                        if (strstr(nm, ".tmp.")) continue;
                        char path[800];
                        snprintf(path, sizeof(path), "%s/%s", dir, nm);
                        int fd = open(path, O_RDONLY);
                        if (fd < 0) continue;
                        char fbuf[4096];
                        ssize_t fn = read(fd, fbuf, sizeof(fbuf) - 1);
                        close(fd);
                        if (fn <= 0) continue;
                        fbuf[fn] = 0;
                        pollen_provider_t p;
                        if (!_pollen_reg_parse_one(fbuf, (size_t) fn, &p)) continue;
                        if (now - p.heartbeat > POLLEN_REG_STALE_MS) continue;
                        tmp[tn++] = p;
                    }
                    closedir(d);
                    pthread_mutex_lock(&_pollen_reg_mutex);
                    if (tn > 0) memcpy(_pollen_reg, tmp,
                                       sizeof(pollen_provider_t) * (size_t) tn);
                    _pollen_reg_n = tn;
                    pthread_mutex_unlock(&_pollen_reg_mutex);
                }
            }
            usleep(2000 * 1000);  /* 2s */
        }
        return NULL;
    }

    /* Power-of-two-choices pick among live providers of `topic`.
     * Writes the winner's host/port ; returns 1 on success, 0 if no
     * provider advertises the topic. */
    static int _pollen_lb_pick(const char* topic, char* out_host,
                                 size_t host_cap, int* out_port) {
        if (!topic || !topic[0]) return 0;
        int cand[POLLEN_REG_MAX]; int nc = 0;
        pthread_mutex_lock(&_pollen_reg_mutex);
        for (int i = 0; i < _pollen_reg_n && nc < POLLEN_REG_MAX; i++) {
            for (int a = 0; a < _pollen_reg[i].n_actions; a++) {
                if (strcmp(_pollen_reg[i].actions[a], topic) == 0) {
                    cand[nc++] = i; break;
                }
            }
        }
        int chosen = -1;
        if (nc == 1) {
            chosen = cand[0];
        } else if (nc >= 2) {
            unsigned int r1 = 0, r2 = 0;
            getrandom(&r1, sizeof(r1), 0);
            getrandom(&r2, sizeof(r2), 0);
            int i1 = cand[r1 % (unsigned) nc];
            int i2 = cand[r2 % (unsigned) nc];
            if (i1 == i2) i2 = cand[(r2 % (unsigned) nc + 1) % (unsigned) nc];
            chosen = (_pollen_reg[i1].inflight <= _pollen_reg[i2].inflight)
                       ? i1 : i2;
        }
        int ok = 0;
        if (chosen >= 0) {
            strncpy(out_host, _pollen_reg[chosen].host, host_cap - 1);
            out_host[host_cap - 1] = 0;
            *out_port = _pollen_reg[chosen].port;
            ok = 1;
        }
        pthread_mutex_unlock(&_pollen_reg_mutex);
        return ok;
    }

    static void
    Amalgame_Pollen_Pollen_StartCapabilityReader_c(void) {
        if (_pollen_reader_active) return;  /* idempotent */
        _pollen_reader_active = 1;
        pthread_t th;
