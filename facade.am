// facade.am — public AM API for the amalgame-pollen package.
//
// v0.1.0-dev :  SKELETON with linkable STUBS. The actual engine
// migration from pollen/tools/pollen.am happens in M2-M3.
//
// Today the methods in this file return dummy values + log a
// warning ; the C symbols exist so consumers can `import
// Amalgame.Pollen` and compile without link errors.
//
// API mapping (target shape, partly stubbed today) :
//
//   CLI flag                   Package call
//   --workflow <path>          Pollen.WorkflowLoad(path, role, port)
//   --node-name <role>         (second arg)
//   --shared-dir <path>        Pollen.WorkflowSetSharedDir(path)
//   --publish host:port:t:v:d  Pollen.Publish(host, port, t, v, d)
//   (start listening)          Pollen.StartListener(port)
//
//   Mosaic embed :
//     public static HttpResponse POST(ctx: WebContext) {
//       let mid: string = Pollen.Publish("127.0.0.1", 8000,
//                                         "order.in", 1, ctx.Body)
//       return HttpResponse.New().Json(
//         "{\"messageId\":\"" + mid + "\"}")
//     }

namespace Amalgame.Pollen

@c {
    #include <stdio.h>
    #include <stdint.h>
    #include <stdlib.h>
    #include <string.h>
    #include <unistd.h>
    #include <fcntl.h>
    #include <sys/stat.h>
    #include <sys/types.h>
    #include <sys/socket.h>
    #include <sys/random.h>
    #include <netinet/in.h>
    #include <arpa/inet.h>
    #include <time.h>
    #include <gc.h>

    /* Singleton-per-process engine state. v0.1 carries flags only ;
     * M2-M3 will copy in the full runtime from pollen.am. */
    static int _pollen_pkg_loaded = 0;
    static char _pollen_pkg_role[64] = "";
    /* shared_dir uses the runtime-canonical name (no _pkg_ prefix) so
     * the M2.x state_persist code below ports verbatim from
     * the pollen runtime with zero diff. file-scope static — no link
     * collision with the legacy binary. */
    static char _pollen_shared_dir[512] = "";

    /* === M2.3c.1 — workflow runtime state ====================
     *
     * Storage populated by AM-side LoadWorkflow (or any consumer
     * that calls the WorkflowAddConsume / AddNext / SetEmitTopic
     * setters between WorkflowReloadBegin and WorkflowReloadCommit).
     * Hot path readers (listener_worker dispatch) take the same
     * mutex for the snapshot + forward window. */
    #include <pthread.h>

    #define POLLEN_MAX_CONSUMES 32
    #define POLLEN_MAX_NEXTS    32
    #define POLLEN_TOPIC_MAX    128
    #define POLLEN_HOST_MAX     64

    static int  _pollen_wf_active = 0;
    static int  _pollen_wf_n_consumes = 0;
    static int  _pollen_wf_n_nexts = 0;
    static char _pollen_wf_consumes[POLLEN_MAX_CONSUMES][POLLEN_TOPIC_MAX];
    static char _pollen_wf_next_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
    static int  _pollen_wf_next_port[POLLEN_MAX_NEXTS];
    static char _pollen_wf_emit_topic[POLLEN_TOPIC_MAX] = "";
    static pthread_mutex_t _pollen_wf_mutex = PTHREAD_MUTEX_INITIALIZER;
    static int  _pollen_wf_version = 0;

    /* M2.3c.2 — conditional routing storage. Same shape as the
     * workflow-tree Phase 5.2 / 5.4.1 design : a top-level list
     * of branches, each holding a raw cond_expr JSON + its target
     * list. cond_forward picks the first branch whose cond_eval
     * passes (matched evaluator from M2.2 — see _pollen_cond_eval_expr). */
    #define POLLEN_COND_MAX_BRANCHES 8
    #define POLLEN_COND_EXPR_MAX     1024

    typedef struct {
        char cond_expr[POLLEN_COND_EXPR_MAX];
        char targets_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  targets_port[POLLEN_MAX_NEXTS];
        int  n_targets;
    } pollen_cond_branch_t;

    static int                  _pollen_cond_active = 0;
    static int                  _pollen_cond_n_branches = 0;
    static int                  _pollen_cond_current = -1;
    static pollen_cond_branch_t _pollen_cond_branches[POLLEN_COND_MAX_BRANCHES];

    /* M2.3c.2 — set-op storage (Phase 5.3 `set state.X` ops).
     * AM-side loader registers pairs (path, value_expr) ; the
     * apply pass at message time walks the list, eval_expr each
     * value against the envelope, persists via _pollen_state_set. */
    #define POLLEN_SET_OPS_MAX 8

    /* POLLEN_COND_VAR_MAX is also referenced by the cond-eval block
     * later in this TU ; both must agree on the size. The eval-side
     * definition is guarded with #ifndef so it's a no-op. */
    #define POLLEN_COND_VAR_MAX  64

    typedef struct {
        char path[POLLEN_COND_VAR_MAX];
        char value_expr[1024];
    } pollen_set_op_t;

    static int             _pollen_n_set_ops = 0;
    static pollen_set_op_t _pollen_set_ops[POLLEN_SET_OPS_MAX];

    /* M2.3c.2b — for / while route storage (Phase 5.4). Mirrors
     * the workflow-tree runtime : a for loop is a finite item list
     * that gets fanned out to a target set ; a while loop is a
     * self-loop bounded by maxIter + a JSON cond evaluated each
     * iteration. Both maintain iter / item state via the same
     * state.X persist machinery as the set ops. */
    #define POLLEN_FOR_MAX_ITEMS 32
    #define POLLEN_FOR_ITEM_MAX  256

    typedef struct {
        char items[POLLEN_FOR_MAX_ITEMS][POLLEN_FOR_ITEM_MAX];
        int  n_items;
        char item_var[POLLEN_COND_VAR_MAX];
        char target_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  target_port[POLLEN_MAX_NEXTS];
        int  n_targets;
    } pollen_for_route_t;

    static int                _pollen_for_active = 0;
    static pollen_for_route_t _pollen_for_route;

    typedef struct {
        char cond_expr[POLLEN_COND_EXPR_MAX];
        char iter_state_key[POLLEN_COND_VAR_MAX];
        int  max_iter;
        char loop_host[POLLEN_HOST_MAX];
        int  loop_port;
        char exit_host[POLLEN_MAX_NEXTS][POLLEN_HOST_MAX];
        int  exit_port[POLLEN_MAX_NEXTS];
        int  n_exits;
    } pollen_while_route_t;

    static int                  _pollen_while_active = 0;
    static pollen_while_route_t _pollen_while_route;

    static const char _pollen_pkg_unimpl_warning[] =
        "amalgame-pollen v0.1.0-dev : %s is a stub. "
        "M2-M3 migration from pollen.am in progress.\n";

    /* Forward declarations — order in this TU is one-shot @c so a
     * helper used before its definition needs hoisting. */
    static int64_t _pollen_now_ms_c(void);
    static void    _pollen_gen_uuid(char* buf);
    static void    _pollen_cond_clear(void);
    static void    _pollen_set_ops_clear(void);
    static void    _pollen_for_clear(void);
    static void    _pollen_while_clear(void);
    static void    _pollen_wf_forward_one(const char* host, int port,
                                            const char* envelope, size_t env_len);
    static size_t  _pollen_wf_rebuild_envelope(
                       const char* in, size_t in_len,
                       char* out, size_t out_cap,
                       const char* new_topic,
                       char* out_new_mid);
    static void    _pollen_for_forward(const char* env, size_t env_len);
    static void    _pollen_while_forward(const char* env, size_t env_len);

    /* Portable substring search — memmem is glibc-only and _GNU_SOURCE
     * has to be defined before any system header which is hard to
     * guarantee from inside an amc @c block. Naive O(h × n) is fine
     * for our short needles scanning <8 KiB state files. */
    static const char* _pollen_find(const char* hay, size_t hlen,
                                     const char* needle, size_t nlen) {
        if (nlen == 0 || hlen < nlen) return NULL;
        const char* end = hay + hlen - nlen;
        for (const char* p = hay; p <= end; p++) {
            if (memcmp(p, needle, nlen) == 0) return p;
        }
        return NULL;
    }

    /* === Workflow lifecycle =================================== */
    static code_bool
    Amalgame_Pollen_Pollen_WorkflowLoad_c(code_string path, code_string nodeName,
                                            int64_t actualPort) {
        fprintf(stderr, _pollen_pkg_unimpl_warning, "WorkflowLoad");
        (void) path; (void) nodeName; (void) actualPort;
        return (code_bool) 0;
    }

    static void
    Amalgame_Pollen_Pollen_WorkflowSetSharedDir_c(code_string path) {
        if (!path) return;
        strncpy(_pollen_shared_dir, path,
                 sizeof(_pollen_shared_dir) - 1);
        _pollen_shared_dir[sizeof(_pollen_shared_dir) - 1] = 0;
        /* best-effort create — EEXIST ok ; sub-dirs (state/, executions/)
         * are created lazily by their respective writers. */
        mkdir(_pollen_shared_dir, 0755);
    }

    static void
    Amalgame_Pollen_Pollen_WorkflowSetSelf_c(code_string role, code_string host,
                                               int64_t port) {
        if (role) {
            strncpy(_pollen_pkg_role, role, sizeof(_pollen_pkg_role) - 1);
            _pollen_pkg_role[sizeof(_pollen_pkg_role) - 1] = 0;
        }
        (void) host; (void) port;
    }

    /* === Phase 5.3 — per-execution state file =================
     *
     * Migrated verbatim from the pollen runtime v0.2.x (workflow-tree
     * Phase 5.3 commit 7854bef). Each `rootMessageId` gets a JSON
     * object stored under `<sharedDir>/state/<rootMid>.json`. Writes
     * go through tmp + rename for crash safety ; reads slurp the
     * whole file (capped at POLLEN_STATE_FILE_MAX). `state.X`
     * lookups in conditions read it back.
     */
    #define POLLEN_STATE_FILE_MAX 8192

    static int _pollen_state_filepath(const char* root_mid,
                                       char* out, size_t cap) {
        if (!_pollen_shared_dir[0] || !root_mid || !root_mid[0]) return 0;
        int n = snprintf(out, cap, "%s/state/%s.json",
                          _pollen_shared_dir, root_mid);
        return (n > 0 && n < (int) cap);
    }

    static void _pollen_state_dir_ensure(void) {
        if (!_pollen_shared_dir[0]) return;
        char d[600];
        snprintf(d, sizeof(d), "%s/state", _pollen_shared_dir);
        mkdir(d, 0755);
    }

    static int _pollen_state_read(const char* root_mid,
                                    char* buf, size_t cap) {
        char path[1024];
        if (!_pollen_state_filepath(root_mid, path, sizeof(path))) return -1;
        int fd = open(path, O_RDONLY);
        if (fd < 0) return -1;
        ssize_t n = read(fd, buf, cap - 1);
        close(fd);
        if (n <= 0) return -1;
        buf[n] = 0;
        return (int) n;
    }

    static int _pollen_state_write(const char* root_mid,
                                     const char* buf, size_t len) {
        char path[1024], tmp[1100];
        if (!_pollen_state_filepath(root_mid, path, sizeof(path))) return 0;
        _pollen_state_dir_ensure();
        snprintf(tmp, sizeof(tmp), "%s.tmp.%d", path, (int) getpid());
        int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (fd < 0) return 0;
        ssize_t w = write(fd, buf, len);
        close(fd);
        if (w != (ssize_t) len) { unlink(tmp); return 0; }
        if (rename(tmp, path) != 0) { unlink(tmp); return 0; }
        return 1;
    }

    /* Locate the value extent for `"key":` inside a state buffer.
     * Returns 1 on success and writes the value start + length to
     * *out_v / *out_vlen. Strings, objects/arrays, and bare literals
     * (number/true/false/null) are all handled. */
    static int _pollen_state_find_value(const char* buf, int blen,
                                         const char* key,
                                         const char** out_v,
                                         size_t* out_vlen) {
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle), "\"%s\":", key);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return 0;
        const char* found = _pollen_find(buf, (size_t) blen,
                                          needle, (size_t) nlen);
        if (!found) return 0;
        const char* v = found + nlen;
        const char* v_end = v;
        if (*v == '"') {
            v_end = v + 1;
            while (v_end < buf + blen && *v_end != '"') {
                if (*v_end == '\\' && v_end + 1 < buf + blen) v_end++;
                v_end++;
            }
            if (v_end < buf + blen) v_end++;
        } else if (*v == '{' || *v == '[') {
            char open = *v; char close = (open == '{') ? '}' : ']';
            int depth = 0;
            v_end = v;
            while (v_end < buf + blen) {
                if (*v_end == open) depth++;
                else if (*v_end == close) {
                    depth--;
                    if (depth == 0) { v_end++; break; }
                }
                v_end++;
            }
        } else {
            while (v_end < buf + blen
                   && *v_end != ',' && *v_end != '}'
                   && *v_end != ' ' && *v_end != '\n'
                   && *v_end != '\r' && *v_end != '\t') v_end++;
        }
        *out_v = v;
        *out_vlen = (size_t)(v_end - v);
        return 1;
    }

    /* Mutate a single top-level key in the per-execution state file.
     * value_lit is a JSON literal (number, quoted string, true, false,
     * null). For now only top-level keys are supported — `state.X.Y`
     * is treated as a single key name with a literal dot in it,
     * which works but doesn't compose with cond eval's dotted
     * resolution. Phase 5.3.1 will handle nested set. */
    static int _pollen_state_set(const char* root_mid,
                                   const char* path,
                                   const char* json_literal) {
        const char* key = path;
        if (strncmp(key, "state.", 6) == 0) key += 6;
        if (!key[0]) return 0;

        char old_buf[POLLEN_STATE_FILE_MAX];
        int old_n = _pollen_state_read(root_mid, old_buf, sizeof(old_buf));

        char new_buf[POLLEN_STATE_FILE_MAX];
        int n = 0;

        if (old_n <= 0) {
            n = snprintf(new_buf, sizeof(new_buf),
                          "{\"%s\":%s}\n", key, json_literal);
        } else {
            const char* v = NULL;
            size_t vlen = 0;
            if (_pollen_state_find_value(old_buf, old_n, key, &v, &vlen)) {
                const char* v_end = v + vlen;
                int prefix_n = (int)(v - old_buf);
                int suffix_n = old_n - (int)(v_end - old_buf);
                n = snprintf(new_buf, sizeof(new_buf), "%.*s%s%.*s",
                              prefix_n, old_buf, json_literal,
                              suffix_n, v_end);
            } else {
                int close_at = -1;
                for (int i = old_n - 1; i >= 0; i--) {
                    if (old_buf[i] == '}') { close_at = i; break; }
                }
                if (close_at < 0) return 0;
                int has_fields = 0;
                for (int i = 0; i < close_at; i++) {
                    char c = old_buf[i];
                    if (c == ':') { has_fields = 1; break; }
                }
                const char* sep = has_fields ? "," : "";
                n = snprintf(new_buf, sizeof(new_buf),
                              "%.*s%s\"%s\":%s%.*s",
                              close_at, old_buf, sep, key, json_literal,
                              old_n - close_at, old_buf + close_at);
            }
        }

        if (n <= 0 || n >= (int) sizeof(new_buf)) return 0;
        return _pollen_state_write(root_mid, new_buf, (size_t) n);
    }

    /* Extract rootMessageId from a MESSAGE envelope. Returns 1 on
     * success. Used by the workflow dispatcher in M2.3 — exposed
     * here as part of the state_persist module since it's the
     * inverse of "which state file do I touch". */
    static int _pollen_extract_root_mid(const char* env, size_t env_len,
                                          char* out, size_t cap) {
        const char* k = _pollen_find(env, env_len,
                                       "\"rootMessageId\":\"", 17);
        if (!k) return 0;
        const char* v = k + 17;
        const char* q = memchr(v, '"', env_len - (size_t)(v - env));
        if (!q) return 0;
        size_t rlen = (size_t)(q - v);
        if (rlen == 0 || rlen >= cap) return 0;
        memcpy(out, v, rlen); out[rlen] = 0;
        return 1;
    }

    /* Public facade for state read by key path. Returns a GC-owned
     * string containing the raw JSON literal (number / quoted-string
     * / object / array / true / false / null). Returns "" if the
     * sharedDir isn't set, the state file doesn't exist, or the key
     * isn't present. */
    static code_string
    Amalgame_Pollen_Pollen_StateGet_c(code_string rootMid, code_string path) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!rootMid || !path) return (code_string) empty;
        const char* key = (const char*) path;
        if (strncmp(key, "state.", 6) == 0) key += 6;
        if (!key[0]) return (code_string) empty;

        char buf[POLLEN_STATE_FILE_MAX];
        int n = _pollen_state_read((const char*) rootMid, buf, sizeof(buf));
        if (n <= 0) return (code_string) empty;

        const char* v = NULL;
        size_t vlen = 0;
        if (!_pollen_state_find_value(buf, n, key, &v, &vlen)) {
            return (code_string) empty;
        }
        char* out = (char*) GC_MALLOC_ATOMIC(vlen + 1);
        if (!out) return (code_string) empty;
        memcpy(out, v, vlen);
        out[vlen] = 0;
        return (code_string) out;
    }

    static code_bool
    Amalgame_Pollen_Pollen_StateSet_c(code_string rootMid, code_string path,
                                       code_string jsonLiteral) {
        if (!rootMid || !path || !jsonLiteral) return (code_bool) 0;
        int ok = _pollen_state_set((const char*) rootMid,
                                     (const char*) path,
                                     (const char*) jsonLiteral);
        return (code_bool) (ok ? 1 : 0);
    }

    /* === M2.2 — expr / cond evaluator (workflow-tree Phase 5.2-6.0a)
     *
     * Migrated verbatim from the pollen runtime. Two evaluators :
     *
     *   _pollen_eval_expr      — set.value walker for arithmetic
     *                            ({const, var, op:+|-|*|/}). Numeric
     *                            results bubble as double, strings
     *                            pass through ; arithmetic on strings
     *                            returns 0.
     *
     *   _pollen_cond_eval_expr — recursive cond walker for `if` :
     *                            leaf (==, !=, <, >, <=, >=),
     *                            composite (and/or/not),
     *                            membership (in / not_in).
     *
     * Both walk raw JSON via `_pollen_json_field` + `_pollen_find` ;
     * `var` paths resolve through `_pollen_resolve_path` against
     * either the envelope (data.X) or the per-execution state file
     * (state.X). 1 KiB expr budget is enough for realistic
     * conditions ; deeper nests can be lifted in v0.2.
     */
    /* POLLEN_COND_VAR_MAX already defined in the M2.3c.2 workflow
     * storage block at the top of this TU. Re-declare for symmetry
     * with the source — guarded so we don't redefine. */
    #ifndef POLLEN_COND_VAR_MAX
    #define POLLEN_COND_VAR_MAX  64
    #endif
    #define POLLEN_COND_STR_MAX  128

    /* op codes used by _pollen_cond_eval_leaf — must stay stable, the
     * dispatcher M2.3 will populate branches with these. */
    #define POLLEN_COND_NONE 0
    #define POLLEN_COND_EQ   1
    #define POLLEN_COND_NE   2
    #define POLLEN_COND_LT   3
    #define POLLEN_COND_GT   4
    #define POLLEN_COND_LE   5
    #define POLLEN_COND_GE   6

    /* Walk a dotted path through a JSON range. Brace + string aware. */
    static int _pollen_resolve_path(const char* env, size_t env_len,
                                     const char* path,
                                     const char** out_val, size_t* out_len) {
        const char* range_lo = env;
        const char* range_hi = env + env_len;
        const char* p = path;
        for (;;) {
            const char* dot = strchr(p, '.');
            char seg[POLLEN_COND_VAR_MAX];
            size_t seglen = dot ? (size_t)(dot - p) : strlen(p);
            if (seglen == 0 || seglen + 4 >= sizeof(seg)) return 0;
            seg[0] = '"';
            memcpy(seg + 1, p, seglen);
            seg[1 + seglen] = '"';
            seg[2 + seglen] = ':';
            int needle_len = (int)(seglen + 3);

            const char* k = _pollen_find(range_lo,
                                          (size_t)(range_hi - range_lo),
                                          seg, (size_t) needle_len);
            if (!k) return 0;
            const char* v = k + needle_len;
            while (v < range_hi && (*v == ' ' || *v == '\t')) v++;
            if (v >= range_hi) return 0;

            int is_last = (dot == NULL);
            if (!is_last) {
                if (*v != '{') return 0;
                int depth = 1;
                const char* w = v + 1;
                int in_str = 0;
                while (w < range_hi && depth > 0) {
                    char c = *w;
                    if (in_str) {
                        if (c == '\\' && w + 1 < range_hi) { w += 2; continue; }
                        if (c == '"') in_str = 0;
                    } else {
                        if (c == '"') in_str = 1;
                        else if (c == '{') depth++;
                        else if (c == '}') depth--;
                    }
                    w++;
                }
                if (depth != 0) return 0;
                range_lo = v + 1;
                range_hi = w - 1;
                p = dot + 1;
                continue;
            }

            if (*v == '"') {
                const char* q = v + 1;
                while (q < range_hi) {
                    if (*q == '\\' && q + 1 < range_hi) { q += 2; continue; }
                    if (*q == '"') break;
                    q++;
                }
                if (q >= range_hi) return 0;
                *out_val = v;
                *out_len = (size_t)(q - v) + 1;
                return 1;
            }
            const char* q = v;
            while (q < range_hi
                   && *q != ',' && *q != '}' && *q != ']'
                   && *q != ' ' && *q != '\t' && *q != '\n' && *q != '\r') {
                q++;
            }
            *out_val = v;
            *out_len = (size_t)(q - v);
            return 1;
        }
    }

    /* Locate "key":<value> inside a JSON object, returning the raw
     * value extent. Brace + bracket + string aware. */
    static int _pollen_json_field(const char* buf, size_t len,
                                    const char* key, int klen,
                                    const char** out_v, size_t* out_vlen) {
        char needle[80];
        int nlen = snprintf(needle, sizeof(needle), "\"%.*s\":", klen, key);
        if (nlen <= 0 || nlen >= (int) sizeof(needle)) return 0;
        const char* k = _pollen_find(buf, len, needle, (size_t) nlen);
        if (!k) return 0;
        const char* v = k + nlen;
        while (v < buf + len && (*v == ' ' || *v == '\t')) v++;
        if (v >= buf + len) return 0;
        const char* e = v;
        if (*v == '"') {
            e = v + 1;
            while (e < buf + len) {
                if (*e == '\\' && e + 1 < buf + len) { e += 2; continue; }
                if (*e == '"') { e++; break; }
                e++;
            }
        } else if (*v == '{' || *v == '[') {
            char open = *v; char close = (open == '{') ? '}' : ']';
            int depth = 0;
            int in_str = 0;
            e = v;
            while (e < buf + len) {
                char c = *e;
                if (in_str) {
                    if (c == '\\' && e + 1 < buf + len) { e += 2; continue; }
                    if (c == '"') in_str = 0;
                } else {
                    if (c == '"') in_str = 1;
                    else if (c == open) depth++;
                    else if (c == close) {
                        depth--;
                        if (depth == 0) { e++; break; }
                    }
                }
                e++;
            }
        } else {
            while (e < buf + len && *e != ',' && *e != '}' && *e != ']'
                   && *e != ' ' && *e != '\n' && *e != '\r' && *e != '\t') e++;
        }
        *out_v = v;
        *out_vlen = (size_t)(e - v);
        return 1;
    }

    /* First key of a JSON object — disambiguates the dispatch. */
    static int _pollen_expr_outer_key(const char* expr, size_t expr_len,
                                        char* out_key, size_t cap) {
        const char* e = expr;
        const char* end = expr + expr_len;
        while (e < end && (*e == ' ' || *e == '\t' || *e == '\n' || *e == '\r')) e++;
        if (e >= end || *e != '{') return 0;
        e++;
        while (e < end && (*e == ' ' || *e == '\t' || *e == '\n' || *e == '\r')) e++;
        if (e >= end || *e != '"') return 0;
        e++;
        const char* k0 = e;
        while (e < end && *e != '"') {
            if (*e == '\\' && e + 1 < end) { e += 2; continue; }
            e++;
        }
        if (e >= end) return 0;
        size_t klen = (size_t)(e - k0);
        if (klen == 0 || klen >= cap) return 0;
        memcpy(out_key, k0, klen);
        out_key[klen] = 0;
        return 1;
    }

    typedef struct {
        int    is_num;
        double num;
        char   str[128];
    } _pollen_expr_val_t;

    static int _pollen_eval_expr(const char* env, size_t env_len,
                                   const char* expr, size_t expr_len,
                                   _pollen_expr_val_t* out) {
        out->is_num = 0;
        out->num = 0;
        out->str[0] = 0;
        const char* v; size_t vlen;

        char outer_key[16];
        if (!_pollen_expr_outer_key(expr, expr_len, outer_key, sizeof(outer_key))) {
            return 0;
        }

        if (strcmp(outer_key, "const") == 0
            && _pollen_json_field(expr, expr_len, "const", 5, &v, &vlen)) {
            if (vlen == 0) return 0;
            if (*v == '"') {
                size_t slen = vlen >= 2 ? vlen - 2 : 0;
                if (slen >= sizeof(out->str)) slen = sizeof(out->str) - 1;
                memcpy(out->str, v + 1, slen);
                out->str[slen] = 0;
                out->is_num = 0;
            } else {
                char tmp[64];
                size_t cn = vlen < sizeof(tmp) - 1 ? vlen : sizeof(tmp) - 1;
                memcpy(tmp, v, cn); tmp[cn] = 0;
                out->num = atof(tmp);
                out->is_num = 1;
            }
            return 1;
        }

        if (strcmp(outer_key, "var") == 0
            && _pollen_json_field(expr, expr_len, "var", 3, &v, &vlen)) {
            if (vlen < 2 || *v != '"') return 0;
            char path[POLLEN_COND_VAR_MAX];
            size_t plen = vlen - 2;
            if (plen >= sizeof(path)) plen = sizeof(path) - 1;
            memcpy(path, v + 1, plen); path[plen] = 0;

            const char* lookup_buf = env;
            size_t lookup_len = env_len;
            const char* lookup_path = path;
            char state_buf[POLLEN_STATE_FILE_MAX];
            if (strncmp(path, "state.", 6) == 0) {
                char root[64];
                if (!env || !_pollen_extract_root_mid(env, env_len,
                                                        root, sizeof(root))) {
                    out->is_num = 1; out->num = 0;
                    return 1;
                }
                int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
                if (sn <= 0) {
                    out->is_num = 1; out->num = 0;
                    return 1;
                }
                lookup_buf = state_buf;
                lookup_len = (size_t) sn;
                lookup_path = path + 6;
            }
            const char* vp; size_t vl;
            if (!_pollen_resolve_path(lookup_buf, lookup_len,
                                        lookup_path, &vp, &vl)) {
                out->is_num = 1; out->num = 0;
                return 1;
            }
            if (*vp == '"') {
                size_t slen = vl >= 2 ? vl - 2 : 0;
                if (slen >= sizeof(out->str)) slen = sizeof(out->str) - 1;
                memcpy(out->str, vp + 1, slen); out->str[slen] = 0;
                out->is_num = 0;
            } else {
                char tmp[64];
                size_t cn = vl < sizeof(tmp) - 1 ? vl : sizeof(tmp) - 1;
                memcpy(tmp, vp, cn); tmp[cn] = 0;
                out->num = atof(tmp);
                out->is_num = 1;
            }
            return 1;
        }

        if (strcmp(outer_key, "op") == 0
            && _pollen_json_field(expr, expr_len, "op", 2, &v, &vlen)) {
            if (vlen < 2 || *v != '"') return 0;
            char op[16];
            size_t olen = vlen - 2;
            if (olen >= sizeof(op)) return 0;
            memcpy(op, v + 1, olen); op[olen] = 0;

            const char* lv; size_t llen;
            const char* rv; size_t rlen;
            if (!_pollen_json_field(expr, expr_len, "left", 4,
                                      &lv, &llen)) return 0;
            if (!_pollen_json_field(expr, expr_len, "right", 5,
                                      &rv, &rlen)) return 0;
            _pollen_expr_val_t lvv, rvv;
            if (!_pollen_eval_expr(env, env_len, lv, llen, &lvv)) return 0;
            if (!_pollen_eval_expr(env, env_len, rv, rlen, &rvv)) return 0;
            if (!lvv.is_num || !rvv.is_num) return 0;
            out->is_num = 1;
            if      (strcmp(op, "+") == 0) out->num = lvv.num + rvv.num;
            else if (strcmp(op, "-") == 0) out->num = lvv.num - rvv.num;
            else if (strcmp(op, "*") == 0) out->num = lvv.num * rvv.num;
            else if (strcmp(op, "/") == 0) out->num = (rvv.num == 0) ? 0 : lvv.num / rvv.num;
            else return 0;
            return 1;
        }

        return 0;
    }

    static int _pollen_expr_val_to_literal(_pollen_expr_val_t* v,
                                             char* out, size_t cap) {
        if (v->is_num) {
            double rounded = (double)(long long) v->num;
            if (rounded == v->num
                && v->num >= -9.2e18 && v->num <= 9.2e18) {
                return snprintf(out, cap, "%lld", (long long) v->num);
            }
            return snprintf(out, cap, "%g", v->num);
        }
        return snprintf(out, cap, "\"%s\"", v->str);
    }

    /* Leaf comparison — resolves a var path, parses value extent,
     * applies op. Shared between the leaf-op cond walker and the
     * composite walker. */
    static int _pollen_cond_eval_leaf(const char* env, size_t env_len,
                                        const char* var_path,
                                        int op_code,
                                        int rhs_is_num,
                                        double rhs_num,
                                        const char* rhs_str) {
        if (op_code == POLLEN_COND_NONE) return 1;
        const char* lookup_buf = env;
        size_t lookup_len = env_len;
        const char* lookup_path = var_path;
        char state_buf[POLLEN_STATE_FILE_MAX];
        if (strncmp(var_path, "state.", 6) == 0) {
            char root[64];
            if (!_pollen_extract_root_mid(env, env_len,
                                            root, sizeof(root))) return 0;
            int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
            if (sn <= 0) return 0;
            lookup_buf = state_buf;
            lookup_len = (size_t) sn;
            lookup_path = var_path + 6;
        }
        const char* val_ptr = NULL;
        size_t val_len = 0;
        if (!_pollen_resolve_path(lookup_buf, lookup_len, lookup_path,
                                    &val_ptr, &val_len)) return 0;
        const char* v = val_ptr;
        const char* v_end = val_ptr + val_len;
        if (v >= v_end) return 0;
        double v_num = 0; int v_is_num = 0;
        char v_str[128] = "";
        if (*v == '"') {
            const char* q = v_end - 1;
            if (q <= v) return 0;
            size_t slen = (size_t)(q - v - 1);
            if (slen >= sizeof(v_str)) slen = sizeof(v_str) - 1;
            memcpy(v_str, v + 1, slen);
            v_str[slen] = 0;
        } else if ((*v >= '0' && *v <= '9') || *v == '-' || *v == '+' || *v == '.') {
            char tmp[64];
            size_t cn = val_len < sizeof(tmp) - 1 ? val_len : sizeof(tmp) - 1;
            memcpy(tmp, v, cn); tmp[cn] = 0;
            v_num = atof(tmp);
            v_is_num = 1;
        } else if (val_len == 4 && memcmp(v, "true", 4) == 0) {
            strcpy(v_str, "true");
        } else if (val_len == 5 && memcmp(v, "false", 5) == 0) {
            strcpy(v_str, "false");
        } else if (val_len == 4 && memcmp(v, "null", 4) == 0) {
            strcpy(v_str, "null");
        } else {
            return 0;
        }
        if (rhs_is_num && v_is_num) {
            double d = v_num - rhs_num;
            switch (op_code) {
                case POLLEN_COND_EQ: return d == 0;
                case POLLEN_COND_NE: return d != 0;
                case POLLEN_COND_LT: return d <  0;
                case POLLEN_COND_GT: return d >  0;
                case POLLEN_COND_LE: return d <= 0;
                case POLLEN_COND_GE: return d >= 0;
            }
        } else if (!rhs_is_num) {
            int c = strcmp(v_str, rhs_str);
            switch (op_code) {
                case POLLEN_COND_EQ: return c == 0;
                case POLLEN_COND_NE: return c != 0;
                case POLLEN_COND_LT: return c <  0;
                case POLLEN_COND_GT: return c >  0;
                case POLLEN_COND_LE: return c <= 0;
                case POLLEN_COND_GE: return c >= 0;
            }
        }
        return 0;
    }

    /* Recursive cond eval over raw JSON. Empty expr → true (else
     * branch). Composite forms : op:and|or|not, op:in|not_in. */
    static int _pollen_cond_eval_expr(const char* env, size_t env_len,
                                        const char* expr, size_t expr_len) {
        if (expr_len == 0) return 1;
        char outer_key[16];
        if (!_pollen_expr_outer_key(expr, expr_len,
                                      outer_key, sizeof(outer_key))) return 0;
        if (strcmp(outer_key, "op") != 0) return 0;

        const char* opv; size_t op_len;
        if (!_pollen_json_field(expr, expr_len, "op", 2, &opv, &op_len)) return 0;
        if (op_len < 2 || *opv != '"') return 0;
        char op[16];
        size_t olen = op_len - 2;
        if (olen >= sizeof(op)) return 0;
        memcpy(op, opv + 1, olen); op[olen] = 0;

        if (strcmp(op, "and") == 0 || strcmp(op, "or") == 0) {
            const char* args; size_t args_len;
            if (!_pollen_json_field(expr, expr_len, "args", 4,
                                      &args, &args_len)) return 0;
            if (args_len < 2 || *args != '[') return 0;
            int is_and = (op[0] == 'a');
            const char* p = args + 1;
            const char* end = args + args_len - 1;
            while (p < end) {
                while (p < end && (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n')) p++;
                if (p >= end) break;
                if (*p != '{') break;
                const char* sp = p;
                int depth = 1; int in_str = 0;
                p++;
                while (p < end && depth > 0) {
                    if (in_str) {
                        if (*p == '\\' && p + 1 < end) { p += 2; continue; }
                        if (*p == '"') in_str = 0;
                    } else {
                        if (*p == '"') in_str = 1;
                        else if (*p == '{') depth++;
                        else if (*p == '}') depth--;
                    }
                    p++;
                }
                int sub_pass = _pollen_cond_eval_expr(env, env_len,
                                                       sp, (size_t)(p - sp));
                if (is_and && !sub_pass) return 0;
                if (!is_and && sub_pass) return 1;
            }
            return is_and ? 1 : 0;
        }

        if (strcmp(op, "not") == 0) {
            const char* arg; size_t arg_len;
            if (!_pollen_json_field(expr, expr_len, "arg", 3,
                                      &arg, &arg_len)) return 0;
            return !_pollen_cond_eval_expr(env, env_len, arg, arg_len);
        }

        if (strcmp(op, "in") == 0 || strcmp(op, "not_in") == 0) {
            int negate = (op[0] == 'n');
            const char* varTok; size_t varTokLen;
            if (!_pollen_json_field(expr, expr_len, "var", 3,
                                      &varTok, &varTokLen)) return 0;
            if (varTokLen < 2 || *varTok != '"') return 0;
            char vpath[POLLEN_COND_VAR_MAX];
            size_t vplen = varTokLen - 2;
            if (vplen >= sizeof(vpath)) vplen = sizeof(vpath) - 1;
            memcpy(vpath, varTok + 1, vplen); vpath[vplen] = 0;

            const char* lookup_buf = env;
            size_t lookup_len = env_len;
            const char* lookup_path = vpath;
            char state_buf[POLLEN_STATE_FILE_MAX];
            if (strncmp(vpath, "state.", 6) == 0) {
                char root[64];
                if (!_pollen_extract_root_mid(env, env_len,
                                                root, sizeof(root))) return 0;
                int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
                if (sn <= 0) return 0;
                lookup_buf = state_buf;
                lookup_len = (size_t) sn;
                lookup_path = vpath + 6;
            }
            const char* val_ptr; size_t val_len;
            if (!_pollen_resolve_path(lookup_buf, lookup_len,
                                        lookup_path, &val_ptr, &val_len)) {
                return negate ? 1 : 0;
            }

            char v_str[128]; v_str[0] = 0;
            if (val_len > 0 && *val_ptr == '"') {
                size_t slen = val_len >= 2 ? val_len - 2 : 0;
                if (slen >= sizeof(v_str)) slen = sizeof(v_str) - 1;
                memcpy(v_str, val_ptr + 1, slen);
                v_str[slen] = 0;
            } else {
                size_t cn = val_len < sizeof(v_str) - 1 ? val_len : sizeof(v_str) - 1;
                memcpy(v_str, val_ptr, cn); v_str[cn] = 0;
            }

            const char* values; size_t values_len;
            if (!_pollen_json_field(expr, expr_len, "values", 6,
                                      &values, &values_len)) return 0;
            if (values_len < 2 || *values != '[') return 0;
            const char* p = values + 1;
            const char* end = values + values_len - 1;
            int found = 0;
            while (p < end) {
                while (p < end && (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n')) p++;
                if (p >= end) break;
                const char* tok = p;
                char tok_buf[128]; tok_buf[0] = 0;
                if (*p == '"') {
                    p++;
                    const char* q = p;
                    while (q < end && *q != '"') {
                        if (*q == '\\' && q + 1 < end) { q += 2; continue; }
                        q++;
                    }
                    size_t slen = (size_t)(q - p);
                    if (slen >= sizeof(tok_buf)) slen = sizeof(tok_buf) - 1;
                    memcpy(tok_buf, p, slen); tok_buf[slen] = 0;
                    p = (q < end) ? q + 1 : q;
                } else {
                    while (p < end && *p != ',' && *p != ']'
                           && *p != ' ' && *p != '\n' && *p != '\r' && *p != '\t') p++;
                    size_t slen = (size_t)(p - tok);
                    if (slen >= sizeof(tok_buf)) slen = sizeof(tok_buf) - 1;
                    memcpy(tok_buf, tok, slen); tok_buf[slen] = 0;
                }
                if (strcmp(tok_buf, v_str) == 0) { found = 1; break; }
            }
            return negate ? (found ? 0 : 1) : (found ? 1 : 0);
        }

        /* Leaf comparison. */
        int op_code = POLLEN_COND_NONE;
        if      (strcmp(op, "==") == 0) op_code = POLLEN_COND_EQ;
        else if (strcmp(op, "!=") == 0) op_code = POLLEN_COND_NE;
        else if (strcmp(op, "<")  == 0) op_code = POLLEN_COND_LT;
        else if (strcmp(op, ">")  == 0) op_code = POLLEN_COND_GT;
        else if (strcmp(op, "<=") == 0) op_code = POLLEN_COND_LE;
        else if (strcmp(op, ">=") == 0) op_code = POLLEN_COND_GE;
        else return 0;

        const char* var; size_t var_len;
        if (!_pollen_json_field(expr, expr_len, "var", 3,
                                  &var, &var_len)) return 0;
        if (var_len < 2 || *var != '"') return 0;
        char path[POLLEN_COND_VAR_MAX];
        size_t plen = var_len - 2;
        if (plen >= sizeof(path)) plen = sizeof(path) - 1;
        memcpy(path, var + 1, plen); path[plen] = 0;

        const char* val; size_t v_len;
        if (!_pollen_json_field(expr, expr_len, "value", 5,
                                  &val, &v_len)) return 0;
        int rhs_is_num = 0;
        double rhs_num = 0;
        char rhs_str[POLLEN_COND_STR_MAX] = "";
        if (v_len > 0 && *val == '"') {
            size_t slen = v_len >= 2 ? v_len - 2 : 0;
            if (slen >= sizeof(rhs_str)) slen = sizeof(rhs_str) - 1;
            memcpy(rhs_str, val + 1, slen); rhs_str[slen] = 0;
        } else if (v_len > 0 && ((*val >= '0' && *val <= '9')
                   || *val == '-' || *val == '+' || *val == '.')) {
            char tmp[64];
            size_t cn = v_len < sizeof(tmp) - 1 ? v_len : sizeof(tmp) - 1;
            memcpy(tmp, val, cn); tmp[cn] = 0;
            rhs_num = atof(tmp);
            rhs_is_num = 1;
        } else if (v_len == 4 && memcmp(val, "true", 4) == 0) {
            strcpy(rhs_str, "true");
        } else if (v_len == 5 && memcmp(val, "false", 5) == 0) {
            strcpy(rhs_str, "false");
        } else if (v_len == 4 && memcmp(val, "null", 4) == 0) {
            strcpy(rhs_str, "null");
        } else {
            return 0;
        }

        return _pollen_cond_eval_leaf(env, env_len, path, op_code,
                                        rhs_is_num, rhs_num, rhs_str);
    }

    /* Public facade — evaluate an expression against an envelope.
     * Returns the literal form (number-as-string, or "\"foo\"" with
     * the quotes embedded). Empty "" on eval failure. */
    static code_string
    Amalgame_Pollen_Pollen_EvalExpr_c(code_string envelopeJson,
                                        code_string exprJson) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!envelopeJson || !exprJson) return (code_string) empty;
        const char* env = (const char*) envelopeJson;
        const char* expr = (const char*) exprJson;
        size_t env_len = strlen(env);
        size_t expr_len = strlen(expr);
        _pollen_expr_val_t val;
        if (!_pollen_eval_expr(env, env_len, expr, expr_len, &val)) {
            return (code_string) empty;
        }
        char lit[256];
        int n = _pollen_expr_val_to_literal(&val, lit, sizeof(lit));
        if (n <= 0 || n >= (int) sizeof(lit)) return (code_string) empty;
        char* out = (char*) GC_MALLOC_ATOMIC((size_t) n + 1);
        if (!out) return (code_string) empty;
        memcpy(out, lit, (size_t) n); out[n] = 0;
        return (code_string) out;
    }

    /* Public facade — evaluate a cond expression against an envelope.
     * Empty cond → true (else-branch semantics). */
    static code_bool
    Amalgame_Pollen_Pollen_EvalCond_c(code_string envelopeJson,
                                        code_string condJson) {
        if (!envelopeJson) return (code_bool) 0;
        const char* env = (const char*) envelopeJson;
        const char* cond = condJson ? (const char*) condJson : "";
        size_t env_len = strlen(env);
        size_t cond_len = strlen(cond);
        int ok = _pollen_cond_eval_expr(env, env_len, cond, cond_len);
        return (code_bool) (ok ? 1 : 0);
    }

    /* === M2.3c.2b — for / while setters + dispatch ============ */

    static void _pollen_for_clear(void) {
        _pollen_for_active = 0;
        _pollen_for_route.n_items = 0;
        _pollen_for_route.n_targets = 0;
        _pollen_for_route.item_var[0] = 0;
    }

    static void _pollen_for_setup(const char* var) {
        _pollen_for_active = 1;
        _pollen_for_route.n_items = 0;
        _pollen_for_route.n_targets = 0;
        strncpy(_pollen_for_route.item_var,
                 var && var[0] ? var : "item",
                 POLLEN_COND_VAR_MAX - 1);
        _pollen_for_route.item_var[POLLEN_COND_VAR_MAX - 1] = 0;
    }

    static void _pollen_for_add_target(const char* host, int port) {
        if (_pollen_for_route.n_targets >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_for_route.target_host[_pollen_for_route.n_targets],
                 host ? host : "", POLLEN_HOST_MAX - 1);
        _pollen_for_route.target_host[_pollen_for_route.n_targets][POLLEN_HOST_MAX - 1] = 0;
        _pollen_for_route.target_port[_pollen_for_route.n_targets] = port;
        _pollen_for_route.n_targets++;
    }

    static void _pollen_for_add_item(const char* item_lit) {
        if (_pollen_for_route.n_items >= POLLEN_FOR_MAX_ITEMS) return;
        strncpy(_pollen_for_route.items[_pollen_for_route.n_items],
                 item_lit ? item_lit : "null",
                 POLLEN_FOR_ITEM_MAX - 1);
        _pollen_for_route.items[_pollen_for_route.n_items][POLLEN_FOR_ITEM_MAX - 1] = 0;
        _pollen_for_route.n_items++;
    }

    static void _pollen_while_clear(void) {
        _pollen_while_active = 0;
        _pollen_while_route.cond_expr[0] = 0;
        _pollen_while_route.iter_state_key[0] = 0;
        _pollen_while_route.max_iter = 0;
        _pollen_while_route.loop_host[0] = 0;
        _pollen_while_route.loop_port = 0;
        _pollen_while_route.n_exits = 0;
    }

    static void _pollen_while_setup(const char* cond_json,
                                      const char* iter_key,
                                      int max_iter,
                                      const char* self_host,
                                      int self_port) {
        _pollen_while_active = 1;
        strncpy(_pollen_while_route.cond_expr, cond_json ? cond_json : "",
                 POLLEN_COND_EXPR_MAX - 1);
        _pollen_while_route.cond_expr[POLLEN_COND_EXPR_MAX - 1] = 0;
        strncpy(_pollen_while_route.iter_state_key,
                 iter_key && iter_key[0] ? iter_key : "_wf_iter",
                 POLLEN_COND_VAR_MAX - 1);
        _pollen_while_route.iter_state_key[POLLEN_COND_VAR_MAX - 1] = 0;
        _pollen_while_route.max_iter = max_iter > 0 ? max_iter : 100;
        strncpy(_pollen_while_route.loop_host, self_host ? self_host : "",
                 POLLEN_HOST_MAX - 1);
        _pollen_while_route.loop_host[POLLEN_HOST_MAX - 1] = 0;
        _pollen_while_route.loop_port = self_port;
        _pollen_while_route.n_exits = 0;
    }

    static void _pollen_while_add_exit(const char* host, int port) {
        if (_pollen_while_route.n_exits >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_while_route.exit_host[_pollen_while_route.n_exits],
                 host ? host : "", POLLEN_HOST_MAX - 1);
        _pollen_while_route.exit_host[_pollen_while_route.n_exits][POLLEN_HOST_MAX - 1] = 0;
        _pollen_while_route.exit_port[_pollen_while_route.n_exits] = port;
        _pollen_while_route.n_exits++;
    }

    /* === M2.3c.2 — dispatch helper bodies (deferred from up top
     * because they call into the M2.2 cond_eval / expr_eval +
     * M2.1 state_persist routines defined just above). === */

    /* Apply pending set ops against the state file for the envelope's
     * rootMessageId. Each op evaluates its value_expr against the
     * envelope via _pollen_eval_expr, then persists via
     * _pollen_state_set. Best-effort : skip silently if the envelope
     * lacks rootMessageId or the write fails. */
    static void _pollen_set_ops_apply(const char* env, size_t env_len) {
        if (_pollen_n_set_ops == 0) return;
        char root[64];
        if (!_pollen_extract_root_mid(env, env_len, root, sizeof(root))) return;
        for (int i = 0; i < _pollen_n_set_ops; i++) {
            pollen_set_op_t* o = &_pollen_set_ops[i];
            _pollen_expr_val_t val;
            size_t elen = strlen(o->value_expr);
            if (!_pollen_eval_expr(env, env_len, o->value_expr, elen, &val)) {
                continue;
            }
            char lit[256];
            int ln = _pollen_expr_val_to_literal(&val, lit, sizeof(lit));
            if (ln <= 0 || ln >= (int) sizeof(lit)) continue;
            _pollen_state_set(root, o->path, lit);
        }
    }

    /* Phase 5.4 — for loop. Each iteration writes state.<item_var>
     * = items[i], then rebuilds the envelope (new mid + parent
     * chain + topic rewrite) and forwards to every target.
     * Total messages = n_items × n_targets. */
    static void _pollen_for_forward(const char* env, size_t env_len) {
        char root[64];
        int have_root = _pollen_extract_root_mid(env, env_len,
                                                   root, sizeof(root));
        const char* var = _pollen_for_route.item_var;
        char state_path[POLLEN_COND_VAR_MAX + 8];
        if (strncmp(var, "state.", 6) == 0) {
            snprintf(state_path, sizeof(state_path), "%s", var);
        } else {
            snprintf(state_path, sizeof(state_path), "state.%s", var);
        }
        for (int i = 0; i < _pollen_for_route.n_items; i++) {
            const char* item = _pollen_for_route.items[i];
            if (have_root) {
                _pollen_state_set(root, state_path, item);
            }
            char rebuilt[8192];
            const char* new_topic = _pollen_wf_emit_topic[0]
                                      ? _pollen_wf_emit_topic : NULL;
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                      rebuilt, sizeof(rebuilt),
                                                      new_topic, NULL);
            const char* fwd = rn > 0 ? rebuilt : env;
            size_t fwd_len = rn > 0 ? rn : env_len;
            for (int t = 0; t < _pollen_for_route.n_targets; t++) {
                _pollen_wf_forward_one(_pollen_for_route.target_host[t],
                                         _pollen_for_route.target_port[t],
                                         fwd, fwd_len);
            }
        }
    }

    /* Phase 5.4 — while loop with maxIter + cond. Reads iter from
     * state, evaluates cond, decides loop vs exit. On loop bumps
     * iter + forwards to self. On exit forwards to every exit
     * target. Auto-iter checked BEFORE cond so a runaway loop
     * always terminates. */
    static void _pollen_while_forward(const char* env, size_t env_len) {
        char root[64];
        int have_root = _pollen_extract_root_mid(env, env_len,
                                                   root, sizeof(root));
        int iter = 0;
        if (have_root) {
            char state_buf[POLLEN_STATE_FILE_MAX];
            int sn = _pollen_state_read(root, state_buf, sizeof(state_buf));
            if (sn > 0) {
                const char* vp; size_t vl;
                if (_pollen_resolve_path(state_buf, (size_t) sn,
                                           _pollen_while_route.iter_state_key,
                                           &vp, &vl)) {
                    char tmp[32];
                    size_t cn = vl < sizeof(tmp) - 1 ? vl : sizeof(tmp) - 1;
                    memcpy(tmp, vp, cn); tmp[cn] = 0;
                    iter = atoi(tmp);
                }
            }
        }

        int hit_max = (iter >= _pollen_while_route.max_iter);
        int cond_pass = _pollen_cond_eval_expr(env, env_len,
                                                 _pollen_while_route.cond_expr,
                                                 strlen(_pollen_while_route.cond_expr));

        if (!hit_max && cond_pass) {
            if (have_root) {
                char lit[32];
                snprintf(lit, sizeof(lit), "%d", iter + 1);
                _pollen_state_set(root,
                                    _pollen_while_route.iter_state_key,
                                    lit);
            }
            char rebuilt[8192];
            const char* new_topic = _pollen_wf_emit_topic[0]
                                      ? _pollen_wf_emit_topic : NULL;
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                      rebuilt, sizeof(rebuilt),
                                                      new_topic, NULL);
            const char* fwd = rn > 0 ? rebuilt : env;
            size_t fwd_len = rn > 0 ? rn : env_len;
            _pollen_wf_forward_one(_pollen_while_route.loop_host,
                                     _pollen_while_route.loop_port,
                                     fwd, fwd_len);
            return;
        }

        if (_pollen_while_route.n_exits == 0) return;
        char rebuilt[8192];
        const char* new_topic = _pollen_wf_emit_topic[0]
                                  ? _pollen_wf_emit_topic : NULL;
        size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                  rebuilt, sizeof(rebuilt),
                                                  new_topic, NULL);
        const char* fwd = rn > 0 ? rebuilt : env;
        size_t fwd_len = rn > 0 ? rn : env_len;
        for (int i = 0; i < _pollen_while_route.n_exits; i++) {
            _pollen_wf_forward_one(_pollen_while_route.exit_host[i],
                                     _pollen_while_route.exit_port[i],
                                     fwd, fwd_len);
        }
    }

    /* Evaluate each branch's cond top-down. First match wins :
     * rebuild the envelope (new mid + parent chain + optional topic
     * rewrite) and forward to that branch's target list. No match :
     * drop silently (caller already ACKed). */
    static void _pollen_cond_forward(const char* env, size_t env_len) {
        for (int i = 0; i < _pollen_cond_n_branches; i++) {
            pollen_cond_branch_t* b = &_pollen_cond_branches[i];
            int pass = _pollen_cond_eval_expr(env, env_len,
                                                b->cond_expr,
                                                strlen(b->cond_expr));
            if (!pass) continue;
            char rebuilt[8192];
            const char* fwd = env;
            size_t fwd_len = env_len;
            const char* new_topic = _pollen_wf_emit_topic[0]
                                      ? _pollen_wf_emit_topic : NULL;
            size_t rn = _pollen_wf_rebuild_envelope(env, env_len,
                                                      rebuilt, sizeof(rebuilt),
                                                      new_topic, NULL);
            if (rn > 0) { fwd = rebuilt; fwd_len = rn; }
            for (int t = 0; t < b->n_targets; t++) {
                _pollen_wf_forward_one(b->targets_host[t],
                                         b->targets_port[t],
                                         fwd, fwd_len);
            }
            return;  /* first match wins, mirrors workflow-tree `if` */
        }
        /* No branch matched — drop silently. */
    }

    /* === M2.3c.1 — workflow setters + dispatch helpers ======= */

    static void _pollen_wf_reload_begin(void) {
        pthread_mutex_lock(&_pollen_wf_mutex);
        _pollen_wf_n_consumes = 0;
        _pollen_wf_n_nexts = 0;
        _pollen_wf_emit_topic[0] = 0;
        /* M2.3c.2 — also reset cond branches + set ops + for/while
         * routes so a reload that drops the `if` / `set` / `for` /
         * `while` reverts to plain fan-out. */
        _pollen_cond_clear();
        _pollen_set_ops_clear();
        _pollen_for_clear();
        _pollen_while_clear();
        /* _pollen_wf_active stays sticky — once a workflow has been
         * loaded, free-form fallback won't kick back in even if the
         * new config is empty. Restart the process to disable. */
    }

    static void _pollen_wf_reload_commit(void) {
        _pollen_wf_version++;
        pthread_mutex_unlock(&_pollen_wf_mutex);
    }

    static void _pollen_wf_add_consume(const char* topic) {
        if (!topic) return;
        if (_pollen_wf_n_consumes >= POLLEN_MAX_CONSUMES) return;
        strncpy(_pollen_wf_consumes[_pollen_wf_n_consumes], topic,
                 POLLEN_TOPIC_MAX - 1);
        _pollen_wf_consumes[_pollen_wf_n_consumes][POLLEN_TOPIC_MAX - 1] = 0;
        _pollen_wf_n_consumes++;
        _pollen_wf_active = 1;
    }

    static void _pollen_wf_add_next(const char* host, int port) {
        if (!host) return;
        if (_pollen_wf_n_nexts >= POLLEN_MAX_NEXTS) return;
        strncpy(_pollen_wf_next_host[_pollen_wf_n_nexts], host,
                 POLLEN_HOST_MAX - 1);
        _pollen_wf_next_host[_pollen_wf_n_nexts][POLLEN_HOST_MAX - 1] = 0;
        _pollen_wf_next_port[_pollen_wf_n_nexts] = port;
        _pollen_wf_n_nexts++;
        _pollen_wf_active = 1;
    }

    static void _pollen_wf_set_emit_topic(const char* topic) {
        if (!topic) return;
        strncpy(_pollen_wf_emit_topic, topic, POLLEN_TOPIC_MAX - 1);
        _pollen_wf_emit_topic[POLLEN_TOPIC_MAX - 1] = 0;
    }

    /* O(N×M) consume check ; N ≤ 32 + topic ≤ 128 chars stays
     * sub-µs and keeps the hot loop branchless of mallocs. */
    static int _pollen_wf_topic_consumed(const char* topic, size_t topic_len) {
        for (int i = 0; i < _pollen_wf_n_consumes; i++) {
            size_t l = strlen(_pollen_wf_consumes[i]);
            if (l == topic_len && memcmp(_pollen_wf_consumes[i],
                                          topic, l) == 0) {
                return 1;
            }
        }
        return 0;
    }

    /* Fire-and-forget forward to a single downstream peer. */
    static void _pollen_wf_forward_one(const char* host, int port,
                                        const char* envelope, size_t env_len) {
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return;
        }
        send(fd, envelope, env_len, MSG_NOSIGNAL);
        if (env_len == 0 || envelope[env_len - 1] != '\n') {
            send(fd, "\n", 1, MSG_NOSIGNAL);
        }
        /* Fire-and-forget close — no SHUT_WR drain ; the receiver
         * sees EOF on close(). Avoids deadlock with self-loops
         * where the receiver holds the wf mutex. */
        close(fd);
    }

    /* Rebuild an envelope for forward : fresh messageId, optional
     * topic.uuid rewrite, parentMessageId appended carrying the
     * old mid. Returns the rebuilt length (with trailing '\n'),
     * 0 on parse failure (caller falls back to verbatim forward). */
    static size_t _pollen_wf_rebuild_envelope(
            const char* in, size_t in_len,
            char* out, size_t out_cap,
            const char* new_topic,
            char* out_new_mid /* may be NULL ; 37-byte buf */) {
        const char* m_key = _pollen_find(in, in_len,
                                          "\"messageId\":\"", 13);
        if (!m_key) return 0;
        const char* old_mid = m_key + 13;
        const char* old_mid_end = memchr(old_mid, '"',
                                          in_len - (size_t)(old_mid - in));
        if (!old_mid_end || (size_t)(old_mid_end - old_mid) != 36) return 0;

        const char* t_uuid_start = NULL;
        const char* t_uuid_end = NULL;
        if (new_topic) {
            const char* t_key = _pollen_find(in, in_len,
                                              "\"topic\":{\"uuid\":\"", 17);
            if (t_key) {
                t_uuid_start = t_key + 17;
                t_uuid_end = memchr(t_uuid_start, '"',
                                     in_len - (size_t)(t_uuid_start - in));
                if (!t_uuid_end) t_uuid_start = NULL;
            }
        }

        size_t e = in_len;
        while (e > 0 && (in[e-1] == '\n' || in[e-1] == '\r'
                          || in[e-1] == ' ' || in[e-1] == '\t')) e--;
        if (e == 0 || in[e-1] != '}') return 0;
        size_t close_pos = e - 1;

        char new_mid[37];
        _pollen_gen_uuid(new_mid);
        if (out_new_mid) memcpy(out_new_mid, new_mid, 37);

        size_t o = 0;
        #define _POLLEN_PE(src, n) do {                       \
            if (o + (n) > out_cap) return 0;                  \
            memcpy(out + o, (src), (n)); o += (n);            \
        } while (0)

        size_t mid_value_pos = (size_t)(old_mid - in);
        size_t mid_end_pos   = (size_t)(old_mid_end - in);

        _POLLEN_PE(in, mid_value_pos);
        _POLLEN_PE(new_mid, 36);

        if (t_uuid_start && t_uuid_end && new_topic) {
            size_t t_v_pos = (size_t)(t_uuid_start - in);
            size_t t_e_pos = (size_t)(t_uuid_end - in);
            _POLLEN_PE(in + mid_end_pos, t_v_pos - mid_end_pos);
            size_t tlen = strlen(new_topic);
            _POLLEN_PE(new_topic, tlen);
            _POLLEN_PE(in + t_e_pos, close_pos - t_e_pos);
        } else {
            _POLLEN_PE(in + mid_end_pos, close_pos - mid_end_pos);
        }

        const char* PARENT_OPEN = ",\"parentMessageId\":\"";
        _POLLEN_PE(PARENT_OPEN, 20);
        _POLLEN_PE(old_mid, 36);
        _POLLEN_PE("\"}", 2);
        _POLLEN_PE("\n", 1);
        #undef _POLLEN_PE
        return o;
    }

    /* === M2.3c.2 — cond branch setters + dispatch ============ */

    static void _pollen_cond_clear(void) {
        _pollen_cond_active = 0;
        _pollen_cond_n_branches = 0;
        _pollen_cond_current = -1;
    }

    /* Open a new cond branch. Empty cond_json = else / always-true. */
    static void _pollen_cond_branch_open(const char* cond_json) {
        if (_pollen_cond_n_branches >= POLLEN_COND_MAX_BRANCHES) return;
        _pollen_cond_active = 1;
        _pollen_cond_current = _pollen_cond_n_branches;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        strncpy(b->cond_expr, cond_json ? cond_json : "",
                 sizeof(b->cond_expr) - 1);
        b->cond_expr[sizeof(b->cond_expr) - 1] = 0;
        b->n_targets = 0;
        _pollen_cond_n_branches++;
    }

    static void _pollen_cond_branch_add_target(const char* host, int port) {
        if (_pollen_cond_current < 0
            || _pollen_cond_current >= _pollen_cond_n_branches) return;
        pollen_cond_branch_t* b = &_pollen_cond_branches[_pollen_cond_current];
        if (b->n_targets >= POLLEN_MAX_NEXTS) return;
        strncpy(b->targets_host[b->n_targets], host ? host : "",
                 POLLEN_HOST_MAX - 1);
        b->targets_host[b->n_targets][POLLEN_HOST_MAX - 1] = 0;
        b->targets_port[b->n_targets] = port;
        b->n_targets++;
    }

    /* === M2.3c.2 — set-op setters ============================ */

    static void _pollen_set_ops_clear(void) {
        _pollen_n_set_ops = 0;
    }

    static void _pollen_set_ops_add(const char* path,
                                      const char* value_expr) {
        if (_pollen_n_set_ops >= POLLEN_SET_OPS_MAX) return;
        pollen_set_op_t* o = &_pollen_set_ops[_pollen_n_set_ops];
        strncpy(o->path, path ? path : "", POLLEN_COND_VAR_MAX - 1);
        o->path[POLLEN_COND_VAR_MAX - 1] = 0;
        strncpy(o->value_expr, value_expr ? value_expr : "null",
                 sizeof(o->value_expr) - 1);
        o->value_expr[sizeof(o->value_expr) - 1] = 0;
        _pollen_n_set_ops++;
    }

    /* === M2.3c.2 — dispatch helpers (forward decls — bodies live
     * after the M2.2 cond_eval / expr_eval / state_persist blocks
     * since they call _pollen_cond_eval_expr / _pollen_eval_expr /
     * _pollen_state_set + _pollen_extract_root_mid). */

    static void _pollen_cond_forward(const char* env, size_t env_len);
    static void _pollen_set_ops_apply(const char* env, size_t env_len);

    /* Forward to every downstream peer registered via add_next.
     * Caller holds _pollen_wf_mutex (snapshot of nexts is safe). */
    static void _pollen_wf_forward_all(const char* envelope, size_t env_len) {
        char rebuilt[8192];
        const char* fwd = envelope;
        size_t fwd_len = env_len;
        const char* new_topic = _pollen_wf_emit_topic[0] ?
                                  _pollen_wf_emit_topic : NULL;
        size_t rn = _pollen_wf_rebuild_envelope(envelope, env_len,
                                                  rebuilt, sizeof(rebuilt),
                                                  new_topic, NULL);
        if (rn > 0) { fwd = rebuilt; fwd_len = rn; }
        for (int i = 0; i < _pollen_wf_n_nexts; i++) {
            _pollen_wf_forward_one(_pollen_wf_next_host[i],
                                     _pollen_wf_next_port[i],
                                     fwd, fwd_len);
        }
    }

    /* === TCP transport ======================================== */

    /* M2.3b — accept loop + per-connection ACK echo worker.
     * Plain TCP + newline-framed JSON envelopes. No workflow
     * dispatch yet (M2.3c) and no debug bridge (M2.4) — just
     * recv → extract messageId → send back an ACK envelope.
     * One pthread per accepted connection ; the accept thread
     * itself blocks in StartListener until the process exits.
     * pthread.h is already included earlier alongside workflow
     * state definitions. */

    static void* _pollen_listener_worker(void* arg) {
        int fd = (int)(intptr_t) arg;
        char rbuf[16384];
        size_t rlen = 0;
        char ack[256];
        const char* MID_KEY   = "\"messageId\":\"";
        const size_t MID_KEY_LEN = 13;
        const char* TOPIC_KEY = "\"topic\":{\"uuid\":\"";
        const size_t TOPIC_KEY_LEN = 17;

        for (;;) {
            if (rlen >= sizeof(rbuf)) break;  /* oversize line — drop */
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            for (;;) {
                char* nl = memchr(rbuf, '\n', rlen);
                if (!nl) break;
                size_t line_len = (size_t)(nl - rbuf);

                /* Decide ACK + forward policy under the wf mutex :
                 *   wf active + topic ∈ consumes : ACK + forward
                 *   wf active + topic ∉ consumes : drop, no ACK
                 *   wf inactive                  : ACK (free-form fallback) */
                int do_ack = 1;
                int do_forward = 0;
                pthread_mutex_lock(&_pollen_wf_mutex);
                if (_pollen_wf_active && _pollen_wf_n_consumes > 0) {
                    const char* tp = _pollen_find(rbuf, line_len,
                                                    TOPIC_KEY, TOPIC_KEY_LEN);
                    int matched = 0;
                    if (tp) {
                        tp += TOPIC_KEY_LEN;
                        const char* tq = memchr(tp, '"',
                                                  line_len - (size_t)(tp - rbuf));
                        if (tq && _pollen_wf_topic_consumed(
                                tp, (size_t)(tq - tp))) {
                            matched = 1;
                        }
                    }
                    if (matched) {
                        do_forward = 1;
                    } else {
                        do_ack = 0;
                    }
                }

                if (do_ack) {
                    const char* mp = _pollen_find(rbuf, line_len,
                                                    MID_KEY, MID_KEY_LEN);
                    if (mp) {
                        mp += MID_KEY_LEN;
                        const char* mq = memchr(mp, '"',
                                                  line_len - (size_t)(mp - rbuf));
                        if (mq) {
                            size_t midlen = (size_t)(mq - mp);
                            int64_t now = _pollen_now_ms_c();
                            int alen = snprintf(ack, sizeof(ack),
                                "{\"type\":\"ACK\",\"messageId\":\"%.*s\","
                                 "\"timestamp\":%lld}\n",
                                (int) midlen, mp, (long long) now);
                            if (alen > 0 && alen < (int) sizeof(ack)) {
                                ssize_t sent = 0;
                                int sock_dead = 0;
                                while (sent < alen) {
                                    ssize_t w = send(fd, ack + sent,
                                                     (size_t)(alen - sent),
                                                     MSG_NOSIGNAL);
                                    if (w <= 0) { sock_dead = 1; break; }
                                    sent += w;
                                }
                                if (sock_dead) {
                                    pthread_mutex_unlock(&_pollen_wf_mutex);
                                    goto worker_done;
                                }
                            }
                        }
                    }
                    if (do_forward) {
                        /* M2.3c.2 dispatch sequence :
                         *   1. apply pending set ops (mutates state.X
                         *      before the cond eval sees it),
                         *   2. if cond branches active → cond_forward
                         *      (first-match wins),
                         *   3. else → forward to every next. */
                        if (_pollen_n_set_ops > 0) {
                            _pollen_set_ops_apply(rbuf, line_len);
                        }
                        /* M2.3c.2b dispatch priority :
                         *   while (self-loop bounded) > for (item fan-out)
                         *   > cond (if / elseif branches)
                         *   > plain fan_out (forward_all)
                         * These flags are mutually exclusive per node in
                         * the workflow-tree schema, but priority is safer
                         * than asserting exclusion. */
                        if (_pollen_while_active) {
                            _pollen_while_forward(rbuf, line_len);
                        } else if (_pollen_for_active) {
                            _pollen_for_forward(rbuf, line_len);
                        } else if (_pollen_cond_active && _pollen_cond_n_branches > 0) {
                            _pollen_cond_forward(rbuf, line_len);
                        } else {
                            _pollen_wf_forward_all(rbuf, line_len);
                        }
                    }
                }
                pthread_mutex_unlock(&_pollen_wf_mutex);

                size_t consumed = line_len + 1;
                memmove(rbuf, rbuf + consumed, rlen - consumed);
                rlen -= consumed;
            }
        }
    worker_done:
        close(fd);
        return NULL;
    }

    static int _pollen_listen_simple(int port) {
        int srv = socket(AF_INET, SOCK_STREAM, 0);
        if (srv < 0) return -1;
        int one = 1;
        setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = htonl(INADDR_ANY);
        addr.sin_port = htons((uint16_t) port);
        if (bind(srv, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(srv); return -1;
        }
        if (listen(srv, 64) < 0) { close(srv); return -1; }
        for (;;) {
            int conn = accept(srv, NULL, NULL);
            if (conn < 0) continue;
            pthread_t th;
            if (pthread_create(&th, NULL,
                                _pollen_listener_worker,
                                (void*)(intptr_t) conn) != 0) {
                close(conn); continue;
            }
            pthread_detach(th);
        }
        /* unreachable until we add a shutdown path */
        close(srv);
        return 0;
    }

    static void
    Amalgame_Pollen_Pollen_StartListener_c(int64_t port) {
        (void) _pollen_listen_simple((int) port);
    }

    /* M2.3a — UUID v4 generator (RFC 4122 variant + version bits).
     * `buf` must hold at least 37 bytes (36 + NUL). */
    static void _pollen_gen_uuid(char* buf) {
        unsigned char b[16];
        getrandom(b, 16, 0);
        b[6] = (unsigned char)((b[6] & 0x0F) | 0x40);
        b[8] = (unsigned char)((b[8] & 0x3F) | 0x80);
        const char* hex = "0123456789abcdef";
        int p = 0;
        for (int k = 0; k < 16; k++) {
            if (k == 4 || k == 6 || k == 8 || k == 10) buf[p++] = '-';
            buf[p++] = hex[(b[k] >> 4) & 0xF];
            buf[p++] = hex[b[k] & 0xF];
        }
        buf[p] = '\0';
    }

    static int64_t _pollen_now_ms_c(void) {
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        return (int64_t) ts.tv_sec * 1000 + (int64_t) ts.tv_nsec / 1000000;
    }

    /* M2.3a — single-message fire-and-forget publish. Connects,
     * sends one well-formed MESSAGE envelope (newline-terminated),
     * closes ; does NOT wait for an ACK. The kernel-level TCP
     * acknowledgement gives us delivery confirmation up to the
     * peer's socket buffer ; Pollen.PublishSync (planned v0.2)
     * will block on the application-level ACK.
     *
     * `data_json` is inserted verbatim into the envelope so callers
     * are responsible for emitting valid JSON. `out_mid` (37-byte
     * buffer) receives the freshly minted messageId on success.
     *
     * Returns 1 on success, 0 on socket / connect / send failure. */
    static int _pollen_publish_one(const char* host, int port,
                                     const char* topic_uuid,
                                     int64_t topic_version,
                                     const char* data_json,
                                     char* out_mid) {
        if (!host || !topic_uuid || !data_json || !out_mid) return 0;
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return 0;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return 0;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return 0;
        }
        _pollen_gen_uuid(out_mid);

        char envelope[8192];
        int64_t now = _pollen_now_ms_c();
        int env_len = snprintf(envelope, sizeof(envelope),
            "{\"messageId\":\"%s\",\"rootMessageId\":\"%s\","
             "\"type\":\"MESSAGE\","
             "\"topic\":{\"uuid\":\"%s\",\"version\":%lld},"
             "\"data\":%s,\"timestamp\":%lld}\n",
            out_mid, out_mid, topic_uuid,
            (long long) topic_version, data_json, (long long) now);
        if (env_len <= 0 || env_len >= (int) sizeof(envelope)) {
            close(fd); return 0;
        }
        ssize_t sent = 0;
        while (sent < env_len) {
            ssize_t n = send(fd, envelope + sent,
                             (size_t)(env_len - sent), MSG_NOSIGNAL);
            if (n < 0) { close(fd); return 0; }
            sent += n;
        }
        close(fd);
        return 1;
    }

    static code_string
    Amalgame_Pollen_Pollen_Publish_c(code_string host, int64_t port,
                                       code_string topicUuid, int64_t topicVersion,
                                       code_string dataJson) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!host || !topicUuid || !dataJson) return (code_string) empty;
        char mid[37];
        if (!_pollen_publish_one((const char*) host, (int) port,
                                   (const char*) topicUuid,
                                   topicVersion,
                                   (const char*) dataJson,
                                   mid)) {
            return (code_string) empty;
        }
        char* out = (char*) GC_MALLOC_ATOMIC(37);
        if (!out) return (code_string) empty;
        memcpy(out, mid, 37);
        return (code_string) out;
    }

    /* M2.3b — synchronous publish : same as _pollen_publish_one but
     * keeps the socket open after the send and waits up to
     * timeout_ms for the matching ACK. Returns 1 if ACK arrived
     * for the expected mid, 0 on connect/send/recv/timeout failure
     * or mid mismatch. `out_mid` always receives the minted UUID
     * (even on ACK failure) so the caller can log it. */
    #include <poll.h>
    static int _pollen_publish_sync(const char* host, int port,
                                      const char* topic_uuid,
                                      int64_t topic_version,
                                      const char* data_json,
                                      int timeout_ms,
                                      char* out_mid) {
        if (!host || !topic_uuid || !data_json || !out_mid) return 0;
        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return 0;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
            close(fd); return 0;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return 0;
        }
        _pollen_gen_uuid(out_mid);
        char envelope[8192];
        int64_t now = _pollen_now_ms_c();
        int env_len = snprintf(envelope, sizeof(envelope),
            "{\"messageId\":\"%s\",\"rootMessageId\":\"%s\","
             "\"type\":\"MESSAGE\","
             "\"topic\":{\"uuid\":\"%s\",\"version\":%lld},"
             "\"data\":%s,\"timestamp\":%lld}\n",
            out_mid, out_mid, topic_uuid,
            (long long) topic_version, data_json, (long long) now);
        if (env_len <= 0 || env_len >= (int) sizeof(envelope)) {
            close(fd); return 0;
        }
        ssize_t sent = 0;
        while (sent < env_len) {
            ssize_t n = send(fd, envelope + sent,
                              (size_t)(env_len - sent), MSG_NOSIGNAL);
            if (n < 0) { close(fd); return 0; }
            sent += n;
        }

        /* Wait for one newline-terminated line and verify it ACKs
         * our mid. poll() bounds the wait by timeout_ms. */
        char rbuf[2048];
        size_t rlen = 0;
        int got_ack = 0;
        int remaining = timeout_ms > 0 ? timeout_ms : 5000;
        while (rlen < sizeof(rbuf) - 1) {
            struct pollfd pfd; pfd.fd = fd; pfd.events = POLLIN;
            int64_t start = _pollen_now_ms_c();
            int pr = poll(&pfd, 1, remaining);
            if (pr <= 0) break;  /* timeout or error */
            ssize_t n = recv(fd, rbuf + rlen, sizeof(rbuf) - 1 - rlen, 0);
            if (n <= 0) break;
            rlen += (size_t) n;
            rbuf[rlen] = 0;
            char* nl = memchr(rbuf, '\n', rlen);
            if (nl) {
                size_t line_len = (size_t)(nl - rbuf);
                const char* mp = _pollen_find(rbuf, line_len,
                                                "\"messageId\":\"", 13);
                if (mp) {
                    mp += 13;
                    const char* mq = memchr(mp, '"',
                                              line_len - (size_t)(mp - rbuf));
                    if (mq && (size_t)(mq - mp) == 36
                        && memcmp(mp, out_mid, 36) == 0) {
                        got_ack = 1;
                    }
                }
                break;
            }
            int64_t elapsed = _pollen_now_ms_c() - start;
            remaining -= (int) elapsed;
            if (remaining <= 0) break;
        }
        close(fd);
        return got_ack;
    }

