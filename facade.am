    // Exit targets are wired via WhileAddExit.
    public static void WhileSetup(condJson: string, iterKey: string,
                                    maxIter: int,
                                    selfHost: string, selfPort: int) {
        @c { Amalgame_Pollen_Pollen_WhileSetup_c(condJson, iterKey,
