    /* M4 — debug-aware publish. Builds a MESSAGE envelope carrying a
     * `debug` field (session / mode / manager / breakpoints / hit_bp)
     * so a debug-stepping run can phone home from each paused hop.
     * Centralises the envelope construction the pollen-manager used
     * to hand-roll in its /api/inject. messageId == rootMessageId
     * (originator). breakpointsJson is spliced verbatim (must be a
     * JSON array). Fire-and-forget : connect → send → drain one ACK
     * → close. Returns the minted mid, "" on connect/send failure. */
    static code_string
    Amalgame_Pollen_Pollen_PublishDebug_c(code_string host, int64_t port,
                                            code_string topicUuid, int64_t topicVersion,
                                            code_string dataJson,
                                            code_string session, code_string mode,
                                            code_string breakpointsJson,
                                            code_string managerAddr) {
        char* empty = (char*) GC_MALLOC_ATOMIC(1);
        if (empty) empty[0] = 0;
        if (!host || !topicUuid || !dataJson) return (code_string) empty;

        int fd = socket(AF_INET, SOCK_STREAM, 0);
        if (fd < 0) return (code_string) empty;
        struct sockaddr_in addr; memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((uint16_t) port);
        if (inet_pton(AF_INET, (const char*) host, &addr.sin_addr) != 1) {
            close(fd); return (code_string) empty;
        }
        if (connect(fd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
            close(fd); return (code_string) empty;
        }

        char mid[37];
        _pollen_gen_uuid(mid);
        const char* sess = session ? (const char*) session : "";
        const char* md   = mode ? (const char*) mode : "step";
        const char* bps  = breakpointsJson ? (const char*) breakpointsJson : "[]";
        const char* mgr  = managerAddr ? (const char*) managerAddr : "127.0.0.1:3001";

        char envelope[8192];
        int64_t now = _pollen_now_ms_c();
        int env_len = snprintf(envelope, sizeof(envelope),
            "{\"messageId\":\"%s\",\"rootMessageId\":\"%s\","
             "\"type\":\"MESSAGE\","
             "\"topic\":{\"uuid\":\"%s\",\"version\":%lld},"
             "\"data\":%s,\"timestamp\":%lld,"
             "\"debug\":{\"session\":\"%s\",\"mode\":\"%s\","
                        "\"manager\":\"%s\",\"breakpoints\":%s,"
                        "\"hit_bp\":false}}\n",
            mid, mid, (const char*) topicUuid, (long long) topicVersion,
            (const char*) dataJson, (long long) now,
            sess, md, mgr, bps);
        if (env_len <= 0 || env_len >= (int) sizeof(envelope)) {
            close(fd); return (code_string) empty;
        }
        ssize_t sent = 0;
        while (sent < env_len) {
            ssize_t n = send(fd, envelope + sent,
                             (size_t)(env_len - sent), MSG_NOSIGNAL);
            if (n < 0) { close(fd); return (code_string) empty; }
            sent += n;
        }
        /* drain one ACK line (best-effort, short wait) */
        struct timeval rtv = { 2, 0 };
        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rtv, sizeof(rtv));
        char ackbuf[512];
        (void) recv(fd, ackbuf, sizeof(ackbuf), 0);
        close(fd);

        char* out = (char*) GC_MALLOC_ATOMIC(37);
        if (!out) return (code_string) empty;
        memcpy(out, mid, 37);
        return (code_string) out;
    }

    /* === Pollen v3 — runtime AST + name resolver =============
     *
     * Phase 2 of the v3 roadmap (docs/proposals/pollen-v3.md §"v3
     * dispatcher"). Storage only — no dispatch yet (Phase 3).
     *
     * Layout :
     *   - one flat AST pool indexed by int32. Each node carries a
     *     `kind`, up to two child indices, and a `next_sibling`
     *     index that chains array-of-steps sequences. Container
     *     types (`for`, `while`, `if`, `entry.do`) point `child0`
     *     at the head of the body chain.
     *   - one entries[] pool, one anchors[] pool, one actions[] pool.
     *     entries[i].do_root indexes into the AST pool ; anchors[i]
     *     and goto-target resolution carry int idx into entries[] /
     *     anchors[] (see `goto_kind`).
     *   - GC-allocated `const char*` strings for names / exprs /
     *     params / bind_key, so an entry name like "shared-pipeline"
     *     isn't capped at a fixed buffer length.
     *
     * Setters are called from AM-side `Pollen.WorkflowLoadV3` between
     * `_pollen_v3_reload_begin` and `_pollen_v3_reload_commit`. The
     * commit step runs `_pollen_v3_resolve_gotos` so post-load each
     * goto node knows whether its target is an entry or an anchor.
     */

    #define POLLEN_MAX_ENTRIES             256
    #define POLLEN_MAX_AST_NODES          4096
    #define POLLEN_MAX_ANCHORS_TOTAL      4096
    #define POLLEN_MAX_ACTIONS             256
    #define POLLEN_MAX_ENTRY_PARAMS          8

    /* PollenAstKind — must match enum CelNodeKind / AM-side AstKind
     * indices used by the walker (see WorkflowLoadV3). */
    #define POLLEN_AST_CALL    1
    #define POLLEN_AST_IF      2
    #define POLLEN_AST_FOR     3
    #define POLLEN_AST_WHILE   4
    #define POLLEN_AST_SET     5
    #define POLLEN_AST_GOTO    6
    #define POLLEN_AST_ANCHOR  7
    #define POLLEN_AST_CASE    8   /* synthetic — one per if.cases[i] */

    /* goto_kind values stored on POLLEN_AST_GOTO nodes after resolve. */
    #define POLLEN_GOTO_UNRESOLVED  0
    #define POLLEN_GOTO_ENTRY       1
    #define POLLEN_GOTO_ANCHOR      2

    typedef struct {
        uint8_t  kind;
        uint8_t  mode;          /* call.mode : 0=one  1=all */
        uint8_t  on_error;      /* call.on_error : 0=log 1=fail 2=drop */
        uint8_t  has_else;      /* CASE node : 1 if `else: true` */
        int32_t  child0;        /* container body head ; CASE → body head */
        int32_t  child1;        /* reserved for future use */
        int32_t  next_sibling;  /* chain element of sequence / case list */
        int32_t  max_iter;      /* while.maxIter (0 = no cap declared) */
        int32_t  args_first;    /* goto.args[] — flat pool offset */
        int32_t  args_count;
        int32_t  goto_kind;     /* POLLEN_GOTO_* */
        int32_t  goto_idx;      /* entries[]/anchors[] idx post-resolve */
        const char* name;       /* call.action / set.key / goto.target /
                                  * anchor.name / for.var */
        const char* expr;       /* when / cond / in / value / arg /
                                  * returns / goto target name before resolve */
        const char* bind_key;   /* goto.bind */
    } PollenAstNode;

    typedef struct {
        const char* name;
        const char* on_topic;        /* NULL if no `on:` */
        int32_t     do_root;          /* AST idx of body head, -1 if empty */
        int32_t     has_returns;
        const char* returns_expr;
        int32_t     params_count;
        const char* params[POLLEN_MAX_ENTRY_PARAMS];
    } PollenEntry;

    typedef struct {
        const char* name;
        int32_t     entry_idx;
        int32_t     node_idx;
    } PollenAnchor;

    typedef struct {
        const char* name;
        const char* topic;
    } PollenAction;

    static PollenAstNode _pollen_v3_ast[POLLEN_MAX_AST_NODES];
    static int           _pollen_v3_ast_count;

    static PollenEntry   _pollen_v3_entries[POLLEN_MAX_ENTRIES];
    static int           _pollen_v3_entry_count;

    static PollenAnchor  _pollen_v3_anchors[POLLEN_MAX_ANCHORS_TOTAL];
    static int           _pollen_v3_anchor_count;

    static PollenAction  _pollen_v3_actions[POLLEN_MAX_ACTIONS];
    static int           _pollen_v3_action_count;

    /* Args pool — every goto.args[] expression slots a (char*) here ;
     * the goto node carries (args_first, args_count) into this pool. */
    #define POLLEN_MAX_ARG_STRINGS  1024
    static const char* _pollen_v3_args_pool[POLLEN_MAX_ARG_STRINGS];
    static int         _pollen_v3_args_pool_count;

    /* Load-time error trail. The AM walker bubbles a clear message up
     * to the caller without using exceptions ; we leave it accessible
     * to AM via Pollen.WorkflowLoadErrorMsg(). */
    static char _pollen_v3_load_err[512];
    static int  _pollen_v3_has_load_err;

    static int _pollen_v3_active;   /* 1 once a v3 workflow has been
                                      * committed ; flipped off only by
                                      * a v2 load or another v3 reload */

    static void _pollen_v3_set_err(const char* msg) {
        if (_pollen_v3_has_load_err) return;   /* keep first error */
        strncpy(_pollen_v3_load_err, msg, sizeof(_pollen_v3_load_err) - 1);
        _pollen_v3_load_err[sizeof(_pollen_v3_load_err) - 1] = 0;
        _pollen_v3_has_load_err = 1;
    }

    /* GC-backed strdup so AM-supplied `code_string`s survive past the
     * setter call (the AM side may reuse its own buffers). */
    static const char* _pollen_v3_dup(const char* s) {
        if (!s) return 0;
        size_t n = strlen(s);
        char* out = (char*) GC_MALLOC_ATOMIC(n + 1);
        if (!out) return 0;
        memcpy(out, s, n);
        out[n] = 0;
        return out;
    }

    static void _pollen_v3_reload_begin(void) {
        pthread_mutex_lock(&_pollen_wf_mutex);
        _pollen_v3_ast_count    = 0;
        _pollen_v3_entry_count  = 0;
        _pollen_v3_anchor_count = 0;
        _pollen_v3_action_count = 0;
        _pollen_v3_args_pool_count = 0;
        _pollen_v3_load_err[0]  = 0;
        _pollen_v3_has_load_err = 0;
    }

    /* Allocate a fresh node, return its index. -1 on overflow. */
    static int _pollen_v3_alloc_node(int kind) {
        if (_pollen_v3_ast_count >= POLLEN_MAX_AST_NODES) {
            _pollen_v3_set_err("AST node pool exhausted (POLLEN_MAX_AST_NODES=4096)");
            return -1;
        }
        int i = _pollen_v3_ast_count++;
        PollenAstNode* n = &_pollen_v3_ast[i];
        memset(n, 0, sizeof(*n));
        n->kind         = (uint8_t) kind;
        n->child0       = -1;
        n->child1       = -1;
        n->next_sibling = -1;
        n->args_first   = -1;
        n->args_count   = 0;
        n->goto_kind    = POLLEN_GOTO_UNRESOLVED;
        n->goto_idx     = -1;
        return i;
    }

    static int _pollen_v3_node_set_name(int idx, const char* name) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].name = _pollen_v3_dup(name);
        return 0;
    }
    static int _pollen_v3_node_set_expr(int idx, const char* e) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].expr = _pollen_v3_dup(e);
        return 0;
    }
    static int _pollen_v3_node_set_bind(int idx, const char* b) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].bind_key = _pollen_v3_dup(b);
        return 0;
    }
    static int _pollen_v3_node_set_child0(int idx, int child) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].child0 = child;
        return 0;
    }
    static int _pollen_v3_node_set_next(int idx, int next) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].next_sibling = next;
        return 0;
    }
    static int _pollen_v3_node_set_mode(int idx, int mode) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].mode = (uint8_t) mode;
        return 0;
    }
    static int _pollen_v3_node_set_on_error(int idx, int oe) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].on_error = (uint8_t) oe;
        return 0;
    }
    static int _pollen_v3_node_set_max_iter(int idx, int mi) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].max_iter = mi;
        return 0;
    }
    static int _pollen_v3_node_set_has_else(int idx, int he) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].has_else = (uint8_t) (he ? 1 : 0);
        return 0;
    }

    /* Append a goto-arg expression to the flat pool, return its idx. */
    static int _pollen_v3_push_arg(const char* expr) {
        if (_pollen_v3_args_pool_count >= POLLEN_MAX_ARG_STRINGS) {
            _pollen_v3_set_err("goto.args pool exhausted (POLLEN_MAX_ARG_STRINGS=1024)");
            return -1;
        }
        int i = _pollen_v3_args_pool_count++;
        _pollen_v3_args_pool[i] = _pollen_v3_dup(expr);
        return i;
    }

    static int _pollen_v3_node_set_args(int idx, int first, int count) {
        if (idx < 0 || idx >= _pollen_v3_ast_count) return -1;
        _pollen_v3_ast[idx].args_first = first;
        _pollen_v3_ast[idx].args_count = count;
        return 0;
    }

    /* === Entries ============================================ */

    static int _pollen_v3_add_entry(const char* name, const char* on_topic) {
        if (_pollen_v3_entry_count >= POLLEN_MAX_ENTRIES) {
            _pollen_v3_set_err("entries[] full (POLLEN_MAX_ENTRIES=256)");
            return -1;
        }
        int i = _pollen_v3_entry_count++;
        PollenEntry* e = &_pollen_v3_entries[i];
        memset(e, 0, sizeof(*e));
        e->name     = _pollen_v3_dup(name);
        e->on_topic = (on_topic && on_topic[0]) ? _pollen_v3_dup(on_topic) : 0;
        e->do_root  = -1;
        return i;
    }

    static int _pollen_v3_entry_set_do_root(int eidx, int node_idx) {
        if (eidx < 0 || eidx >= _pollen_v3_entry_count) return -1;
        _pollen_v3_entries[eidx].do_root = node_idx;
        return 0;
    }
    static int _pollen_v3_entry_set_returns(int eidx, const char* expr) {
        if (eidx < 0 || eidx >= _pollen_v3_entry_count) return -1;
        _pollen_v3_entries[eidx].has_returns  = 1;
        _pollen_v3_entries[eidx].returns_expr = _pollen_v3_dup(expr);
        return 0;
    }
    static int _pollen_v3_entry_add_param(int eidx, const char* name) {
        if (eidx < 0 || eidx >= _pollen_v3_entry_count) return -1;
        PollenEntry* e = &_pollen_v3_entries[eidx];
        if (e->params_count >= POLLEN_MAX_ENTRY_PARAMS) {
            _pollen_v3_set_err("entry params overflow (POLLEN_MAX_ENTRY_PARAMS=8)");
            return -1;
        }
        e->params[e->params_count++] = _pollen_v3_dup(name);
        return 0;
    }

    /* === Anchors ============================================ */

    static int _pollen_v3_add_anchor(int entry_idx, const char* name,
                                       int node_idx) {
        if (_pollen_v3_anchor_count >= POLLEN_MAX_ANCHORS_TOTAL) {
            _pollen_v3_set_err("anchors[] full (POLLEN_MAX_ANCHORS_TOTAL=4096)");
            return -1;
        }
        int i = _pollen_v3_anchor_count++;
        PollenAnchor* a = &_pollen_v3_anchors[i];
        a->name      = _pollen_v3_dup(name);
        a->entry_idx = entry_idx;
        a->node_idx  = node_idx;
        return i;
    }

    /* === Actions ============================================ */

    static int _pollen_v3_add_action(const char* name, const char* topic) {
        if (_pollen_v3_action_count >= POLLEN_MAX_ACTIONS) {
            _pollen_v3_set_err("actions[] full (POLLEN_MAX_ACTIONS=256)");
            return -1;
        }
        int i = _pollen_v3_action_count++;
        _pollen_v3_actions[i].name  = _pollen_v3_dup(name);
        _pollen_v3_actions[i].topic = _pollen_v3_dup(topic);
        return i;
    }

    /* === Lookups ============================================ */

    static int _pollen_v3_lookup_entry(const char* name) {
        if (!name) return -1;
        for (int i = 0; i < _pollen_v3_entry_count; i++) {
            if (_pollen_v3_entries[i].name &&
                strcmp(_pollen_v3_entries[i].name, name) == 0) return i;
        }
        return -1;
    }
    static int _pollen_v3_lookup_anchor(const char* name) {
        if (!name) return -1;
        for (int i = 0; i < _pollen_v3_anchor_count; i++) {
            if (_pollen_v3_anchors[i].name &&
                strcmp(_pollen_v3_anchors[i].name, name) == 0) return i;
        }
        return -1;
    }
    static int _pollen_v3_lookup_action(const char* name) {
        if (!name) return -1;
        for (int i = 0; i < _pollen_v3_action_count; i++) {
            if (_pollen_v3_actions[i].name &&
                strcmp(_pollen_v3_actions[i].name, name) == 0) return i;
        }
        return -1;
    }

    /* === Goto resolver ====================================== */
    /*
     * Walks the AST pool ; for each POLLEN_AST_GOTO node, looks the
     * target name up against entries first, then anchors. Unresolved
     * targets stay flagged so the dispatcher can fail-fast at run
     * time (the validator already rejects them at load time, but the
     * runtime double-check is cheap insurance).
     */
    static int _pollen_v3_resolve_gotos(void) {
        int unresolved = 0;
        for (int i = 0; i < _pollen_v3_ast_count; i++) {
            PollenAstNode* n = &_pollen_v3_ast[i];
            if (n->kind != POLLEN_AST_GOTO) continue;
            int eidx = _pollen_v3_lookup_entry(n->name);
            if (eidx >= 0) {
                n->goto_kind = POLLEN_GOTO_ENTRY;
                n->goto_idx  = eidx;
                continue;
            }
            int aidx = _pollen_v3_lookup_anchor(n->name);
            if (aidx >= 0) {
                n->goto_kind = POLLEN_GOTO_ANCHOR;
                n->goto_idx  = aidx;
                continue;
            }
            unresolved++;
        }
        if (unresolved > 0) {
            char buf[128];
            snprintf(buf, sizeof(buf),
                     "goto resolver: %d unresolved target(s)", unresolved);
            _pollen_v3_set_err(buf);
        }
        return unresolved;
    }

    static int _pollen_v3_reload_commit(void) {
        int unres = _pollen_v3_resolve_gotos();
        if (_pollen_v3_has_load_err) {
            pthread_mutex_unlock(&_pollen_wf_mutex);
            return -1;
        }
        _pollen_v3_active = 1;
        _pollen_wf_version++;
        pthread_mutex_unlock(&_pollen_wf_mutex);
        (void) unres;
        return 0;
    }

